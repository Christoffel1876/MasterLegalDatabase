{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "description": "Exact relative file identity.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Asset",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Completed checks and their actual test output, with explicit limits.",
  "properties": {
    "recorded_at": {
      "title": "Recorded At",
      "type": "string"
    },
    "status": {
      "const": "passed",
      "title": "Status",
      "type": "string"
    },
    "test_count": {
      "title": "Test Count",
      "type": "integer"
    },
    "test_log": {
      "$ref": "#/$defs/Asset"
    },
    "full_pages_rerendered": {
      "const": 7,
      "title": "Full Pages Rerendered",
      "type": "integer"
    },
    "initial_failure_preserved": {
      "const": true,
      "title": "Initial Failure Preserved",
      "type": "boolean"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "recorded_at",
    "status",
    "test_count",
    "test_log",
    "full_pages_rerendered",
    "initial_failure_preserved",
    "limitations"
  ],
  "title": "Checks",
  "type": "object"
}
