        },
        "source_format": {
          "title": "Source Format",
          "type": "string"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "blocked_queue_match": {
          "title": "Blocked Queue Match",
