{
  "$defs": {
    "Association": {
      "additionalProperties": false,
      "description": "Related reviewed regions retained together without inserting native words.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "observation_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Observation Ids",
          "type": "array"
        },
        "relationship": {
          "enum": [
            "purpose_list_and_qualification",
            "cross_page_continuation",
            "visible_native_and_image_distinction",
            "displayed_labels_and_pdf_metadata",
            "source_anomalies_not_editorial_corrections"
          ],
          "title": "Relationship",
          "type": "string"
        },
        "note": {
          "title": "Note",
          "type": "string"
        },
        "changes_native_text": {
          "const": false,
          "default": false,
          "title": "Changes Native Text",
          "type": "boolean"
        },
        "establishes_legal_effect": {
          "const": false,
          "default": false,
          "title": "Establishes Legal Effect",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "observation_ids",
        "relationship",
        "note"
      ],
      "title": "Association",
      "type": "object"
    },
    "Chunk": {
      "additionalProperties": false,
      "description": "Disjoint chunk preserving exact native bytes, separate from visibility.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "layout_whitespace",
            "header",
            "footer",
            "body",
            "cover_title",
            "cover_purpose"
          ],
          "title": "Role",
          "type": "string"
        },
        "visibility": {
          "enum": [
            "visible_text",
            "not_visible_in_checked_render",
            "layout_whitespace"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/Span"
        }
      },
      "required": [
        "id",
        "role",
        "visibility",
        "span"
      ],
      "title": "Chunk",
      "type": "object"
    },
    "Crop": {
      "additionalProperties": false,
      "description": "A direct 300 dpi PDF clip used as an inspection aid.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "physical_page": {
          "maximum": 7,
          "minimum": 1,
          "title": "Physical Page",
          "type": "integer"
        },
        "pdf_rect_points": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Pdf Rect Points",
          "type": "array"
        },
        "file": {
          "$ref": "#/$defs/FileRef"
        },
        "rendering": {
          "const": "PyMuPDF 1.28.2; Matrix(300/72,300/72); clip; alpha=False",
          "title": "Rendering",
          "type": "string"
        },
        "visually_checked": {
          "const": true,
          "title": "Visually Checked",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "physical_page",
        "pdf_rect_points",
        "file",
        "rendering",
        "visually_checked"
      ],
      "title": "Crop",
      "type": "object"
    },
    "Custody": {
      "additionalProperties": false,
      "description": "Frozen historical custody, separate from unverified upstream acquisition claims.",
      "properties": {
        "frozen_raw_manifest": {
          "$ref": "#/$defs/FileRef"
        },
        "raw_manifest_line_number": {
          "const": 18,
          "default": 18,
          "title": "Raw Manifest Line Number",
          "type": "integer"
        },
        "raw_manifest_line_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Manifest Line Sha256",
          "type": "string"
        },
        "raw_manifest_line_bytes": {
          "exclusiveMinimum": 0,
          "title": "Raw Manifest Line Bytes",
          "type": "integer"
        },
        "selected_intake_record": {
          "$ref": "#/$defs/IntakeRecord"
        },
        "frozen_intake_receipt": {
          "$ref": "#/$defs/FileRef"
        },
        "frozen_source_provenance": {
          "$ref": "#/$defs/FileRef"
        },
        "provenance_line_number": {
          "const": 6,
          "default": 6,
          "title": "Provenance Line Number",
          "type": "integer"
        },
        "provenance_line_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Provenance Line Sha256",
          "type": "string"
        },
        "provenance_line_bytes": {
          "exclusiveMinimum": 0,
          "title": "Provenance Line Bytes",
          "type": "integer"
        },
        "source_original_acquisition_time": {
          "default": null,
          "title": "Source Original Acquisition Time",
          "type": "null"
        },
        "upstream_http_acquisition_verified": {
          "const": false,
          "default": false,
          "title": "Upstream Http Acquisition Verified",
          "type": "boolean"
        },
        "claimed_official_url": {
          "title": "Claimed Official Url",
          "type": "string"
        },
        "claimed_final_url": {
          "title": "Claimed Final Url",
          "type": "string"
        },
        "claimed_referral_url": {
          "title": "Claimed Referral Url",
          "type": "string"
        },
        "claimed_attempt_time": {
          "title": "Claimed Attempt Time",
          "type": "string"
        },
        "claimed_status": {
          "const": 200,
          "default": 200,
          "title": "Claimed Status",
          "type": "integer"
        },
        "claim_qualification": {
          "title": "Claim Qualification",
          "type": "string"
        },
        "upstream_archive_reopened": {
          "const": false,
          "default": false,
          "title": "Upstream Archive Reopened",
          "type": "boolean"
        }
      },
      "required": [
        "frozen_raw_manifest",
        "raw_manifest_line_sha256",
        "raw_manifest_line_bytes",
        "selected_intake_record",
        "frozen_intake_receipt",
        "frozen_source_provenance",
        "provenance_line_sha256",
        "provenance_line_bytes",
        "claimed_official_url",
        "claimed_final_url",
        "claimed_referral_url",
        "claimed_attempt_time",
        "claim_qualification"
      ],
      "title": "Custody",
      "type": "object"
    },
    "FileRef": {
      "additionalProperties": false,
      "description": "A regular local file and immutable byte identity.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "FileRef",
      "type": "object"
    },
