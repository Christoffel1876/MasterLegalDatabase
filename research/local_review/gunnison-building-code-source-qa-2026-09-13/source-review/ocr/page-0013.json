{"lines":[{"bbox":[0.11842106643481093,0.93575757559737116,0.48120298953639312,0.016363636363636358],"confidence":1,"text":"Area shall comply with Section R401.2.5 and R401.2.3."},{"bbox":[0.11842107481976881,0.90116279087788076,0.7650375605376909,0.015988371877959318],"confidence":1,"text":"Section R403.9 Snow melt and ice system controls: Replace this section with the"},{"bbox":[0.11598024326117014,0.88419051435215268,0.08729778636585582,0.015477327289003195],"confidence":1,"text":"following:"},{"bbox":[0.11842104237782757,0.86482558132595455,0.75563910313908211,0.017598661364931045],"confidence":1,"text":"Exterior heated walking surfaces, parking areas and driveways are prohibited. All other"},{"bbox":[0.11842105621446887,0.84727272715416124,0.70300752167417713,0.017575757575757578],"confidence":1,"text":"snow melt and ice systems, supplied through energy service to the building, shall"},{"bbox":[0.11466165677002159,0.82969696975041485,0.72932328849003236,0.017686751394560773],"confidence":1,"text":"include automatic controls that only activate when the temperature is less than 40°F"},{"bbox":[0.11654136094704232,0.81090909074888629,0.3157894648728326,0.016363636363636358],"confidence":1,"text":"(4.8°C) and when water is detected."},{"bbox":[0.11654136253221781,0.77616279058467552,0.66353379970060244,0.017441860545765242],"confidence":1,"text":"Section R403.10.1 Heaters: Delete the last sentence and add the following:"},{"bbox":[0.11842107413669954,0.75872093042184885,0.76503756053769101,0.015988371877959318],"confidence":1,"text":"Gas-fired heaters for pools and spas are prohibited. Pools shall be heated with a heat"},{"bbox":[0.11842105110747436,0.74121212144173643,0.76315790732452493,0.01605532039295543],"confidence":1,"text":"pump system only. Spas, when heated by a separate appliance, shall utilize high"},{"bbox":[0.11842105799090406,0.723636363879404,0.16729322570992111,0.016363636363636358],"confidence":1,"text":"efficiency systems."},{"bbox":[0.11842107804256036,0.68895348857046801,0.76691726158405182,0.015988371877959207],"confidence":1,"text":"Section R403.10.3 Covers: Delete the exception and add the following to the last"},{"bbox":[0.11842104998595901,0.67272727253417663,0.20864662481325921,0.01477272727272716],"confidence":1,"text":"sentence of the section:"},{"bbox":[0.11842107377313794,0.6539393941802476,0.56766914200259599,0.019025721694483799],"confidence":1,"text":"Spas are required to have a cover with a minimum R-value of 12."},{"bbox":[0.11830941201699545,0.61767852188467054,0.6054780296397434,0.021678425181995808],"confidence":1,"text":"Section R406.1 Scope: Add the following to the end of the sentence:"},{"bbox":[0.11842105794610945,0.60174418622421033,0.34586465769800645,0.017649753454959782],"confidence":1,"text":"developed per ANSI\/RESNET\/ICC 301."},{"bbox":[0.11842105543422139,0.56540697707334231,0.65789474439471485,0.020348836725408326],"confidence":1,"text":"Section R406.4 Energy Rating Index: Amend the section to the following:"},{"bbox":[0.1165413508090546,0.54787878786933364,0.18796992526159018,0.017575757575757578],"confidence":1,"text":"The Energy Rating"},{"bbox":[0.30075188214408632,0.54941860452362901,0.58270675037348152,0.017441860545765242],"confidence":1,"text":", Index (ERI) shall be determined in accordance with the"},{"bbox":[0.11842105704009601,0.53333333314515241,0.29699247832582287,0.014631782878528843],"confidence":1,"text":"ANSI\/RESNET\/ICC 301 standard."},{"bbox":[0.29699248409961937,0.47939393944410436,0.14661653811655073,0.013338618422999549],"confidence":1,"text":"unnison County, Cl"},{"bbox":[0.29887218240846358,0.46947674400222272,0.17105262780264252,0.013081395698316123],"confidence":1,"text":"1\/14\/2023 8:13:55 AЛ"},{"bbox":[0.2894736846569933,0.45203488390113666,0.033834585949171325,0.015988371877959318],"confidence":1,"text":"447"},{"bbox":[0.29511278304205418,0.43168604658400123,0.065789470851981946,0.020348836725408437],"confidence":0.30000001192092896,"text":"