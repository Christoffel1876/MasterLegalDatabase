      "title": "Pages",
      "type": "integer"
    },
    "groups": {
      "const": 11,
      "default": 11,
      "title": "Groups",
      "type": "integer"
    },
    "rows": {
      "const": 137,
      "default": 137,
      "title": "Rows",
      "type": "integer"
    },
    "printed_fee_cells": {
      "const": 136,
      "default": 136,
