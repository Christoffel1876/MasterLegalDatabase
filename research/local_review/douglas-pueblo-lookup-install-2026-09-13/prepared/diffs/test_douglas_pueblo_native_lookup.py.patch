+def test_late_acceptance_swap_and_aba_do_not_change_checked_output(
+    copied: Path, complete: dict[str, Any], monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """Restoring a transient swapped QA does not certify its altered display or context."""
+    source = lookup.DOUGLAS_SOURCE_ID
+    config = lookup.DP_SOURCES[source]
+    package = copied / "research/local_review" / config["folder"]
+    qa = package / "SOURCE_QA.json"
+    acceptance = copied / "docs/audits/FOUR_HOUR_RUN_2026-09-12" / (
+        config["acceptance"] + "/ACCEPTANCE.json")
+    original = qa.read_bytes()
+    real_check, real_builder = lookup._check_dp_package, lookup._dp_douglas
+    calls = 0
+
+    def check(root: Path, identity: str) -> dict[str, bytes]:
+        """Place mutated QA and acceptance after the second source check."""
+        nonlocal calls
+        result = real_check(root, identity)
+        calls += 1
+        if calls == 2:
+            data = json.loads(original)
+            data["rows"][0]["cells"][-1]["displayed_text"] = "INJECTED UNVERIFIED FEE"
+            qa.write_text(json.dumps(data))
+            acceptance.write_bytes(b"INJECTED UNVERIFIED ACCEPTANCE")
+        return result
+
+    def build(base: Path, data: dict, captured: dict[str, bytes]) -> tuple:
+        """Restore the source after parsing would have consumed it in the former implementation."""
+        qa.write_bytes(original)
+        return real_builder(base, data, captured)
+
+    monkeypatch.setattr(lookup, "_check_dp_package", check)
+    monkeypatch.setattr(lookup, "_dp_douglas", build)
+    actual = lookup.lookup(copied, source, list_rows=True)
+    assert qa.read_bytes() == original and calls == 2
+    assert actual.model_dump_json().replace(str(copied), str(ROOT)) == (
+        complete[source].model_dump_json())
+
