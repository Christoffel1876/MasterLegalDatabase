+@pytest.mark.parametrize("source,relative", [
+    (lookup.DOUGLAS_SOURCE_ID, "SOURCE_QA.json"),
+    (lookup.DOUGLAS_SOURCE_ID, "candidate-native.txt"),
+    (lookup.DOUGLAS_SOURCE_ID, "page-0001.png"),
+    (lookup.PUEBLO_SOURCE_ID, "SOURCE_QA.json"),
+    (lookup.PUEBLO_SOURCE_ID, "native/page-0001.txt"),
+])
+def test_late_source_swaps_cannot_change_consumed_evidence(
+    copied: Path, complete: dict[str, Any], source: str, relative: str,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """A file swap after both checks cannot alter rows, contexts, spans or returned asset hashes."""
+    package = copied / "research/local_review" / lookup.DP_SOURCES[source]["folder"]
+    path = package / relative
+    original = path.read_bytes()
+    real = lookup._check_dp_package
+    calls = 0
+
+    def check(root: Path, identity: str) -> dict[str, bytes]:
+        """Mutate only temporary evidence after the final verifier identity check."""
+        nonlocal calls
+        result = real(root, identity)
+        calls += 1
+        if calls == 2:
+            if relative == "SOURCE_QA.json":
+                data = json.loads(original)
+                if identity == lookup.DOUGLAS_SOURCE_ID:
+                    data["rows"][0]["cells"][-1]["displayed_text"] = "INJECTED UNVERIFIED FEE"
+                    data["contexts"][0]["text"] = "INJECTED UNVERIFIED CONTEXT"
+                else:
+                    data["rows"][0]["fee"]["reviewed_display"] = "INJECTED UNVERIFIED FEE"
+                    data["annotations"][0]["statement"] = "INJECTED UNVERIFIED CONTEXT"
+                path.write_text(json.dumps(data))
+            else:
+                path.write_bytes(b"INJECTED UNVERIFIED CONTENT")
+        return result
+
+    monkeypatch.setattr(lookup, "_check_dp_package", check)
+    actual = lookup.lookup(copied, source, list_rows=True)
+    assert calls == 2 and path.read_bytes() != original
+    assert actual.model_dump_json().replace(str(copied), str(ROOT)) == (
+        complete[source].model_dump_json())
+    assert "INJECTED" not in actual.model_dump_json()
+
