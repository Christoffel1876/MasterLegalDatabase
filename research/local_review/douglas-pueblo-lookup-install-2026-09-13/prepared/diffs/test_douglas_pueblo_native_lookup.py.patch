+@pytest.mark.parametrize("relative", [
+    "execution/RECEIPT.json", "execution/INTENT.json", "execution/records.jsonl",
+    "evidence/preparation/source-provenance.jsonl",
+    "evidence/preparation/custody/douglas-ehs-fees-atlas-directed/E017/event.json",
+])
+def test_late_custody_swaps_use_captured_pinned_buffers(
+    copied: Path, complete: dict[str, Any], relative: str, monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """Receipt, canonical-line, provenance and HTTP parsing never reread changed disk bytes."""
+    target = copied / lookup.DP_INTAKE / relative
+    real = lookup._dp_capture
+    captures = 0
+
+    def capture(base: Path, name: str, expected: str, limit: int) -> tuple[str, bytes]:
+        """Swap the temporary artifact immediately after its exact checked buffer is captured."""
+        nonlocal captures
+        key, raw = real(base, name, expected, limit)
+        if Path(key) == target:
+            captures += 1
+            target.write_bytes(b"INJECTED UNVERIFIED CUSTODY")
+        return key, raw
+
+    monkeypatch.setattr(lookup, "_dp_capture", capture)
+    actual = lookup.lookup(copied, lookup.DOUGLAS_SOURCE_ID, list_rows=True)
+    assert captures == 1 and target.read_bytes() == b"INJECTED UNVERIFIED CUSTODY"
+    assert actual.model_dump_json().replace(str(copied), str(ROOT)) == (
+        complete[lookup.DOUGLAS_SOURCE_ID].model_dump_json())
+
