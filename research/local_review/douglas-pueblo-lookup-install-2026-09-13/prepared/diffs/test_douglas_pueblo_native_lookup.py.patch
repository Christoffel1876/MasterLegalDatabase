+def test_capture_checks_the_actual_buffer_not_an_earlier_path_digest(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """A transient read substitution is rejected even when later disk bytes have the pinned hash."""
+    import io
+
+    path = tmp_path / "artifact.json"
+    path.write_bytes(b"checked")
+    real_open = Path.open
+
+    def opened(self: Path, *args: Any, **kwargs: Any) -> Any:
+        """Provide a hostile read stream while preserving the ordinary original on disk."""
+        return io.BytesIO(b"substituted") if self == path else real_open(self, *args, **kwargs)
+
+    monkeypatch.setattr(Path, "open", opened)
+    with pytest.raises(ValueError, match="captured evidence differs"):
+        lookup._dp_capture(tmp_path, "artifact.json", hashlib.sha256(b"checked").hexdigest(), 100)
+
+
+def test_capture_enforces_read_byte_limit(tmp_path: Path) -> None:
+    """An exact hash cannot waive the finite captured-buffer size limit."""
+    raw = b"12345"
+    (tmp_path / "artifact").write_bytes(raw)
+    with pytest.raises(ValueError, match="captured evidence differs"):
+        lookup._dp_capture(tmp_path, "artifact", hashlib.sha256(raw).hexdigest(), 4)
