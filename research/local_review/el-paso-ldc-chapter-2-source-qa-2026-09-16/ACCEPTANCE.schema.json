  "required": [
    "source_id",
    "source_sha256",
    "authority_id",
    "accepted_at",
    "reviewer",
    "status",
    "source_review",
    "source_review_schema",
    "frozen_manifest",
    "root_reading",
    "scope",
    "pages_directly_inspected",
