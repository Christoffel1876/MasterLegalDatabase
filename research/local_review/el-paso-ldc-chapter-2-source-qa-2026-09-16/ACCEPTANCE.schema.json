{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "description": "Bind one relative path to its exact bytes.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Asset",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Accept this historical source's fidelity without certifying current law.",
  "properties": {
    "source_id": {
      "const": "el-paso-ldc-chapter-2-sd011",
      "title": "Source Id",
      "type": "string"
    },
    "source_sha256": {
      "const": "f3d527fd6a9da5b0043672582dda812dc9c3dfe9958d8b53eec876957ed10953",
      "title": "Source Sha256",
      "type": "string"
    },
    "authority_id": {
      "const": "CO-COUNTY-EL_PASO",
      "title": "Authority Id",
      "type": "string"
    },
    "accepted_at": {
      "format": "date-time",
      "title": "Accepted At",
      "type": "string"
    },
    "reviewer": {
      "const": "Atlas",
      "title": "Reviewer",
      "type": "string"
    },
    "status": {
      "const": "accepted_source_fidelity_for_metadata_only_review_join",
      "title": "Status",
      "type": "string"
    },
    "source_review": {
      "$ref": "#/$defs/Asset"
    },
    "source_review_schema": {
      "$ref": "#/$defs/Asset"
    },
    "frozen_manifest": {
      "$ref": "#/$defs/Asset"
    },
    "root_reading": {
      "$ref": "#/$defs/Asset"
    },
    "scope": {
      "title": "Scope",
      "type": "string"
    },
    "pages_directly_inspected": {
      "items": {
        "type": "integer"
      },
      "title": "Pages Directly Inspected",
      "type": "array"
    },
    "native_candidate_changed": {
      "const": false,
      "title": "Native Candidate Changed",
      "type": "boolean"
    },
    "external_review_consulted": {
      "const": false,
