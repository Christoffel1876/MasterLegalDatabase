      "type": "string"
    },
    "legal_currentness": {
      "const": "not_verified",
      "default": "not_verified",
      "title": "Legal Currentness",
      "type": "string"
    },
    "prepared_at": {
      "title": "Prepared At",
      "type": "string"
    },
    "source_sha256": {
      "title": "Source Sha256",
      "type": "string"
    },
    "candidate_sha256": {
      "title": "Candidate Sha256",
      "type": "string"
    },
    "page_images_inspected": {
      "items": {
        "type": "integer"
      },
      "title": "Page Images Inspected",
      "type": "array"
    },
    "bodies": {
      "items": {
        "$ref": "#/$defs/Body"
      },
      "title": "Bodies",
      "type": "array"
    },
    "execution_notes": {
      "items": {
        "$ref": "#/$defs/ExecutionNote"
      },
      "title": "Execution Notes",
      "type": "array"
    },
    "external_dispositions": {
      "items": {
        "$ref": "#/$defs/Disposition"
      },
      "title": "External Dispositions",
      "type": "array"
    },
    "report_accounting_note": {
      "title": "Report Accounting Note",
      "type": "string"
    },
    "method": {
      "title": "Method",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "title": "Files",
      "type": "array"
    }
  },
  "required": [
    "prepared_at",
    "source_sha256",
    "candidate_sha256",
    "page_images_inspected",
    "bodies",
    "execution_notes",
    "external_dispositions",
    "report_accounting_note",
    "method",
    "limitations",
    "files"
