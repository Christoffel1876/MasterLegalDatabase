      "type": "integer"
    },
    "assignment_id": {
      "const": "EB-PDF-012",
      "default": "EB-PDF-012",
      "title": "Assignment Id",
      "type": "string"
    },
    "source_id": {
      "const": "larimer-data-center-moratorium-sd004-04",
      "default": "larimer-data-center-moratorium-sd004-04",
      "title": "Source Id",
      "type": "string"
    },
    "status": {
      "const": "body_text_checked_execution_block_qualified",
      "default": "body_text_checked_execution_block_qualified",
