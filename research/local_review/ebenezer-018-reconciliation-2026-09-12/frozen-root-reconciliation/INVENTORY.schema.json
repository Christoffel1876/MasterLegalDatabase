{
  "$defs": {
    "FileRef": {
      "additionalProperties": false,
      "description": "A copied file's exact identity, relative to this package.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "FileRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Closed byte inventory, excluding only the inventory and its schema.",
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/FileRef"
      },
      "title": "Files",
      "type": "array"
    },
    "excluded": {
      "const": "INVENTORY.json and INVENTORY.schema.json only",
      "default": "INVENTORY.json and INVENTORY.schema.json only",
      "title": "Excluded",
      "type": "string"
    }
  },
  "required": [
    "files"
  ],
  "title": "Inventory",
  "type": "object"
}
