{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "description": "An ordinary package-relative file and its exact byte identity.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Asset",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Complete portable inventory, excluding only its own file.",
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "package_id": {
      "const": "weld-building-fees-atlas-source-review-2026-09-11",
      "title": "Package Id",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/Asset"
      },
      "title": "Files",
      "type": "array"
    },
    "excluded_self": {
      "const": "evidence-manifest.json",
      "title": "Excluded Self",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "package_id",
    "files",
    "excluded_self"
  ],
  "title": "Inventory",
  "type": "object"
}
