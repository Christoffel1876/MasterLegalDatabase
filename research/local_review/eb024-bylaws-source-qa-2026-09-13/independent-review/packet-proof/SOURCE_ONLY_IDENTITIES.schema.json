{
  "$defs": {
    "Identity": {
      "additionalProperties": false,
      "description": "Neutral fixed assignment and complete page identities.",
      "properties": {
        "assignment_id": {
          "enum": [
            "EB-PDF-023",
            "EB-PDF-024"
          ],
          "title": "Assignment Id",
          "type": "string"
        },
        "source_id": {
          "enum": [
            "larimer-equity-fee-memo-sd007-05",
            "el-paso-boh-bylaws-sd011"
          ],
          "title": "Source Id",
          "type": "string"
        },
        "authority_id": {
          "enum": [
            "CO-COUNTY-LARIMER",
            "CO-COUNTY-EL_PASO"
          ],
          "title": "Authority Id",
          "type": "string"
        },
        "expected_pages": {
          "title": "Expected Pages",
          "type": "integer"
        },
        "original": {
          "$ref": "#/$defs/Ref"
        },
        "pages": {
          "items": {
            "$ref": "#/$defs/Page"
          },
          "title": "Pages",
          "type": "array"
        }
      },
      "required": [
        "assignment_id",
        "source_id",
        "authority_id",
        "expected_pages",
        "original",
        "pages"
      ],
      "title": "Identity",
      "type": "object"
    },
    "Page": {
      "additionalProperties": false,
      "description": "A complete physical-page image, without transcription hints.",
      "properties": {
        "physical_page": {
          "minimum": 1,
          "title": "Physical Page",
          "type": "integer"
        },
        "image": {
          "$ref": "#/$defs/Ref"
        },
        "width": {
          "const": 2550,
          "default": 2550,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "const": 3300,
          "default": 3300,
          "title": "Height",
          "type": "integer"
        }
      },
      "required": [
        "physical_page",
        "image"
      ],
      "title": "Page",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "description": "An exact packet-relative artifact.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Ref",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The only content-bearing pre-freeze metadata.",
  "properties": {
    "packet_id": {
      "const": "ebenezer-023-024-2026-09-13",
      "default": "ebenezer-023-024-2026-09-13",
      "title": "Packet Id",
      "type": "string"
    },
    "status": {
      "const": "PREPARED_NOT_DISPATCHED",
      "default": "PREPARED_NOT_DISPATCHED",
      "title": "Status",
      "type": "string"
    },
    "documents": {
      "items": {
        "$ref": "#/$defs/Identity"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Documents",
      "type": "array"
    },
    "legal_currentness": {
      "const": "not_verified",
      "default": "not_verified",
      "title": "Legal Currentness",
      "type": "string"
    }
  },
  "required": [
    "documents"
  ],
  "title": "Identities",
  "type": "object"
}
