{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Asset",
      "type": "object"
    },
    "DateAssertion": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "physical_page": {
          "minimum": 1,
          "title": "Physical Page",
          "type": "integer"
        },
        "qualification": {
          "const": "source_statement_only_not_independently_verified",
          "title": "Qualification",
          "type": "string"
        }
      },
      "required": [
        "value",
        "role",
        "physical_page",
        "qualification"
      ],
      "title": "DateAssertion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "authority_id": {
      "enum": [
        "CO-COUNTY-MESA",
        "CO-MUNICIPAL-GRAND_JUNCTION"
      ],
      "title": "Authority Id",
      "type": "string"
    },
    "layer_id": {
      "enum": [
        "08_County_Authorities",
        "10_Municipal_Authorities"
      ],
      "title": "Layer Id",
      "type": "string"
    },
    "role": {
      "enum": [
        "municipal_significant_tree_amendment_instrument",
        "county_historical_planning_fee_exhibit",
        "county_building_department_fee_exhibit"
      ],
      "title": "Role",
      "type": "string"
    },
    "priority_id": {
      "title": "Priority Id",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "staged_original": {
      "$ref": "#/$defs/Asset"
    },
    "event": {
      "$ref": "#/$defs/Asset"
    },
    "http_started_at": {
      "format": "date-time",
      "title": "Http Started At",
      "type": "string"
    },
    "http_completed_at": {
      "format": "date-time",
      "title": "Http Completed At",
      "type": "string"
    },
    "exact_requested_url": {
      "title": "Exact Requested Url",
      "type": "string"
    },
    "exact_final_url": {
      "title": "Exact Final Url",
      "type": "string"
    },
    "tls_verified": {
      "const": true,
      "title": "Tls Verified",
      "type": "boolean"
    },
    "http_status": {
      "const": 200,
      "title": "Http Status",
      "type": "integer"
    },
    "redirects": {
      "const": 0,
      "title": "Redirects",
      "type": "integer"
    },
    "physical_pages": {
      "title": "Physical Pages",
      "type": "integer"
    },
    "native_utf8_bytes": {
      "title": "Native Utf8 Bytes",
      "type": "integer"
    },
    "discovery_visually_reviewed_pages": {
      "items": {
        "type": "integer"
      },
      "title": "Discovery Visually Reviewed Pages",
      "type": "array"
    },
    "intake_title_scope_pages_viewed": {
      "items": {
        "type": "integer"
      },
      "title": "Intake Title Scope Pages Viewed",
      "type": "array"
    },
    "full_text_semantically_reviewed": {
      "const": false,
      "title": "Full Text Semantically Reviewed",
      "type": "boolean"
    },
    "native_extraction_gap_pages": {
      "items": {
        "type": "integer"
      },
      "title": "Native Extraction Gap Pages",
      "type": "array"
    },
    "legacy_registry_source_ids": {
      "items": {
        "type": "string"
      },
      "title": "Legacy Registry Source Ids",
      "type": "array"
    },
    "historical_digest_match_records": {
      "minimum": 0,
      "title": "Historical Digest Match Records",
      "type": "integer"
    },
    "dates": {
      "items": {
        "$ref": "#/$defs/DateAssertion"
      },
      "title": "Dates",
      "type": "array"
    },
    "legal_currentness": {
      "const": "not_verified",
      "title": "Legal Currentness",
      "type": "string"
    },
    "status": {
      "const": "archived_pending_pipeline",
      "title": "Status",
      "type": "string"
    },
    "scope_qualifications": {
      "items": {
        "type": "string"
      },
      "title": "Scope Qualifications",
      "type": "array"
    }
  },
  "required": [
    "source_id",
    "authority_id",
    "layer_id",
    "role",
    "priority_id",
    "event_id",
    "staged_original",
    "event",
    "http_started_at",
    "http_completed_at",
    "exact_requested_url",
    "exact_final_url",
    "tls_verified",
    "http_status",
    "redirects",
    "physical_pages",
    "native_utf8_bytes",
    "discovery_visually_reviewed_pages",
    "intake_title_scope_pages_viewed",
    "full_text_semantically_reviewed",
    "native_extraction_gap_pages",
    "legacy_registry_source_ids",
    "historical_digest_match_records",
    "dates",
    "legal_currentness",
    "status",
    "scope_qualifications"
  ],
  "title": "Source",
  "type": "object"
}
