          </li>
              
<li  class="sub-menu__item sub-menu__item--sub-1">
                <a href="/departments-and-services/community-development/building/contact-building-department" class="sub-menu__link sub-menu__link--sub-1" data-drupal-link-system-path="node/1447">Contact Us</a>
          </li>
              
<li  class="sub-menu__item sub-menu__item--sub-1">
                <a href="/departments-and-services/community-development/building/contractor-licensing-building-department" title="Contractor licensing" class="sub-menu__link sub-menu__link--sub-1" data-drupal-link-system-path="node/131">Contractor Licensing</a>
          </li>
              
<li  class="sub-menu__item sub-menu__item--sub-1">
                <a href="/departments-and-services/community-development/building/frequently-asked-questions" title="Frequently asked Building Department Questions" class="sub-menu__link sub-menu__link--sub-1" data-drupal-link-system-path="node/3972">Frequently Asked Questions</a>
