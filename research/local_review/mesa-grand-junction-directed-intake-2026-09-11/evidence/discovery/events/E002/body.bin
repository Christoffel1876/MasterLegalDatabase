<section  class="section section--primary-4 section--padding-reduced section--margin-default section__icon-group">
  <div  class="flexgrid">
    
        
    <div class="icon-links paragraph-content">
      
  
<div  class="icon_card_group flexgrid-nm icon-links paragraph-content">
          
  

<a href=https://apps.mesacounty.us/fee-estimator/  class="icon-card icon-card--with-description col-md-12 col-xl-6 col-xxl-4">
    

<span  class="icon-card__icon icon-card__icon--accent-1">
  <i class="fa-light fa-calculator" role="presentation" alt="calculator"></i>
</span>

  <div  class="icon-card__content">
        <div  class="icon-card__title">
      <span>Building permit fee estimator</span>
