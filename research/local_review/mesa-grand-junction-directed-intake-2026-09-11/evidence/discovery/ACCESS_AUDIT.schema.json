        },
        "local_availability": {
          "title": "Local Availability",
          "type": "string"
        },
        "local_recomputed_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Local Recomputed Sha256"
