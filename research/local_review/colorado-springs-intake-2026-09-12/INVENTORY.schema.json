{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Asset",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/Asset"
      },
      "title": "Files",
      "type": "array"
    },
    "excluded_files": {
      "items": {
        "type": "string"
      },
      "title": "Excluded Files",
      "type": "array"
    },
    "legal_currentness": {
      "const": "not_verified",
      "default": "not_verified",
      "title": "Legal Currentness",
      "type": "string"
    }
  },
  "required": [
    "files",
    "excluded_files"
  ],
  "title": "Inventory",
  "type": "object"
