{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "Claims": {
      "additionalProperties": false,
      "properties": {
        "requested_url": {
          "title": "Requested Url",
          "type": "string"
        },
        "final_url": {
          "title": "Final Url",
          "type": "string"
        },
        "logged_at": {
          "format": "date-time",
          "title": "Logged At",
          "type": "string"
        },
        "supplied_http_status": {
          "title": "Supplied Http Status",
          "type": "integer"
        },
        "supplied_content_type": {
          "title": "Supplied Content Type",
          "type": "string"
        },
        "event_index": {
          "title": "Event Index",
          "type": "integer"
        },
        "claimed_referral_url": {
          "title": "Claimed Referral Url",
          "type": "string"
        },
        "referral_basis": {
          "enum": [
            "inferred_filename_pattern_current_anchor_unverified",
            "historical_metadata_route_current_anchor_unverified",
            "supplied_catalog_referral_not_reverified"
          ],
          "title": "Referral Basis",
          "type": "string"
        },
        "original_http_acquisition_at": {
          "default": null,
          "title": "Original Http Acquisition At",
          "type": "null"
        },
        "original_http_acquisition_verified": {
          "const": false,
          "default": false,
          "title": "Original Http Acquisition Verified",
          "type": "boolean"
        },
        "metadata_copy_path": {
          "title": "Metadata Copy Path",
          "type": "string"
        },
        "metadata_sha256": {
          "title": "Metadata Sha256",
          "type": "string"
        },
        "package_log_copy_path": {
          "title": "Package Log Copy Path",
          "type": "string"
        },
        "package_log_sha256": {
          "title": "Package Log Sha256",
          "type": "string"
        },
        "upstream_origin_caveat": {
          "title": "Upstream Origin Caveat",
          "type": "string"
        }
      },
      "required": [
        "requested_url",
        "final_url",
        "logged_at",
        "supplied_http_status",
        "supplied_content_type",
        "event_index",
        "claimed_referral_url",
        "referral_basis",
        "metadata_copy_path",
        "metadata_sha256",
        "package_log_copy_path",
        "package_log_sha256",
        "upstream_origin_caveat"
      ],
      "title": "Claims",
      "type": "object"
    },
    "Copy": {
      "additionalProperties": false,
      "properties": {
        "supplied": {
          "$ref": "#/$defs/Artifact"
        },
        "preserved": {
          "$ref": "#/$defs/Artifact"
        }
      },
      "required": [
        "supplied",
        "preserved"
      ],
      "title": "Copy",
      "type": "object"
    },
    "History": {
      "additionalProperties": false,
      "properties": {
        "comparison_commit": {
          "title": "Comparison Commit",
          "type": "string"
        },
        "exact_url_historical_lines": {
          "items": {
            "type": "integer"
          },
          "title": "Exact Url Historical Lines",
          "type": "array"
        },
        "global_digest_historical_lines": {
          "items": {
            "type": "integer"
          },
          "title": "Global Digest Historical Lines",
          "type": "array"
        },
        "exact_url_and_digest_historical_lines": {
          "items": {
            "type": "integer"
          },
          "title": "Exact Url And Digest Historical Lines",
          "type": "array"
        },
        "historical_source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Historical Source Ids",
          "type": "array"
        },
        "historical_authority_ids": {
          "items": {
            "type": "string"
          },
          "title": "Historical Authority Ids",
          "type": "array"
        },
        "disposition": {
          "title": "Disposition",
          "type": "string"
        },
        "historical_originals_opened": {
          "const": false,
          "default": false,
          "title": "Historical Originals Opened",
          "type": "boolean"
        },
        "limit": {
          "title": "Limit",
          "type": "string"
        }
      },
      "required": [
        "comparison_commit",
        "exact_url_historical_lines",
        "global_digest_historical_lines",
        "exact_url_and_digest_historical_lines",
        "historical_source_ids",
        "historical_authority_ids",
        "disposition",
        "limit"
      ],
      "title": "History",
      "type": "object"
    },
    "ManualIntakeArchiveVerification": {
      "additionalProperties": false,
      "description": "Distinguish verified archive bytes from retained ledger-only history.",
      "properties": {
        "manifest_records": {
          "minimum": 0,
          "title": "Manifest Records",
          "type": "integer"
        },
        "verified_intake_ids": {
          "items": {
            "type": "string"
          },
          "title": "Verified Intake Ids",
          "type": "array"
        },
        "ledger_only_intake_ids": {
          "items": {
            "type": "string"
          },
          "title": "Ledger Only Intake Ids",
          "type": "array"
        },
        "missing_ledger_only_intake_ids": {
          "items": {
            "type": "string"
          },
          "title": "Missing Ledger Only Intake Ids",
          "type": "array"
        },
        "boundary": {
          "default": "Hash and size verification establishes local byte identity only. Ledger-only history may lack a local original; custody, acquisition claims, pipeline status, and legal currentness are not promoted.",
          "title": "Boundary",
          "type": "string"
        }
      },
      "required": [
        "manifest_records",
        "verified_intake_ids",
        "ledger_only_intake_ids",
        "missing_ledger_only_intake_ids"
      ],
      "title": "ManualIntakeArchiveVerification",
      "type": "object"
    },
    "ManualIntakeReconciliation": {
      "additionalProperties": false,
      "description": "Validated preview or result of reconciling the archive into the ledger.",
      "properties": {
        "status": {
          "enum": [
            "dry_run",
            "updated",
            "no_change"
          ],
          "title": "Status",
          "type": "string"
        },
        "added_intake_ids": {
          "items": {
            "type": "string"
          },
          "title": "Added Intake Ids",
          "type": "array"
        },
        "ledger_records_before": {
          "minimum": 0,
          "title": "Ledger Records Before",
          "type": "integer"
        },
        "ledger_records_after": {
          "minimum": 0,
          "title": "Ledger Records After",
          "type": "integer"
        },
        "report_needs_update": {
          "title": "Report Needs Update",
          "type": "boolean"
        },
        "report": {
          "$ref": "#/$defs/ManualSourceIntakeReport"
        }
      },
      "required": [
        "status",
        "added_intake_ids",
        "ledger_records_before",
        "ledger_records_after",
        "report_needs_update",
        "report"
      ],
      "title": "ManualIntakeReconciliation",
      "type": "object"
    },
    "ManualSourceIntakeRecord": {
      "additionalProperties": false,
      "description": "Durable record for one archived manual source artifact.",
      "properties": {
        "intake_id": {
          "title": "Intake Id",
          "type": "string"
        },
        "record_id": {
          "title": "Record Id",
          "type": "string"
        },
        "layer_id": {
          "title": "Layer Id",
          "type": "string"
        },
        "official_source_name": {
          "title": "Official Source Name",
          "type": "string"
        },
        "official_source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Official Source Url"
        },
        "acquisition_method": {
          "title": "Acquisition Method",
          "type": "string"
        },
        "received_from": {
          "title": "Received From",
          "type": "string"
        },
        "reviewer_name": {
          "title": "Reviewer Name",
          "type": "string"
        },
        "reviewer_email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer Email"
        },
        "custody_note": {
          "title": "Custody Note",
          "type": "string"
        },
        "original_filename": {
          "title": "Original Filename",
          "type": "string"
        },
        "archive_path": {
          "title": "Archive Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        },
        "source_format": {
          "title": "Source Format",
          "type": "string"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "blocked_queue_match": {
          "title": "Blocked Queue Match",
          "type": "boolean"
        },
        "boundary": {
          "title": "Boundary",
          "type": "string"
        }
      },
      "required": [
        "intake_id",
        "record_id",
        "layer_id",
        "official_source_name",
        "acquisition_method",
        "received_from",
        "reviewer_name",
        "custody_note",
        "original_filename",
        "archive_path",
        "sha256",
        "size_bytes",
        "source_format",
        "received_at",
        "status",
        "blocked_queue_match",
        "boundary"
      ],
      "title": "ManualSourceIntakeRecord",
      "type": "object"
    },
    "ManualSourceIntakeReport": {
      "additionalProperties": false,
      "description": "Summary of manual source intake state.",
      "properties": {
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "ledger_path": {
          "title": "Ledger Path",
          "type": "string"
        },
        "archive_manifest_path": {
          "title": "Archive Manifest Path",
          "type": "string"
        },
        "records": {
          "minimum": 0,
          "title": "Records",
          "type": "integer"
        },
        "pending_pipeline_use": {
          "minimum": 0,
          "title": "Pending Pipeline Use",
          "type": "integer"
        },
        "layers": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Layers",
          "type": "object"
        },
        "latest_record_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latest Record Id"
        },
        "acquisition_methods": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Acquisition Methods",
          "type": "object"
        },
        "archive_verification": {
          "anyOf": [
            {
              "$ref": "#/$defs/ManualIntakeArchiveVerification"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "boundary": {
          "title": "Boundary",
          "type": "string"
        }
      },
      "required": [
        "generated_at",
        "ledger_path",
        "archive_manifest_path",
        "records",
        "pending_pipeline_use",
        "boundary"
      ],
      "title": "ManualSourceIntakeReport",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "authority_id": {
          "const": "CO-MUNICIPAL-FORT_COLLINS",
          "default": "CO-MUNICIPAL-FORT_COLLINS",
          "title": "Authority Id",
          "type": "string"
        },
        "authority_assignment_basis": {
          "title": "Authority Assignment Basis",
          "type": "string"
        },
        "layer_id": {
          "const": "10_Municipal_Authorities",
          "default": "10_Municipal_Authorities",
          "title": "Layer Id",
          "type": "string"
        },
        "source_label": {
          "title": "Source Label",
          "type": "string"
        },
        "label_basis": {
          "title": "Label Basis",
          "type": "string"
        },
        "source_role": {
          "enum": [
            "local_amendment_candidate",
            "related_code_candidate",
            "code_article_candidate",
            "meeting_packet"
          ],
          "title": "Source Role",
          "type": "string"
        },
        "manual_intake": {
          "$ref": "#/$defs/ManualSourceIntakeRecord"
        },
        "archive_member": {
          "title": "Archive Member",
          "type": "string"
        },
        "original": {
          "$ref": "#/$defs/Artifact"
        },
        "structural_pages": {
          "exclusiveMinimum": 0,
          "title": "Structural Pages",
          "type": "integer"
        },
        "pdf_repaired": {
          "const": false,
          "default": false,
          "title": "Pdf Repaired",
          "type": "boolean"
        },
        "pdf_encrypted": {
          "const": false,
          "default": false,
          "title": "Pdf Encrypted",
          "type": "boolean"
        },
        "terminal_eof": {
          "const": true,
          "default": true,
          "title": "Terminal Eof",
          "type": "boolean"
        },
        "page_tree_accessible": {
          "const": true,
          "default": true,
          "title": "Page Tree Accessible",
          "type": "boolean"
        },
        "claims": {
          "$ref": "#/$defs/Claims"
        },
        "historical_comparison": {
          "$ref": "#/$defs/History"
        },
        "status": {
          "const": "archived_pending_pipeline",
          "default": "archived_pending_pipeline",
          "title": "Status",
          "type": "string"
        },
        "legal_currentness": {
          "const": "not_verified",
          "default": "not_verified",
          "title": "Legal Currentness",
          "type": "string"
        },
        "legal_review": {
          "const": "pending",
          "default": "pending",
          "title": "Legal Review",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "source_id",
        "authority_assignment_basis",
        "source_label",
        "label_basis",
        "source_role",
        "manual_intake",
        "archive_member",
        "original",
        "structural_pages",
        "claims",
        "historical_comparison",
        "limitations"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "received_at": {
      "format": "date-time",
      "title": "Received At",
      "type": "string"
    },
    "status": {
      "const": "archived_pending_pipeline",
      "default": "archived_pending_pipeline",
      "title": "Status",
      "type": "string"
    },
    "legal_currentness": {
      "const": "not_verified",
      "default": "not_verified",
      "title": "Legal Currentness",
      "type": "string"
    },
    "archive": {
      "$ref": "#/$defs/Artifact"
    },
    "archive_members_reverified": {
      "title": "Archive Members Reverified",
      "type": "integer"
    },
    "selected_pdf_count": {
      "title": "Selected Pdf Count",
      "type": "integer"
    },
    "selected_pdf_bytes": {
      "title": "Selected Pdf Bytes",
      "type": "integer"
    },
    "selected_structural_pages": {
      "title": "Selected Structural Pages",
      "type": "integer"
    },
    "code_and_amendment_candidates": {
      "title": "Code And Amendment Candidates",
      "type": "integer"
    },
    "code_and_amendment_pages": {
      "title": "Code And Amendment Pages",
      "type": "integer"
    },
    "meeting_packets": {
      "title": "Meeting Packets",
      "type": "integer"
    },
    "meeting_packet_pages": {
      "title": "Meeting Packet Pages",
      "type": "integer"
    },
    "inferred_target_count": {
      "title": "Inferred Target Count",
      "type": "integer"
    },
    "historical_digest_matches": {
      "title": "Historical Digest Matches",
      "type": "integer"
    },
    "unmatched_historical_digests": {
      "title": "Unmatched Historical Digests",
      "type": "integer"
    },
    "copies": {
      "items": {
        "$ref": "#/$defs/Copy"
      },
      "title": "Copies",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "title": "Sources",
      "type": "array"
    },
    "manual_manifest_before": {
      "$ref": "#/$defs/Artifact"
    },
    "manual_manifest_after": {
      "$ref": "#/$defs/Artifact"
    },
    "manual_manifest_snapshot": {
      "$ref": "#/$defs/Artifact"
    },
    "control_before": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "title": "Control Before",
      "type": "array"
    },
    "control_after": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "title": "Control After",
      "type": "array"
    },
    "control_snapshots": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "title": "Control Snapshots",
      "type": "array"
    },
    "reconciliation_runs": {
      "items": {
        "$ref": "#/$defs/ManualIntakeReconciliation"
      },
      "title": "Reconciliation Runs",
      "type": "array"
    },
    "preexisting_inputs_unchanged": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "title": "Preexisting Inputs Unchanged",
      "type": "array"
    },
    "acquisition_time_basis": {
      "title": "Acquisition Time Basis",
      "type": "string"
    },
    "deduplication_scope": {
      "title": "Deduplication Scope",
      "type": "string"
    },
    "pipeline_code": {
      "$ref": "#/$defs/Artifact"
    },
    "python_pdf_engine": {
      "title": "Python Pdf Engine",
      "type": "string"
    },
    "source_schema": {
      "$ref": "#/$defs/Artifact"
    },
    "receipt_schema": {
      "$ref": "#/$defs/Artifact"
    },
    "generated_records": {
      "$ref": "#/$defs/Artifact"
    },
    "manual_records": {
      "$ref": "#/$defs/Artifact"
    },
    "modified_paths": {
      "items": {
        "type": "string"
      },
      "title": "Modified Paths",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "received_at",
    "archive",
    "archive_members_reverified",
    "selected_pdf_count",
    "selected_pdf_bytes",
    "selected_structural_pages",
    "code_and_amendment_candidates",
    "code_and_amendment_pages",
    "meeting_packets",
    "meeting_packet_pages",
    "inferred_target_count",
    "historical_digest_matches",
    "unmatched_historical_digests",
    "copies",
    "sources",
    "manual_manifest_before",
