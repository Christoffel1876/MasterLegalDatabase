{
  "$defs": {
    "Budget": {
      "additionalProperties": false,
      "description": "Recommend finite limits; this is not a runnable watch configuration.",
      "properties": {
        "baseline_bytes": {
          "title": "Baseline Bytes",
          "type": "integer"
        },
        "baseline_pages": {
          "title": "Baseline Pages",
          "type": "integer"
        },
        "suggested_sub_batches": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Suggested Sub Batches",
          "type": "array"
        },
        "each_sub_batch_baseline_bytes": {
          "items": {
            "type": "integer"
          },
          "title": "Each Sub Batch Baseline Bytes",
          "type": "array"
        },
        "maximum_sources_per_sub_batch": {
          "const": 2,
          "default": 2,
          "title": "Maximum Sources Per Sub Batch",
          "type": "integer"
        },
        "request_events_per_sub_batch": {
          "const": 4,
          "default": 4,
          "title": "Request Events Per Sub Batch",
          "type": "integer"
        },
        "distinct_urls_per_sub_batch": {
          "const": 4,
          "default": 4,
          "title": "Distinct Urls Per Sub Batch",
          "type": "integer"
        },
        "same_host_redirects_per_source": {
          "const": 1,
          "default": 1,
          "title": "Same Host Redirects Per Source",
          "type": "integer"
        },
        "bytes_per_response_ceiling": {
          "const": 2000000,
          "default": 2000000,
          "title": "Bytes Per Response Ceiling",
          "type": "integer"
        },
        "total_response_bytes_per_sub_batch": {
          "const": 4000000,
          "default": 4000000,
          "title": "Total Response Bytes Per Sub Batch",
          "type": "integer"
        },
        "seconds_per_request": {
          "const": 30,
          "default": 30,
          "title": "Seconds Per Request",
          "type": "integer"
        },
        "seconds_per_invocation": {
          "const": 300,
          "default": 300,
          "title": "Seconds Per Invocation",
          "type": "integer"
        },
        "retries": {
          "const": 0,
          "default": 0,
          "title": "Retries",
          "type": "integer"
        },
        "reasoning": {
          "title": "Reasoning",
          "type": "string"
        }
      },
      "required": [
        "baseline_bytes",
        "baseline_pages",
        "suggested_sub_batches",
        "each_sub_batch_baseline_bytes",
        "reasoning"
      ],
      "title": "Budget",
      "type": "object"
    },
    "Candidate": {
      "additionalProperties": false,
      "description": "Preserve custody, review limits and the proposed exact watch target separately.",
      "properties": {
        "rank": {
          "maximum": 6,
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "record_id": {
          "title": "Record Id",
          "type": "string"
        },
        "intake_id": {
          "title": "Intake Id",
          "type": "string"
        },
        "authority_id": {
          "title": "Authority Id",
          "type": "string"
        },
        "layer_id": {
          "title": "Layer Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "baseline": {
          "$ref": "#/$defs/Ref"
        },
        "baseline_pages": {
          "minimum": 1,
          "title": "Baseline Pages",
          "type": "integer"
        },
        "raw_manifest_zero_based_row": {
          "minimum": 0,
          "title": "Raw Manifest Zero Based Row",
          "type": "integer"
        },
        "raw_manifest_exact_line_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Manifest Exact Line Sha256",
          "type": "string"
        },
        "historical_raw_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Historical Raw Url"
        },
        "historical_acquisition_method": {
          "title": "Historical Acquisition Method",
          "type": "string"
        },
        "historical_reported_acquisition": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Historical Reported Acquisition",
          "type": "object"
        },
        "repository_received_at": {
          "format": "date-time",
          "title": "Repository Received At",
          "type": "string"
        },
        "proposed_url": {
          "title": "Proposed Url",
          "type": "string"
        },
        "retained_final_url": {
          "title": "Retained Final Url",
          "type": "string"
        },
        "http_started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Http Started At"
        },
        "http_finished_at": {
          "format": "date-time",
          "title": "Http Finished At",
          "type": "string"
        },
        "http_time_role": {
          "title": "Http Time Role",
          "type": "string"
        },
        "recorded_http_status": {
          "const": 200,
          "title": "Recorded Http Status",
          "type": "integer"
        },
        "recorded_redirects": {
          "const": 0,
          "title": "Recorded Redirects",
          "type": "integer"
        },
        "official_link_basis": {
          "title": "Official Link Basis",
          "type": "string"
        },
        "official_parent_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Official Parent Url"
        },
        "official_parent_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Official Parent Label"
        },
        "authority_evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "custody_evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "referral_evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Referral Evidence",
          "type": "array"
        },
        "review_evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "review_schema": {
          "$ref": "#/$defs/Ref"
        },
        "mapped_review_kind": {
          "title": "Mapped Review Kind",
          "type": "string"
        },
        "mapped_scope_fields": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Mapped Scope Fields",
          "type": "object"
        },
        "recorded_source_roles": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Recorded Source Roles",
          "type": "object"
        },
        "review_limitations": {
          "items": {
            "type": "string"
          },
          "title": "Review Limitations",
          "type": "array"
        },
        "proposal_reason": {
          "title": "Proposal Reason",
          "type": "string"
        },
        "enrollment_conditions": {
          "items": {
            "type": "string"
          },
          "title": "Enrollment Conditions",
          "type": "array"
        },
        "legal_currentness": {
          "const": "not_verified",
          "default": "not_verified",
          "title": "Legal Currentness",
          "type": "string"
        },
        "answer_safe": {
          "const": false,
          "default": false,
          "title": "Answer Safe",
          "type": "boolean"
        },
        "status": {
          "const": "PREPARED_NOT_ACTIVATED",
          "default": "PREPARED_NOT_ACTIVATED",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "rank",
        "record_id",
        "intake_id",
        "authority_id",
        "layer_id",
        "title",
        "baseline",
        "baseline_pages",
        "raw_manifest_zero_based_row",
        "raw_manifest_exact_line_sha256",
        "historical_raw_url",
        "historical_acquisition_method",
        "historical_reported_acquisition",
        "repository_received_at",
        "proposed_url",
        "retained_final_url",
        "http_started_at",
        "http_finished_at",
        "http_time_role",
        "recorded_http_status",
        "recorded_redirects",
        "official_link_basis",
        "official_parent_url",
        "official_parent_label",
        "authority_evidence",
        "custody_evidence",
        "referral_evidence",
        "review_evidence",
        "review_schema",
        "mapped_review_kind",
        "mapped_scope_fields",
        "recorded_source_roles",
        "review_limitations",
        "proposal_reason",
        "enrollment_conditions"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "Identify an exact metadata document and, optionally, a zero-based JSONL row.",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/Ref"
        },
        "jsonl_row": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Jsonl Row"
        },
        "pointers": {
          "items": {
            "type": "string"
          },
          "title": "Pointers",
          "type": "array"
        },
        "scope": {
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "pointers",
        "scope"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "JsonValue": {},
    "Ref": {
      "additionalProperties": false,
      "description": "Bind a repository-relative metadata file or a declared archived original.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Ref",
      "type": "object"
    },
    "Remaining": {
      "additionalProperties": false,
      "description": "Classify one unselected record without claiming a new complete evidence audit.",
      "properties": {
        "record_id": {
          "title": "Record Id",
          "type": "string"
        },
        "authority_id": {
          "title": "Authority Id",
          "type": "string"
        },
        "inventory_zero_based_row": {
          "minimum": 0,
          "title": "Inventory Zero Based Row",
          "type": "integer"
        },
        "baseline": {
          "$ref": "#/$defs/Ref"
        },
        "review_mapped": {
          "title": "Review Mapped",
          "type": "boolean"
        },
        "verified_http_mapped": {
          "title": "Verified Http Mapped",
          "type": "boolean"
        },
        "disposition": {
          "enum": [
            "proposed",
            "verified_custody_deferred",
            "reviewed_missing_mapped_http",
            "metadata_only_missing_mapped_http"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "authority_id",
        "inventory_zero_based_row",
        "baseline",
        "review_mapped",
        "verified_http_mapped",
        "disposition",
        "reason"
      ],
      "title": "Remaining",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind six proposals and all 59 unselected inventory dispositions.",
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "prepared_at": {
      "format": "date-time",
      "title": "Prepared At",
      "type": "string"
    },
    "status": {
      "const": "PREPARED_NOT_ACTIVATED",
      "default": "PREPARED_NOT_ACTIVATED",
      "title": "Status",
      "type": "string"
    },
    "input_pins": {
      "additionalProperties": {
        "$ref": "#/$defs/Ref"
      },
      "title": "Input Pins",
      "type": "object"
    },
    "metadata_evidence_pins": {
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "title": "Metadata Evidence Pins",
      "type": "array"
    },
    "currently_selected": {
      "items": {
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Currently Selected",
      "type": "array"
    },
    "inventory_records": {
      "const": 61,
      "default": 61,
      "title": "Inventory Records",
      "type": "integer"
    },
    "inventory_mapped_reviews": {
      "const": 21,
      "default": 21,
      "title": "Inventory Mapped Reviews",
      "type": "integer"
    },
    "unselected_records": {
      "const": 59,
      "default": 59,
      "title": "Unselected Records",
      "type": "integer"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/Candidate"
      },
      "maxItems": 6,
      "minItems": 6,
      "title": "Candidates",
      "type": "array"
    },
    "remaining": {
      "items": {
        "$ref": "#/$defs/Remaining"
      },
      "maxItems": 59,
      "minItems": 59,
      "title": "Remaining",
      "type": "array"
    },
    "partition_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Partition Counts",
      "type": "object"
    },
    "budget": {
      "$ref": "#/$defs/Budget"
    },
    "activation_gates": {
      "items": {
        "type": "string"
      },
      "title": "Activation Gates",
      "type": "array"
    },
    "edition_discovery_gap": {
      "items": {
        "type": "string"
      },
      "title": "Edition Discovery Gap",
      "type": "array"
    },
    "inspection_scope": {
      "items": {
        "type": "string"
      },
      "title": "Inspection Scope",
      "type": "array"
    },
    "legal_currentness": {
      "const": "not_verified",
      "default": "not_verified",
      "title": "Legal Currentness",
      "type": "string"
    },
    "answer_safe": {
      "const": false,
      "default": false,
      "title": "Answer Safe",
      "type": "boolean"
    },
    "public_requests": {
      "const": 0,
      "default": 0,
      "title": "Public Requests",
      "type": "integer"
    },
    "production_writes": {
      "const": 0,
      "default": 0,
      "title": "Production Writes",
      "type": "integer"
    }
  },
  "required": [
    "prepared_at",
    "input_pins",
    "metadata_evidence_pins",
    "currently_selected",
    "candidates",
    "remaining",
    "partition_counts",
    "budget",
    "activation_gates",
    "edition_discovery_gap",
    "inspection_scope"
  ],
  "title": "Proposal",
  "type": "object"
}
