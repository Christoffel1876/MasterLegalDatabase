+BATCHES = {
+    'county-fees-v1': ('arapahoe-planning-fees-sd002-14',
+                       'weld-ehs-fees-2026-atlas-directed'),
+    'western-fees-v1': ('grand-junction-fire-fees-atlas-directed',
+                        'mesa-building-fees-exhibit-a-atlas-directed'),
