+    intake_id: str
+    raw_manifest_line_sha256: str = Field(pattern=r'^[a-f0-9]{64}$')
+    source_context: list[str] = Field(min_length=1)
+    source: SourceBinding
+    legal_currentness: Literal['not_verified'] = 'not_verified'
