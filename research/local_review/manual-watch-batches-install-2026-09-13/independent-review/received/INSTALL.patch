+PROPOSED = Path(__file__).resolve().parents[1]
+SOURCE = (PROPOSED if (PROPOSED / 'AGENTS.md').exists() else
+          PROPOSED.parents[4] / 'MasterLegalDatabase')
+NOW = datetime(2026, 9, 13, 0, 10, tzinfo=timezone.utc)
