{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "description": "Identify an exact metadata document and, optionally, a zero-based JSONL row.",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/Ref"
        },
        "jsonl_row": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Jsonl Row"
        },
        "pointers": {
          "items": {
            "type": "string"
          },
          "title": "Pointers",
          "type": "array"
        },
        "scope": {
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "pointers",
        "scope"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "JsonValue": {},
    "Limits": {
      "additionalProperties": false,
      "description": "Hard maximums; tests or a revised reviewed plan may only narrow them.",
      "properties": {
        "requests": {
          "default": 4,
          "maximum": 4,
          "minimum": 1,
          "title": "Requests",
          "type": "integer"
        },
        "distinct_urls": {
          "default": 4,
          "maximum": 4,
          "minimum": 1,
          "title": "Distinct Urls",
          "type": "integer"
        },
        "redirects_per_source": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Redirects Per Source",
          "type": "integer"
        },
        "bytes_per_source": {
          "default": 2000000,
          "maximum": 2000000,
          "minimum": 1,
          "title": "Bytes Per Source",
          "type": "integer"
        },
        "total_bytes": {
          "default": 4000000,
          "maximum": 4000000,
          "minimum": 1,
          "title": "Total Bytes",
          "type": "integer"
        },
        "request_seconds": {
          "default": 30,
          "maximum": 30,
          "minimum": 1,
          "title": "Request Seconds",
          "type": "integer"
        }
      },
      "title": "Limits",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "description": "Immutable confined local evidence identity.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Ref",
      "type": "object"
    },
    "SourceBinding": {
      "additionalProperties": false,
      "description": "Preserve custody, review limits and the proposed exact watch target separately.",
      "properties": {
        "rank": {
          "maximum": 6,
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "record_id": {
          "title": "Record Id",
          "type": "string"
        },
        "intake_id": {
          "title": "Intake Id",
          "type": "string"
        },
        "authority_id": {
          "title": "Authority Id",
          "type": "string"
        },
        "layer_id": {
          "title": "Layer Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "baseline": {
          "$ref": "#/$defs/Ref"
        },
        "baseline_pages": {
          "minimum": 1,
          "title": "Baseline Pages",
          "type": "integer"
        },
        "raw_manifest_zero_based_row": {
          "minimum": 0,
          "title": "Raw Manifest Zero Based Row",
          "type": "integer"
        },
        "raw_manifest_exact_line_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Manifest Exact Line Sha256",
          "type": "string"
        },
        "historical_raw_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Historical Raw Url"
        },
        "historical_acquisition_method": {
          "title": "Historical Acquisition Method",
          "type": "string"
        },
        "historical_reported_acquisition": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Historical Reported Acquisition",
          "type": "object"
        },
        "repository_received_at": {
          "format": "date-time",
          "title": "Repository Received At",
          "type": "string"
        },
        "proposed_url": {
          "title": "Proposed Url",
          "type": "string"
        },
        "retained_final_url": {
          "title": "Retained Final Url",
          "type": "string"
        },
        "http_started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Http Started At"
        },
        "http_finished_at": {
          "format": "date-time",
          "title": "Http Finished At",
          "type": "string"
        },
        "http_time_role": {
          "title": "Http Time Role",
          "type": "string"
        },
        "recorded_http_status": {
          "const": 200,
          "title": "Recorded Http Status",
          "type": "integer"
        },
        "recorded_redirects": {
          "const": 0,
          "title": "Recorded Redirects",
          "type": "integer"
        },
        "official_link_basis": {
          "title": "Official Link Basis",
          "type": "string"
        },
        "official_parent_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Official Parent Url"
        },
        "official_parent_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Official Parent Label"
        },
        "authority_evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "custody_evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "referral_evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Referral Evidence",
          "type": "array"
        },
        "review_evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "review_schema": {
          "$ref": "#/$defs/Ref"
        },
        "mapped_review_kind": {
          "title": "Mapped Review Kind",
          "type": "string"
        },
        "mapped_scope_fields": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Mapped Scope Fields",
          "type": "object"
        },
        "recorded_source_roles": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Recorded Source Roles",
          "type": "object"
        },
        "review_limitations": {
          "items": {
            "type": "string"
          },
          "title": "Review Limitations",
          "type": "array"
        },
        "proposal_reason": {
          "title": "Proposal Reason",
          "type": "string"
        },
        "enrollment_conditions": {
          "items": {
            "type": "string"
          },
          "title": "Enrollment Conditions",
          "type": "array"
        },
        "legal_currentness": {
          "const": "not_verified",
          "default": "not_verified",
          "title": "Legal Currentness",
          "type": "string"
        },
        "answer_safe": {
          "const": false,
          "default": false,
          "title": "Answer Safe",
          "type": "boolean"
        },
        "status": {
          "const": "PREPARED_NOT_ACTIVATED",
          "default": "PREPARED_NOT_ACTIVATED",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "rank",
        "record_id",
        "intake_id",
        "authority_id",
        "layer_id",
        "title",
        "baseline",
        "baseline_pages",
        "raw_manifest_zero_based_row",
        "raw_manifest_exact_line_sha256",
        "historical_raw_url",
        "historical_acquisition_method",
        "historical_reported_acquisition",
        "repository_received_at",
        "proposed_url",
        "retained_final_url",
        "http_started_at",
        "http_finished_at",
        "http_time_role",
        "recorded_http_status",
        "recorded_redirects",
        "official_link_basis",
        "official_parent_url",
        "official_parent_label",
        "authority_evidence",
        "custody_evidence",
        "referral_evidence",
        "review_evidence",
        "review_schema",
        "mapped_review_kind",
        "mapped_scope_fields",
        "recorded_source_roles",
        "review_limitations",
        "proposal_reason",
        "enrollment_conditions"
      ],
      "title": "SourceBinding",
      "type": "object"
    },
    "Target": {
      "additionalProperties": false,
      "description": "One exact source and complete custody/qualification fields for result consumers.",
      "properties": {
        "source_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "canonical_source_id": {
          "title": "Canonical Source Id",
          "type": "string"
        },
        "authority_id": {
          "title": "Authority Id",
          "type": "string"
        },
        "baseline": {
          "$ref": "#/$defs/Ref"
        },
        "baseline_page_count": {
          "maximum": 100,
          "minimum": 1,
          "title": "Baseline Page Count",
          "type": "integer"
        },
        "baseline_request_started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Baseline Request Started At"
        },
        "baseline_response_finished_at": {
          "format": "date-time",
          "title": "Baseline Response Finished At",
          "type": "string"
        },
        "repository_received_at": {
          "format": "date-time",
          "title": "Repository Received At",
          "type": "string"
        },
        "intake_id": {
          "title": "Intake Id",
          "type": "string"
        },
        "raw_manifest_line_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Raw Manifest Line Sha256",
          "type": "string"
        },
        "source_context": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Context",
          "type": "array"
        },
        "source": {
          "$ref": "#/$defs/SourceBinding"
        },
        "legal_currentness": {
          "const": "not_verified",
          "default": "not_verified",
          "title": "Legal Currentness",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "url",
        "canonical_source_id",
        "authority_id",
        "baseline",
        "baseline_page_count",
        "baseline_request_started_at",
        "baseline_response_finished_at",
        "repository_received_at",
        "intake_id",
        "raw_manifest_line_sha256",
        "source_context",
        "source"
      ],
      "title": "Target",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One selected named pair. Limits may narrow, but source membership never expands.",
  "properties": {
    "targets": {
      "items": {
        "$ref": "#/$defs/Target"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Targets",
      "type": "array"
    },
    "limits": {
      "$ref": "#/$defs/Limits"
    },
    "max_run_seconds": {
      "default": 300,
      "maximum": 300,
      "minimum": 1,
      "title": "Max Run Seconds",
      "type": "integer"
    },
    "batch_id": {
      "enum": [
        "county-fees-v1",
        "western-fees-v1",
        "greeley-fees-v1"
      ],
      "title": "Batch Id",
      "type": "string"
    },
    "status": {
      "const": "configured_not_scheduled",
      "title": "Status",
      "type": "string"
    },
    "source_catalog_sha256": {
      "const": "d70ab79926513fa01d502ca03b824223fd47cb62f4d5d3a750d2c2633d6e564a",
      "title": "Source Catalog Sha256",
      "type": "string"
    },
    "automatic_baseline_updates": {
      "const": false,
      "default": false,
      "title": "Automatic Baseline Updates",
      "type": "boolean"
    },
    "legal_currentness": {
      "const": "not_verified",
      "default": "not_verified",
      "title": "Legal Currentness",
      "type": "string"
    },
    "qualifications": {
      "items": {
        "type": "string"
      },
      "title": "Qualifications",
      "type": "array"
    }
  },
  "required": [
    "targets",
    "batch_id",
    "status",
    "source_catalog_sha256",
    "qualifications"
  ],
  "title": "Plan",
  "type": "object"
}
