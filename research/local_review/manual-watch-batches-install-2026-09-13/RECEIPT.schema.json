{
  "$defs": {
    "Ref": {
      "additionalProperties": false,
      "description": "One exact relative file identity.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Ref",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Root installation, with no implicit public execution or currentness claim.",
  "properties": {
    "status": {
      "const": "installed_exact_reviewed_files",
      "title": "Status",
      "type": "string"
    },
    "finished_at": {
      "title": "Finished At",
      "type": "string"
    },
    "proposal_sha256": {
      "title": "Proposal Sha256",
      "type": "string"
    },
    "review_sha256": {
      "title": "Review Sha256",
      "type": "string"
    },
    "installed_files": {
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "title": "Installed Files",
      "type": "array"
    },
    "preserved_files": {
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "title": "Preserved Files",
      "type": "array"
    },
    "unchanged_springs_inputs": {
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "title": "Unchanged Springs Inputs",
      "type": "array"
    },
    "public_requests": {
      "const": 0,
      "default": 0,
      "title": "Public Requests",
      "type": "integer"
    },
    "legal_currentness": {
      "const": "not_verified",
      "default": "not_verified",
      "title": "Legal Currentness",
      "type": "string"
    },
    "full_repository_suite": {
      "const": "pending_after_remaining_code_integration",
      "title": "Full Repository Suite",
      "type": "string"
    }
  },
  "required": [
    "status",
    "finished_at",
    "proposal_sha256",
    "review_sha256",
    "installed_files",
    "preserved_files",
    "unchanged_springs_inputs",
    "full_repository_suite"
  ],
  "title": "Receipt",
  "type": "object"
}
