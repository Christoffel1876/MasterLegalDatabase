{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "description": "Strict Asset custody contract.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Asset",
      "type": "object"
    },
    "Baseline": {
      "additionalProperties": false,
      "description": "Strict Baseline custody contract.",
      "properties": {
        "repository_path": {
          "title": "Repository Path",
          "type": "string"
        },
        "preserved": {
          "$ref": "#/$defs/Asset"
        },
        "records": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Records"
        }
      },
      "required": [
        "repository_path",
        "preserved",
        "records"
      ],
      "title": "Baseline",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Reported acquisition claims, separately bound to immutable received bytes.",
      "properties": {
        "source_id": {
          "enum": [
            "custer-right-to-ranch-farm-resolution-98-14-shstate03",
            "delta-land-use-adoption-resolution-2021-r-001-shstate03",
            "delta-land-use-code-2024-label-shstate03"
          ],
          "title": "Source Id",
          "type": "string"
        },
        "action_id": {
          "title": "Action Id",
          "type": "string"
        },
        "authority_id": {
          "enum": [
            "CO-COUNTY-CUSTER",
            "CO-COUNTY-DELTA"
          ],
          "title": "Authority Id",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Asset"
        },
        "physical_pages": {
          "minimum": 1,
          "title": "Physical Pages",
          "type": "integer"
        },
        "originally_reported_pages": {
          "minimum": 1,
          "title": "Originally Reported Pages",
          "type": "integer"
        },
        "parent": {
          "$ref": "#/$defs/Asset"
        },
        "parent_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Url"
        },
        "original_href": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Original Href"
        },
        "referral_kind": {
          "enum": [
            "retained_location_claim",
            "retained_html_anchor",
            "packet_seed"
          ],
          "title": "Referral Kind",
          "type": "string"
        },
        "reservation": {
          "$ref": "#/$defs/Asset"
        },
        "result": {
          "$ref": "#/$defs/Asset"
        },
        "requested_url_reported": {
          "title": "Requested Url Reported",
          "type": "string"
        },
        "final_url_reported": {
          "title": "Final Url Reported",
          "type": "string"
        },
        "http_status_reported": {
          "const": 200,
          "title": "Http Status Reported",
          "type": "integer"
        },
        "reported_reserved_at": {
          "format": "date-time",
          "title": "Reported Reserved At",
          "type": "string"
        },
        "reported_finished_at": {
          "format": "date-time",
          "title": "Reported Finished At",
          "type": "string"
        },
        "verified_original_acquired_at": {
          "title": "Verified Original Acquired At",
          "type": "null"
        },
        "original_transport_witnessed_by_this_preparer": {
          "const": false,
          "title": "Original Transport Witnessed By This Preparer",
          "type": "boolean"
        },
        "private_header_contents_included": {
          "const": false,
          "title": "Private Header Contents Included",
          "type": "boolean"
        },
        "historical_digest_lines": {
          "items": {
            "type": "integer"
          },
          "title": "Historical Digest Lines",
          "type": "array"
        },
        "legal_currentness": {
          "const": "not_verified",
          "title": "Legal Currentness",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "source_id",
        "action_id",
        "authority_id",
        "source",
        "physical_pages",
        "originally_reported_pages",
        "parent",
        "parent_url",
        "original_href",
        "referral_kind",
        "reservation",
        "result",
        "requested_url_reported",
        "final_url_reported",
        "http_status_reported",
        "reported_reserved_at",
        "reported_finished_at",
        "verified_original_acquired_at",
        "original_transport_witnessed_by_this_preparer",
        "private_header_contents_included",
        "historical_digest_lines",
        "legal_currentness",
        "limitations"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Template": {
      "additionalProperties": false,
      "description": "Strict Template custody contract.",
      "properties": {
        "record_id": {
          "enum": [
            "custer-right-to-ranch-farm-resolution-98-14-shstate03",
            "delta-land-use-adoption-resolution-2021-r-001-shstate03",
            "delta-land-use-code-2024-label-shstate03"
          ],
          "title": "Record Id",
          "type": "string"
        },
        "authority_id": {
          "enum": [
            "CO-COUNTY-CUSTER",
            "CO-COUNTY-DELTA"
          ],
          "title": "Authority Id",
          "type": "string"
        },
        "layer_id": {
          "const": "08_County_Authorities",
          "title": "Layer Id",
          "type": "string"
        },
        "official_source_name": {
          "title": "Official Source Name",
          "type": "string"
        },
        "official_source_url": {
          "title": "Official Source Url",
          "type": "null"
        },
        "acquisition_method": {
          "const": "received_review_package",
          "title": "Acquisition Method",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Asset"
        },
        "original_filename": {
          "title": "Original Filename",
          "type": "string"
        },
        "custody_note": {
          "title": "Custody Note",
          "type": "string"
        },
        "actual_repository_received_at": {
          "title": "Actual Repository Received At",
          "type": "null"
        },
        "intake_id": {
          "title": "Intake Id",
          "type": "null"
        },
        "archive_path": {
          "title": "Archive Path",
          "type": "null"
        }
      },
      "required": [
        "record_id",
        "authority_id",
        "layer_id",
        "official_source_name",
        "official_source_url",
        "acquisition_method",
        "source",
        "original_filename",
        "custody_note",
        "actual_repository_received_at",
        "intake_id",
        "archive_path"
      ],
      "title": "Template",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Strict Preparation custody contract.",
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "prepared_at": {
      "format": "date-time",
      "title": "Prepared At",
      "type": "string"
    },
    "status": {
      "const": "PREPARED_NOT_APPLIED",
      "title": "Status",
      "type": "string"
    },
    "comparison_commit": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Comparison Commit",
      "type": "string"
    },
    "templates": {
      "items": {
        "$ref": "#/$defs/Template"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Templates",
      "type": "array"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/Provenance"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Provenance",
      "type": "array"
    },
    "baseline": {
      "items": {
        "$ref": "#/$defs/Baseline"
      },
      "title": "Baseline",
      "type": "array"
    },
    "runtime_pins": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Runtime Pins",
      "type": "object"
    },
    "custody_subset": {
      "items": {
        "$ref": "#/$defs/Asset"
      },
      "title": "Custody Subset",
      "type": "array"
    },
    "recommendation": {
      "$ref": "#/$defs/Asset"
    },
    "recommendation_manifest": {
      "$ref": "#/$defs/Asset"
    },
    "legacy_guard": {
      "$ref": "#/$defs/Asset"
    },
    "raw_before": {
      "minimum": 0,
      "title": "Raw Before",
      "type": "integer"
    },
    "ledger_before": {
      "minimum": 0,
      "title": "Ledger Before",
      "type": "integer"
    },
    "raw_after": {
      "minimum": 3,
      "title": "Raw After",
      "type": "integer"
    },
    "ledger_after": {
      "minimum": 3,
      "title": "Ledger After",
      "type": "integer"
    },
    "public_requests": {
      "const": 0,
      "title": "Public Requests",
      "type": "integer"
    },
    "canonical_mutations": {
      "const": 0,
      "title": "Canonical Mutations",
      "type": "integer"
    },
    "legal_currentness": {
      "const": "not_verified",
      "title": "Legal Currentness",
      "type": "string"
    },
    "answer_safe": {
      "const": false,
      "title": "Answer Safe",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "prepared_at",
    "status",
    "comparison_commit",
    "templates",
    "provenance",
    "baseline",
    "runtime_pins",
    "custody_subset",
    "recommendation",
    "recommendation_manifest",
    "legacy_guard",
    "raw_before",
    "ledger_before",
    "raw_after",
    "ledger_after",
    "public_requests",
    "canonical_mutations",
    "legal_currentness",
    "answer_safe"
  ],
  "title": "Preparation",
  "type": "object"
}
