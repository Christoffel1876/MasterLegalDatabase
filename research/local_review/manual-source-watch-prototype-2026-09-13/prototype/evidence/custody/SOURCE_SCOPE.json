        "size_bytes": 655
      },
      "start_byte": 117,
      "end_byte": 137,
      "exact_text": "Effective 07/01/2026",
      "sha256": "8ec819215d49f281e981ebbab73accd0b47a7cb8fd3bfca33375b74446cb1aa0",
