    {
      "source_id": "SD014-02",
      "physical_page": 6,
      "label": "PPRBD collection and deduction context",
      "native_file": {
        "path": "SD014-02/page-0006.txt",
        "sha256": "1d0cfe38ba894e295493f608dc417d4ec195e8f64e4e40fdf409c50440ca6aa7",
        "size_bytes": 3773
      },
      "start_byte": 328,
      "end_byte": 786,
      "exact_text": "Construction Plan Check Fee: This fee will be collected by Pikes Peak Regional Building Department (PPRBD) \nupon plans being submitted through PPRBD\u2019s plan portal.  This fee equates to a limited review, which is \nthe smallest amount that CSFD will charge for review of a construction plan set.  If a full review and \ninspection is required for the project, then the plan check fee will be deducted from the total fee charged \nat time of CSFD plan approval.",
      "sha256": "2b34a7592cc8ef2a4528a810c0246465cbfee5691d910b3749eb7e9470714a08",
      "interpretation_limit": "Complete source paragraph; no fee computation or issuer reattribution."
    },
    {
      "source_id": "SD014-02",
      "physical_page": 7,
      "label": "WUI surcharge context",
      "native_file": {
        "path": "SD014-02/page-0007.txt",
        "sha256": "0568e4faea01968f9cbaed93b0aa9b24bbbc1852781ad710d7129cc5890b7bca",
        "size_bytes": 905
      },
      "start_byte": 372,
      "end_byte": 670,
      "exact_text": "Wildland Urban Interface (WUI) commercial surcharge: A WUI surcharge will be added to all applicable \ncommercial construction projects that are within CSFD\u2019s WUI area.  This fee is in addition to the fee shown \nin this fee schedule based on the occupancy class and square footage of the building.",
      "sha256": "de7d53488a8b1549d0b7938ba1222a030fd2f0bf7c442bb55c3055fb888cdccc",
      "interpretation_limit": "Source condition only; applicability unknown."
    },
    {
      "source_id": "SD014-02",
      "physical_page": 7,
      "label": "Assessment trigger",
      "native_file": {
        "path": "SD014-02/page-0007.txt",
        "sha256": "0568e4faea01968f9cbaed93b0aa9b24bbbc1852781ad710d7129cc5890b7bca",
        "size_bytes": 905
      },
      "start_byte": 676,
      "end_byte": 743,
      "exact_text": "Implementation: Fees shall be assessed upon the plan approval date.",
      "sha256": "18c2ae5e201dd07b232280060f4f6a1ce90292206735bd9e544cafb49b217fb3",
      "interpretation_limit": "No project-specific assessment performed."
    },
    {
      "source_id": "SD014-02",
      "physical_page": 7,
      "label": "Other schedule reference",
      "native_file": {
        "path": "SD014-02/page-0007.txt",
        "sha256": "0568e4faea01968f9cbaed93b0aa9b24bbbc1852781ad710d7129cc5890b7bca",
        "size_bytes": 905
      },
      "start_byte": 747,
      "end_byte": 903,
      "exact_text": "Note Worthy  \nFees associated with high pile storage and hazardous materials are listed in the Colorado Springs Fire \nDepartment Code Services Fee Schedule.",
      "sha256": "76d0d8b81215343a860c0b154a0491761df0b54009fc3cc18d4436de67c93f55",
      "interpretation_limit": "Reference does not identify an edition or establish full replacement of the 2015 source."
    }
