{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "description": "Identify exact local evidence bytes.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Asset",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Inventory the immutable package without self-reference.",
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/Asset"
      },
      "title": "Files",
      "type": "array"
    },
    "excluded": {
      "items": {
        "type": "string"
      },
      "title": "Excluded",
      "type": "array"
    }
  },
  "required": [
    "files",
    "excluded"
  ],
  "title": "Manifest",
  "type": "object"
}
