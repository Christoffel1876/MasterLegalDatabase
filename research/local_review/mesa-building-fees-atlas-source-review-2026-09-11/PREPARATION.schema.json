      "title": "Mode",
      "type": "string"
    },
    "note": {
      "title": "Note",
      "type": "string"
    }
  },
  "required": [
    "source",
    "prepared_at",
    "source_url",
    "acquired_at",
    "custody_files",
    "mode",
    "note"
