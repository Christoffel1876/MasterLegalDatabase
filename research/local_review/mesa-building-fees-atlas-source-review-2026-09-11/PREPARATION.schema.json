    }
  },
  "additionalProperties": false,
  "properties": {
    "source": {
      "$ref": "#/$defs/Asset"
    },
    "prepared_at": {
      "format": "date-time",
      "title": "Prepared At",
      "type": "string"
    },
    "source_url": {
      "title": "Source Url",
      "type": "string"
    },
    "acquired_at": {
      "format": "date-time",
      "title": "Acquired At",
      "type": "string"
    },
