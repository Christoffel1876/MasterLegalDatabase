        "$ref": "#/$defs/DateStatement"
      },
      "title": "Dates",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "substantive_candidate_corrections": {
      "items": {
        "type": "string"
      },
      "title": "Substantive Candidate Corrections",
      "type": "array"
    },
    "table_count": {
      "const": 0,
      "title": "Table Count",
      "type": "integer"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
