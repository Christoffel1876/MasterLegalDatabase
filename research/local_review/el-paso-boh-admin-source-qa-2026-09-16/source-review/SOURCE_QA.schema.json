      "type": "string"
    },
    "method": {
      "title": "Method",
      "type": "string"
    },
    "prior_exposure": {
      "title": "Prior Exposure",
      "type": "string"
    },
    "external_reports_consulted": {
      "const": false,
      "title": "External Reports Consulted",
      "type": "boolean"
    },
    "scope": {
      "title": "Scope",
      "type": "string"
    },
    "normalization": {
      "title": "Normalization",
      "type": "string"
    },
    "candidate": {
      "$ref": "#/$defs/Asset"
    },
    "packet_manifest": {
      "$ref": "#/$defs/Asset"
    },
    "packet_preparation": {
      "$ref": "#/$defs/Asset"
    },
    "inspection": {
      "$ref": "#/$defs/Asset"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/Page"
      },
      "title": "Pages",
      "type": "array"
    },
    "checked_passages": {
