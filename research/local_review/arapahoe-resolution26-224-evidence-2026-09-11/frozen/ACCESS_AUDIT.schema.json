          "title": "Kind",
          "type": "string"
        },
        "parent_event": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Event"
        },
        "observed_link_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Link Label"
        },
        "referral_evidence": {
          "title": "Referral Evidence",
          "type": "string"
