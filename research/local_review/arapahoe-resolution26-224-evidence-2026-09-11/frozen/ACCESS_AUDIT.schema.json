{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Asset",
      "type": "object"
    },
    "DateRole": {
      "additionalProperties": false,
      "properties": {
        "literal": {
          "title": "Literal",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "source_event_or_excerpt": {
          "title": "Source Event Or Excerpt",
          "type": "string"
        },
        "qualification": {
          "title": "Qualification",
          "type": "string"
        }
      },
      "required": [
        "literal",
        "role",
        "source_event_or_excerpt",
        "qualification"
      ],
      "title": "DateRole",
      "type": "object"
    },
