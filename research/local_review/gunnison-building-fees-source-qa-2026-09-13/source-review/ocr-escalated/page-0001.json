{"lines":[{"bbox":[0.32142856687968774,0.91715116299763655,0.3515037626378677,0.014667018543590205],"confidence":1,"text":"BOARD OF COUNTY COMMISSIONERS"},{"bbox":[0.29135338724799131,0.89666666643047477,0.40977443321078433,0.019090909090909158],"confidence":1,"text":"OF THE COUNTY OF GUNNISON, COLORADO"},{"bbox":[0.38345864887496772,0.88212121216185757,0.22744360830269605,0.017588090029629688],"confidence":1,"text":"RESOLUTION NO: 25-24"},{"bbox":[0.15977443757308016,0.85174418635640592,0.66917293772977926,0.014619449846672294],"confidence":1,"text":"A RESOLUTION ESTABLISHING A SCHEDULE OF BUILDING PERMIT FEES"},{"bbox":[0.18609022887224963,0.81540697667479178,0.64097742417279413,0.017441860545765353],"confidence":1,"text":"WHEREAS, pursuant to the International Building Code and the International"},{"bbox":[0.13157895623652424,0.79939393965464423,0.620300723805147,0.017575757575757578],"confidence":1,"text":"Residential Code the Board is authorized to set and amend the Community"},{"bbox":[0.13157896872644606,0.78197674433965814,0.47368417777267169,0.018932346575187831],"confidence":1,"text":"Development Department's fees for building permits; and"},{"bbox":[0.18609022887224963,0.75000000006392731,0.64097742417279413,0.016060606060606109],"confidence":1,"text":"WHEREAS, Community Development staff has provided the Board of County"},{"bbox":[0.13157894497984404,0.73242424259788852,0.70676690793504904,0.016122268907951542],"confidence":1,"text":"Commissioners an analysis of the current fee schedule, Appendix AL, that identified a"},{"bbox":[0.12969923705616315,0.71787878763137392,0.66917293772977937,0.014679351575446864],"confidence":1,"text":"regressive fee percentage per increased project valuation and recommended the"},{"bbox":[0.12969925097831894,0.69909090908515403,0.70488721660539222,0.018932346575187831],"confidence":1,"text":"establishment of a flat percentage of the total project valuation to ensure that building"},{"bbox":[0.12969924090154153,0.6830303032160765,0.65789474188112751,0.017575757575757578],"confidence":1,"text":"permit fees are equitable for all project valuation amounts and cover the cost of"},{"bbox":[0.12969925989529194,0.66715116336945468,0.65225562002144599,0.018909442786014363],"confidence":1,"text":"application review and building inspections and recommended and increase of"},{"bbox":[0.12965153692947368,0.64813337536897964,0.71249602673100498,0.019107575272068744],"confidence":1,"text":"application deposits collected at the time of submittal in memos dated March 14, 2025"},{"bbox":[0.12969923976536019,0.63363636363089682,0.47556391697303918,0.016072938514478219],"confidence":1,"text":"and May 22, 2025, both titled \"Building Permit Fees\"; and"},{"bbox":[0.18609021853312055,0.59878787869410921,0.6578947418811274,0.017575757575757578],"confidence":1,"text":"WHEREAS, Community Development staff experiences an increase in demand"},{"bbox":[0.12777779975066311,0.5823488527670726,0.7275354243259804,0.017965069395123101],"confidence":1,"text":"for review and inspection resources for larger valuation projects that is not recovered by"},{"bbox":[0.12969926089953737,0.56686046506392729,0.41353381587009813,0.015988371877959318],"confidence":1,"text":"use of the Appendix AL Permit Fee schedule; and"},{"bbox":[0.1860246770494047,0.53303266523253734,0.58472440831801464,0.018627511226769644],"confidence":1,"text":"WHEREAS, the Board wishes to establish a schedule of permit fees in"},{"bbox":[0.12969926956044736,0.51744186066349129,0.72180448644301465,0.015988371877959318],"confidence":1,"text":"accordance with the International Building Code and the International Residential Code"},{"bbox":[0.12969925052423098,0.50145348861286143,0.71616541245404397,0.016122268907951653],"confidence":1,"text":"that can be adjusted from time to time to cover the cost of the development review and"},{"bbox":[0.12781955131924469,0.48393939384397433,0.72556391697303924,0.016060606060605997],"confidence":1,"text":"inspection program and that is clear and accessible to the citizens of Gunnison County."},{"bbox":[0.18609021617270441,0.45058139541276465,0.66917293772977948,0.01608527096835044],"confidence":1,"text":"NOW, THEREFORE, BE IT RESOLVED by the Board of County Commissioners"},{"bbox":[0.12969926950545005,0.43303030308110979,0.71052629059436268,0.017575757575757578],"confidence":1,"text":"of Gunnison County, Colorado that the Community Development Department Building"},{"bbox":[0.12969925054997314,0.41715116296839649,0.61278195848651962,0.017441860545765242],"confidence":1,"text":"Permit Fee Schedule is hereby adopted and attached as Exhibit A hereto."},{"bbox":[0.12969927193551423,0.38662790729027219,0.68984959022671555,0.014584214181611044],"confidence":1,"text":"THIS RESOLUTION AND THE APPROVAL GRANTED HEREBY SHALL NOT BE"},{"bbox":[0.13157895635532985,0.36909090886787055,0.71804510378370101,0.01463002118197354],"confidence":1,"text":"EFFECTIVE UNLESS AND UNTIL A COPY IS RECORDED IN THE Office of the Clerk"},{"bbox":[0.13157895035696424,0.35319767484001829,0.28947368547028185,0.013165961756850697],"confidence":1,"text":"and Recorder of Gunnison County."},{"bbox":[0.12593985309608213,0.28333333374455283,0.51127819584865186,0.036434107693758877],"confidence":0.30000001192092896,"text":"PNERon DeDil andadmited on this pucday of uinse"},{"bbox":[0.57706767099832534,0.29939393922200863,0.28383458754595592,0.017575757575757578],"confidence":1,"text":"_ seconded by Commissioner"},{"bbox":[0.65220757449628974,0.28473071745297984,0.084682593252144667,0.016294379378810064],"confidence":1,"text":"- 2025."},{"bbox":[0.12969925407449584,0.23837209307628204,0.35150373870251228,0.015988371877959207],"confidence":1,"text":"BOARD OF COUNTY COMMISSIONERS"},{"bbox":[0.1296992504597029,0.22090909109653201,0.33834585152420349,0.016060606060605997],"confidence":1,"text":"OF GUNNISON COUNTY, COLORADO"},{"bbox":[0.15945307104994699,0.18469919381617428,0.38021043964460788,0.033071087923916886],"confidence":0.