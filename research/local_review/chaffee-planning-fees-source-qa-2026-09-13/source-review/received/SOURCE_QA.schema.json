        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Asset",
      "type": "object"
    },
    "Graphic": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "enum": [
            1,
            2
          ],
          "title": "Page",
          "type": "integer"
        },
        "observation": {
          "title": "Observation",
          "type": "string"
        },
        "identity_or_authenticity_verified": {
          "const": false,
          "title": "Identity Or Authenticity Verified",
          "type": "boolean"
        }
      },
      "required": [
        "page",
        "observation",
        "identity_or_authenticity_verified"
      ],
      "title": "Graphic",
      "type": "object"
    },
    "Group": {
