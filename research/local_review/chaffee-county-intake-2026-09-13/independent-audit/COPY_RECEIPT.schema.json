{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Asset",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "captured_at": {
      "format": "date-time",
      "title": "Captured At",
      "type": "string"
    },
    "original_path": {
      "title": "Original Path",
      "type": "string"
    },
    "original_manifest_sha256": {
      "title": "Original Manifest Sha256",
      "type": "string"
    },
    "scope": {
      "title": "Scope",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/Asset"
      },
      "title": "Files",
      "type": "array"
    }
  },
  "required": [
    "captured_at",
    "original_path",
    "original_manifest_sha256",
    "scope",
    "files"
  ],
  "title": "Copy",
  "type": "object"
}
