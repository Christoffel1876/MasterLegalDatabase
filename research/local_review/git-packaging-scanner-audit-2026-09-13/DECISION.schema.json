{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Asset",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "recorded_at": {
      "title": "Recorded At",
      "type": "string"
    },
    "reviewer": {
      "const": "Atlas",
      "title": "Reviewer",
      "type": "string"
    },
    "status": {
      "const": "accepted_bounded_scanner_revision_pending_final_use",
      "title": "Status",
      "type": "string"
    },
    "frozen_audit": {
      "$ref": "#/$defs/Asset"
    },
    "proposed_scanner": {
      "$ref": "#/$defs/Asset"
    },
    "checks": {
      "items": {
        "type": "string"
      },
      "title": "Checks",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "legal_currentness": {
      "const": "not_verified",
      "title": "Legal Currentness",
      "type": "string"
    }
  },
  "required": [
    "recorded_at",
    "reviewer",
    "status",
    "frozen_audit",
    "proposed_scanner",
    "checks",
    "limitations",
    "legal_currentness"
  ],
  "title": "Decision",
  "type": "object"
}
