<option value="86">TEFRA Hearing</option>
<option value="67">The Resource Exchange Annual Legislative Town Hall</option>
<option value="61">Victim Assistance and Law Enforcement Board </option>
<option value="64">Victim Compensation</option>
</select>
                </div>
            </div>
            <div class="row">
                <div class="col-xl-3 col-md-3 col-sm-12">
                        <p>
                            <input type="checkbox" data-val="true" data-val-required="The InNotification field is required." id="SearchFilters_InNotification" name="SearchFilters.InNotification" value="true" />
                            <label for="SearchFilters_InNotification">Agenda</label>
                        </p>
                        <p id="searchai">
                            <input type="checkbox" data-val="true" data-val-required="The InProposal field is required." id="SearchFilters_InProposal" name="SearchFilters.InProposal" value="true" />
                            <label for="SearchFilters_InProposal">Agenda items</label>
                        </p>
                        <p>
                            <input type="checkbox" data-val="true" data-val-required="The InAgenda field is required." id="SearchFilters_InAgenda" name="SearchFilters.InAgenda" value="true" />
                            <label for="SearchFilters_InAgenda">Agenda (Committee)</label>
                        </p>
                        <p>
                            <input type="checkbox" data-val="true" data-val-required="The InMinutes field is required." id="SearchFilters_InMinutes" name="SearchFilters.InMinutes" value="true" />
                            <label for="SearchFilters_InMinutes">Minutes</label>
                        </p>
                </div>
                <div class="col-xl-3 col-md-5 col-sm-12">
                        <p>
                            <input type="checkbox" data-val="true" data-val-required="The InAttachmentMeeting field is required." id="SearchFilters_InAttachmentMeeting" name="SearchFilters.InAttachmentMeeting" value="true" />
                            <label for="SearchFilters_InAttachmentMeeting">Attachments (Meeting)</label>
                        </p>
                        <p id="searchai">
                            <input type="checkbox" data-val="true" data-val-required="The InAttachmentProposal field is required." id="SearchFilters_InAttachmentProposal" name="SearchFilters.InAttachmentProposal" value="true" />
                            <label for="SearchFilters_InAttachmentProposal">Attachments (Agenda Items)</label>
                        </p>
                        <p>
                            <input type="checkbox" data-val="true" data-val-required="The InOrdinances field is required." id="SearchFilters_InOrdinances" name="SearchFilters.InOrdinances" value="true" />
                            <label for="SearchFilters_InOrdinances">Resolutions</label>
                        </p>
                </div>
            </div>
                <div class="row">
                    <div class="col-lg-3">
                        <input type="checkbox" data-val="true" data-val-required="The InArchive field is required." id="SearchFilters_InArchive" name="SearchFilters.InArchive" value="true" />
                        <label for="SearchFilters_InArchive">Archive</label>
                    </div>
                </div>
            <p style="margin-top:5px;">
                <label for="SearchFilters_FromDateStr">Search from</label>
                <input type="text" class="datepicker" autocomplete="off" value="09/17/2025" id="SearchFilters_FromDateStr" name="SearchFilters.FromDateStr">
                <label for="SearchFilters_ToDateStr">up to</label>
                <input type="text" class="datepicker" autocomplete="off" value="09/17/2026" id="SearchFilters_ToDateStr" name="SearchFilters.ToDateStr">
            </p>
            <label for="searchbutton">Apply filters</label>
            <input id="searchbutton" name="searchbutton" type="submit" class="btn loginbuttons" value="Start search" />
        <input name="__RequestVerificationToken" type="hidden" value="CfDJ8KCvlOdv38NLmvtea-Besla0b7gIbHfAaJti5geZweKHozCA3vMEt4XQ1xcY0A1eLUK66b_urHX6650Lb4gSZZiGZwuSx7ak1sv81iU9fIxKcizQKQaduud5oI8UGM46hnjhpBrZ4mVHBo2s2jZJHvg" /><input name="SearchFilters.InNotification" type="hidden" value="false" /><input name="SearchFilters.InProposal" type="hidden" value="false" /><input name="SearchFilters.InAgenda" type="hidden" value="false" /><input name="SearchFilters.InMinutes" type="hidden" value="false" /><input name="SearchFilters.InAttachmentMeeting" type="hidden" value="false" /><input name="SearchFilters.InAttachmentProposal" type="hidden" value="false" /><input name="SearchFilters.InOrdinances" type="hidden" value="false" /><input name="SearchFilters.InArchive" type="hidden" value="false" /></form>
    </div>
</div>
