    <script src="/iip/lib/bootstrap-datepicker-1.6.4-dist/js/bootstrap-datepicker.min.js"></script>
    <script>
    $('.datepicker').datepicker({
        maxViewMode: 2,
        todayBtn: "linked",
        language: 'en',
        format: 'mm/dd/yyyy',
        weekStart: 0,
        orientation: "bottom auto"
    });
    </script>

