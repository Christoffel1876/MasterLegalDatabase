    "Finding": {
      "additionalProperties": false,
      "description": "An accepted observation or explicit qualification, never legal promotion.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "accepted_local_evidence",
            "qualified",
            "unverified_claim"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "finding": {
          "title": "Finding",
          "type": "string"
        },
        "evidence_paths": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Paths",
          "type": "array"
        }
      },
      "required": [
        "id",
        "disposition",
        "finding",
        "evidence_paths"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "description": "One local immutable byte identity.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Ref",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Initial offline intake disposition with original acquisition explicitly unverified.",
  "properties": {
    "schema_version": {
      "const": "geode.sh004.offline-audit.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "prepared_at": {
      "format": "date-time",
      "title": "Prepared At",
      "type": "string"
    },
    "status": {
      "const": "offline_audit_complete_with_qualifications",
      "title": "Status",
      "type": "string"
    },
    "assignment_manifest_sha256": {
      "const": "4485cb16ddbf4dbd0e1b7b7b505961d3d7e67d6fb59bae4194763e4117536c04",
      "title": "Assignment Manifest Sha256",
      "type": "string"
    },
    "custody": {
      "$ref": "#/$defs/Ref"
    },
    "report": {
      "$ref": "#/$defs/Ref"
    },
    "facts": {
      "$ref": "#/$defs/Facts"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "source_qa_performed": {
      "const": false,
      "title": "Source Qa Performed",
      "type": "boolean"
    },
    "public_requests_by_auditor": {
      "const": 0,
      "title": "Public Requests By Auditor",
      "type": "integer"
    },
    "canonical_writes": {
      "const": 0,
      "title": "Canonical Writes",
      "type": "integer"
    },
    "agent_current_state_verified": {
      "const": false,
      "title": "Agent Current State Verified",
      "type": "boolean"
    },
    "legal_currentness": {
      "const": "not_verified",
      "title": "Legal Currentness",
      "type": "string"
    },
    "answer_safe": {
      "const": false,
      "title": "Answer Safe",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "prepared_at",
    "status",
    "assignment_manifest_sha256",
    "custody",
    "report",
    "facts",
    "findings",
    "source_qa_performed",
    "public_requests_by_auditor",
    "canonical_writes",
    "agent_current_state_verified",
    "legal_currentness",
    "answer_safe"
  ],
  "title": "Audit",
  "type": "object"
}
