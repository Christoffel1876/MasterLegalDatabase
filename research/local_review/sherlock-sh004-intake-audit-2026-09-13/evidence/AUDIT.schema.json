{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "description": "Reported public action versus actually retained bytes.",
      "properties": {
        "action_id": {
          "title": "Action Id",
          "type": "string"
        },
        "authority_id": {
          "const": "CO-COUNTY-CHAFFEE",
          "title": "Authority Id",
          "type": "string"
        },
        "requested_url": {
          "title": "Requested Url",
          "type": "string"
        },
        "reported_final_url": {
          "title": "Reported Final Url",
          "type": "string"
        },
        "reported_status": {
          "title": "Reported Status",
          "type": "integer"
        },
        "reservation_time_claim": {
          "format": "date-time",
          "title": "Reservation Time Claim",
          "type": "string"
        },
        "finished_time_claim": {
          "format": "date-time",
          "title": "Finished Time Claim",
          "type": "string"
        },
        "reported_header_date": {
          "title": "Reported Header Date",
          "type": "string"
        },
        "body": {
          "$ref": "#/$defs/Ref"
        },
        "observed_body_kind": {
          "enum": [
            "fee_catalog_html",
            "redirect_notice_html"
          ],
          "title": "Observed Body Kind",
          "type": "string"
        },
        "pdf_magic_present": {
          "const": false,
          "title": "Pdf Magic Present",
          "type": "boolean"
        },
        "received_header_metadata": {
          "$ref": "#/$defs/Ref"
        },
        "recorded_command": {
          "$ref": "#/$defs/Ref"
        },
        "unopened_location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unopened Location"
        },
        "original_http_witnessed": {
          "const": false,
          "title": "Original Http Witnessed",
          "type": "boolean"
        }
      },
      "required": [
        "action_id",
        "authority_id",
        "requested_url",
        "reported_final_url",
        "reported_status",
        "reservation_time_claim",
        "finished_time_claim",
        "reported_header_date",
        "body",
        "observed_body_kind",
        "pdf_magic_present",
        "received_header_metadata",
        "recorded_command",
        "unopened_location",
        "original_http_witnessed"
      ],
      "title": "Action",
      "type": "object"
    },
    "Facts": {
      "additionalProperties": false,
