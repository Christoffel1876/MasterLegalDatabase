{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Asset",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "prepared_at": {
      "title": "Prepared At",
      "type": "string"
    },
    "status": {
      "title": "Status",
      "type": "string"
    },
    "local_tests": {
      "title": "Local Tests",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/Asset"
      },
      "title": "Files",
      "type": "array"
    },
    "exclusions": {
      "items": {
        "type": "string"
      },
      "title": "Exclusions",
      "type": "array"
    },
    "public_actions": {
      "title": "Public Actions",
      "type": "integer"
    }
  },
  "required": [
    "prepared_at",
    "status",
    "local_tests",
    "files",
    "exclusions",
    "public_actions"
  ],
  "title": "Manifest",
  "type": "object"
}
