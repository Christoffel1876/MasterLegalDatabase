{
  "$defs": {
    "Ref": {
      "additionalProperties": false,
      "description": "Immutable confined local evidence identity.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Ref",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Closed files; runtime inventory includes every event even after failure.",
  "properties": {
    "kind": {
      "const": "run",
      "title": "Kind",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "title": "Files",
      "type": "array"
    }
  },
  "required": [
    "kind",
    "files"
  ],
  "title": "FileInventory",
  "type": "object"
}
