{
  "$defs": {
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Ref",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "status": {
      "const": "PREPARED_NOT_STAGED_NOT_EXECUTED",
      "title": "Status",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "title": "Files",
      "type": "array"
    },
    "public_requests": {
      "const": 0,
      "default": 0,
      "title": "Public Requests",
      "type": "integer"
    },
    "archive_executions": {
      "const": 0,
      "default": 0,
      "title": "Archive Executions",
      "type": "integer"
    },
    "canonical_mutations": {
      "const": 0,
      "default": 0,
      "title": "Canonical Mutations",
      "type": "integer"
    }
  },
  "required": [
    "status",
    "files"
  ],
  "title": "Manifest",
  "type": "object"
}
