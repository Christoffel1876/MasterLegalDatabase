{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "description": "Bind a relative file to its exact bytes.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Asset",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Every distributed file except the inventory and its schema.",
  "properties": {
    "files": {
      "items": {
        "$ref": "#/$defs/Asset"
      },
      "title": "Files",
      "type": "array"
    },
    "excludes": {
      "const": "MANIFEST.json;MANIFEST.schema.json",
      "default": "MANIFEST.json;MANIFEST.schema.json",
      "title": "Excludes",
      "type": "string"
    }
  },
  "required": [
    "files"
  ],
  "title": "Manifest",
  "type": "object"
}
