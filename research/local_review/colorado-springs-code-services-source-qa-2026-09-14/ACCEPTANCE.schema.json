{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "description": "Exact file identity relative to its stated package root.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Asset",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Atlas's separately recorded, source-scoped acceptance.",
  "properties": {
    "reviewer": {
      "const": "Atlas",
      "title": "Reviewer",
      "type": "string"
    },
    "recorded_by": {
      "const": "Plato",
      "title": "Recorded By",
      "type": "string"
    },
    "recorded_at": {
      "title": "Recorded At",
      "type": "string"
    },
    "disposition": {
      "const": "accepted_source_fidelity_for_metadata_only_review_join",
      "title": "Disposition",
      "type": "string"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "source_sha256": {
      "title": "Source Sha256",
      "type": "string"
    },
    "authority_id": {
      "title": "Authority Id",
      "type": "string"
    },
    "source_review": {
      "$ref": "#/$defs/Asset"
    },
    "source_review_schema": {
      "$ref": "#/$defs/Asset"
    },
    "frozen_manifest": {
      "$ref": "#/$defs/Asset"
    },
    "root_direct_image_notes": {
      "$ref": "#/$defs/Asset"
    },
    "root_full_pages_directly_viewed": {
      "items": {
        "type": "integer"
      },
      "title": "Root Full Pages Directly Viewed",
      "type": "array"
    },
    "root_check_scope": {
      "title": "Root Check Scope",
      "type": "string"
    },
    "original_review_status_preserved": {
      "title": "Original Review Status Preserved",
      "type": "boolean"
    },
    "external_ebenezer_report_consulted_before_acceptance": {
      "const": false,
      "title": "External Ebenezer Report Consulted Before Acceptance",
      "type": "boolean"
    },
    "legal_currentness": {
      "const": "not_verified",
      "title": "Legal Currentness",
      "type": "string"
    },
    "answer_safe": {
      "const": false,
      "title": "Answer Safe",
      "type": "boolean"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "reviewer",
    "recorded_by",
    "recorded_at",
    "disposition",
    "source_id",
    "source_sha256",
    "authority_id",
    "source_review",
    "source_review_schema",
    "frozen_manifest",
    "root_direct_image_notes",
    "root_full_pages_directly_viewed",
    "root_check_scope",
    "original_review_status_preserved",
    "external_ebenezer_report_consulted_before_acceptance",
    "legal_currentness",
    "answer_safe",
    "limitations"
  ],
  "title": "Acceptance",
  "type": "object"
}
