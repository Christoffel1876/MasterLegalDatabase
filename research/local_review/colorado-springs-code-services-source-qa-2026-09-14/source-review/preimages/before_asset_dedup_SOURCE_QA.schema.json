{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "description": "A byte-bound external packet asset or local audit payload.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Asset",
      "type": "object"
    },
    "Crop": {
      "additionalProperties": false,
      "description": "Exact pixel slice of an unchanged full source image.",
      "properties": {
        "asset": {
          "$ref": "#/$defs/Asset"
        },
        "page": {
          "title": "Page",
          "type": "integer"
        },
        "pixel_box": {
          "items": {
            "type": "integer"
          },
          "title": "Pixel Box",
          "type": "array"
        },
        "inspected_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Inspected At"
        }
      },
      "required": [
        "asset",
        "page",
        "pixel_box",
        "inspected_at"
      ],
      "title": "Crop",
      "type": "object"
    },
    "Line": {
