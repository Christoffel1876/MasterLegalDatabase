          "title": "Image Path",
          "type": "string"
        },
        "expected_sha256": {
          "title": "Expected Sha256",
          "type": "string"
        },
        "reproduced_sha256": {
          "title": "Reproduced Sha256",
          "type": "string"
        },
        "size_bytes": {
          "title": "Size Bytes",
          "type": "integer"
        },
