{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "description": "Reference an exact repository artifact, not an unpreserved observation.",
      "properties": {
        "path": {
          "pattern": "^(research/|_RAW_ARCHIVE/)[^\\\\]+$",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "Band": {
      "additionalProperties": false,
      "description": "Preserve a printed rate and its printed basis without calculating a fee.",
      "properties": {
        "basis": {
          "title": "Basis",
          "type": "string"
        },
        "amount": {
          "title": "Amount",
          "type": "string"
        }
      },
      "required": [
        "basis",
        "amount"
      ],
      "title": "Band",
      "type": "object"
    },
    "Block": {
      "additionalProperties": false,
      "description": "Preserve table context, labels, footnotes and policy boxes verbatim in wording.",
      "properties": {
        "block_id": {
          "title": "Block Id",
          "type": "string"
        },
        "physical_pages": {
          "items": {
            "enum": [
              1,
              2
            ],
            "type": "integer"
          },
          "minItems": 1,
          "title": "Physical Pages",
          "type": "array"
        },
        "location": {
          "title": "Location",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "annotation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Annotation"
        }
      },
      "required": [
        "block_id",
        "physical_pages",
        "location",
        "text"
      ],
      "title": "Block",
      "type": "object"
    },
    "PageEvidence": {
      "additionalProperties": false,
      "description": "Bind each reviewed physical page to its untouched rendered image.",
      "properties": {
        "physical_page": {
          "enum": [
            1,
            2
          ],
          "title": "Physical Page",
          "type": "integer"
        },
        "image": {
          "$ref": "#/$defs/Artifact"
        },
        "width_pixels": {
          "const": 2550,
          "default": 2550,
          "title": "Width Pixels",
          "type": "integer"
        },
        "height_pixels": {
          "const": 3300,
          "default": 3300,
          "title": "Height Pixels",
          "type": "integer"
        },
        "native_text_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Native Text Sha256",
          "type": "string"
        }
      },
      "required": [
        "physical_page",
        "image",
        "native_text_sha256"
      ],
      "title": "PageEvidence",
      "type": "object"
    },
    "Row": {
      "additionalProperties": false,
      "description": "One visual table row; this is not an atomic legal rule or fee calculator.",
      "properties": {
        "row_id": {
          "pattern": "^EB006-P[12]-R\\d{2}$",
          "title": "Row Id",
          "type": "string"
        },
        "physical_page": {
          "enum": [
            1,
            2
          ],
          "title": "Physical Page",
          "type": "integer"
        },
        "order_on_page": {
          "minimum": 1,
          "title": "Order On Page",
          "type": "integer"
        },
        "section": {
          "enum": [
            "administrative_cases",
            "major_cases"
          ],
          "title": "Section",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "details": {
          "items": {
            "type": "string"
          },
          "title": "Details",
          "type": "array"
        },
        "setup_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Setup Note"
        },
        "bands": {
          "items": {
            "$ref": "#/$defs/Band"
          },
          "title": "Bands",
          "type": "array"
        },
        "fee_terms": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fee Terms"
        },
        "visual_notes": {
          "items": {
            "type": "string"
          },
          "title": "Visual Notes",
          "type": "array"
        }
      },
      "required": [
        "row_id",
        "physical_page",
        "order_on_page",
        "section",
        "label"
      ],
      "title": "Row",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A complete fee-row transcription with explicit source and legal-review limits.",
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "review_id": {
      "const": "EB-PDF-006-ATLAS-TABLE",
      "default": "EB-PDF-006-ATLAS-TABLE",
      "title": "Review Id",
      "type": "string"
    },
    "source_id": {
      "const": "arapahoe-planning-fees-sd002-14",
      "title": "Source Id",
      "type": "string"
    },
    "authority_id": {
      "const": "CO-COUNTY-ARAPAHOE",
      "default": "CO-COUNTY-ARAPAHOE",
      "title": "Authority Id",
      "type": "string"
    },
    "title": {
      "const": "Planning Review Fee Schedule",
      "default": "Planning Review Fee Schedule",
      "title": "Title",
      "type": "string"
    },
    "prepared_at": {
      "format": "date-time",
      "title": "Prepared At",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Artifact"
    },
    "official_url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Official Url",
      "type": "string"
    },
    "retrieved_at": {
      "format": "date-time",
      "title": "Retrieved At",
      "type": "string"
    },
    "manual_intake": {
      "$ref": "#/$defs/Artifact"
    },
    "source_intake_status": {
      "const": "archived_pending_pipeline",
      "default": "archived_pending_pipeline",
      "title": "Source Intake Status",
      "type": "string"
    },
    "candidate": {
      "$ref": "#/$defs/Artifact"
    },
    "packet_manifest": {
      "$ref": "#/$defs/Artifact"
    },
    "http_receipt": {
      "$ref": "#/$defs/Artifact"
    },
    "review_reports": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "title": "Review Reports",
      "type": "array"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/PageEvidence"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Pages",
      "type": "array"
    },
    "extraction_method": {
      "const": "PyMuPDF Page.get_text(\"text\", sort=False); native, not OCR",
      "title": "Extraction Method",
      "type": "string"
    },
    "rendering_method": {
      "const": "Poppler 26.05.0 pdftoppm -r 300 -png; no postprocessing",
      "title": "Rendering Method",
      "type": "string"
    },
    "transcription_convention": {
      "title": "Transcription Convention",
      "type": "string"
    },
    "visual_review_method": {
      "title": "Visual Review Method",
      "type": "string"
    },
    "scope": {
      "const": "all_36_fee_rows_and_context_on_two_supplied_pages",
      "title": "Scope",
      "type": "string"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/Row"
      },
      "maxItems": 36,
      "minItems": 36,
      "title": "Rows",
      "type": "array"
    },
    "context": {
      "items": {
        "$ref": "#/$defs/Block"
      },
      "title": "Context",
      "type": "array"
    },
    "observed_revision": {
      "const": "2026-09-08",
      "default": "2026-09-08",
      "title": "Observed Revision",
      "type": "string"
    },
    "referenced_revision_resolution": {
      "const": "26-224",
      "default": "26-224",
      "title": "Referenced Revision Resolution",
      "type": "string"
    },
    "revision_resolution_adoption_date": {
      "default": null,
      "title": "Revision Resolution Adoption Date",
      "type": "null"
    },
    "revision_resolution_effective_date": {
      "default": null,
      "title": "Revision Resolution Effective Date",
      "type": "null"
    },
    "legal_currentness": {
      "const": "not_verified",
      "default": "not_verified",
      "title": "Legal Currentness",
      "type": "string"
    },
    "legal_review": {
      "const": "pending",
      "default": "pending",
      "title": "Legal Review",
      "type": "string"
    },
    "remaining_questions": {
      "items": {
        "type": "string"
      },
      "title": "Remaining Questions",
      "type": "array"
    }
  },
  "required": [
    "source_id",
    "prepared_at",
    "source",
    "official_url",
    "retrieved_at",
    "manual_intake",
    "candidate",
    "packet_manifest",
    "http_receipt",
    "review_reports",
    "pages",
    "extraction_method",
    "rendering_method",
    "transcription_convention",
    "visual_review_method",
    "scope",
    "rows",
    "context",
    "remaining_questions"
  ],
  "title": "TableReview",
  "type": "object"
}
