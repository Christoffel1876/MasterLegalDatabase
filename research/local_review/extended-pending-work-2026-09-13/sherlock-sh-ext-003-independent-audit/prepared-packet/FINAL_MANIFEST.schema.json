{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "description": "Bind an exact prepared payload.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Asset",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The immutable preparation, distinct from any future delivery or dispatch.",
  "properties": {
    "assignment_id": {
      "const": "SH-EXT-003",
      "title": "Assignment Id",
      "type": "string"
    },
    "status": {
      "const": "PREPARED_NOT_DISPATCHED",
      "title": "Status",
      "type": "string"
    },
    "frozen_at": {
      "format": "date-time",
      "title": "Frozen At",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/Asset"
      },
      "title": "Files",
      "type": "array"
    },
    "public_actions_by_preparation": {
      "const": 0,
      "title": "Public Actions By Preparation",
      "type": "integer"
    },
    "hidden_network_requests_measured": {
      "const": false,
      "title": "Hidden Network Requests Measured",
      "type": "boolean"
    },
    "legal_currentness": {
      "const": "not_verified",
      "title": "Legal Currentness",
      "type": "string"
    }
  },
  "required": [
    "assignment_id",
    "status",
    "frozen_at",
    "files",
    "public_actions_by_preparation",
    "hidden_network_requests_measured",
    "legal_currentness"
  ],
  "title": "Manifest",
  "type": "object"
}
