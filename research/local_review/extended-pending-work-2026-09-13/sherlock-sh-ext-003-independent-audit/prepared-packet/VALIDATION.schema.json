      "title": "Status",
      "type": "string"
    },
    "verified_at": {
      "title": "Verified At",
      "type": "string"
    },
    "tests_passed": {
      "title": "Tests Passed",
      "type": "integer"
    },
    "combined_branch_coverage": {
      "title": "Combined Branch Coverage",
      "type": "number"
    },
    "test_command": {
      "title": "Test Command",
      "type": "string"
    },
    "public_actions": {
      "const": 0,
      "title": "Public Actions",
      "type": "integer"
    },
    "production_edits": {
      "const": 0,
      "title": "Production Edits",
      "type": "integer"
    },
    "limits": {
      "items": {
        "type": "string"
      },
      "title": "Limits",
      "type": "array"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/Asset"
      },
      "title": "Files",
      "type": "array"
    }
