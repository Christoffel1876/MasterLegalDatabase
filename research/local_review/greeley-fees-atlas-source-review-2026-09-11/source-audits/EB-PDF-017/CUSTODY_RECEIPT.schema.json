      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/Copy"
      },
      "title": "Files",
      "type": "array"
    },
    "originals_unchanged": {
      "title": "Originals Unchanged",
      "type": "boolean"
    }
