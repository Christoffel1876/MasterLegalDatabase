{
  "$defs": {
    "Page": {
      "additionalProperties": false,
      "description": "A complete physical source image, with no transcription hints.",
      "properties": {
        "physical_page": {
          "maximum": 6,
          "minimum": 1,
          "title": "Physical Page",
          "type": "integer"
        },
        "image": {
          "$ref": "#/$defs/Ref"
        },
        "width": {
          "const": 2550,
          "default": 2550,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "const": 3300,
          "default": 3300,
          "title": "Height",
          "type": "integer"
        }
      },
      "required": [
        "physical_page",
        "image"
      ],
      "title": "Page",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "description": "Exact packet-relative ordinary-file bytes.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Ref",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Local rendering event, not an HTTP acquisition or source review.",
  "properties": {
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "renderer_path": {
      "title": "Renderer Path",
      "type": "string"
    },
    "renderer_sha256": {
      "title": "Renderer Sha256",
      "type": "string"
    },
    "renderer_version": {
      "title": "Renderer Version",
      "type": "string"
    },
    "command_as_executed": {
      "items": {
        "type": "string"
      },
      "title": "Command As Executed",
      "type": "array"
    },
    "returncode": {
      "const": 0,
      "title": "Returncode",
      "type": "integer"
    },
    "stderr": {
      "$ref": "#/$defs/Ref"
    },
    "stdout": {
      "$ref": "#/$defs/Ref"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/Page"
      },
      "maxItems": 6,
      "minItems": 6,
      "title": "Pages",
      "type": "array"
    }
  },
  "required": [
    "source_id",
    "started_at",
    "finished_at",
    "renderer_path",
    "renderer_sha256",
    "renderer_version",
    "command_as_executed",
    "returncode",
    "stderr",
    "stdout",
    "pages"
  ],
  "title": "Render",
  "type": "object"
}
