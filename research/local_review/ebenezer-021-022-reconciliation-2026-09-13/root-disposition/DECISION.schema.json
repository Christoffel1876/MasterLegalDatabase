{
  "$defs": {
    "Finding": {
      "additionalProperties": false,
      "description": "Retain a finding's exact ID and the root's limited disposition.",
      "properties": {
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "title": "Finding Ids",
          "type": "array"
        },
        "disposition": {
          "title": "Disposition",
          "type": "string"
        },
        "basis": {
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "finding_ids",
        "disposition",
        "basis"
      ],
      "title": "Finding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Supplemental assisted evidence does not add another source-review count.",
  "properties": {
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "status": {
      "const": "accepted_as_assisted_comparison_with_explicit_method_limits",
      "title": "Status",
      "type": "string"
    },
    "source_packet_manifest_sha256": {
      "title": "Source Packet Manifest Sha256",
      "type": "string"
    },
    "packet_payloads_checked": {
      "title": "Packet Payloads Checked",
      "type": "integer"
    },
    "current_worker_source_candidate_copies_checked": {
      "title": "Current Worker Source Candidate Copies Checked",
      "type": "integer"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "root_source_qa_independent_of_these_reports": {
      "const": true,
      "default": true,
      "title": "Root Source Qa Independent Of These Reports",
      "type": "boolean"
    },
    "complete_postrelease_page_reinspection_by_worker": {
      "const": false,
      "default": false,
      "title": "Complete Postrelease Page Reinspection By Worker",
      "type": "boolean"
    },
    "historical_blindness_certified": {
      "const": false,
      "default": false,
      "title": "Historical Blindness Certified",
      "type": "boolean"
    },
    "canonical_source_edits": {
      "const": 0,
      "default": 0,
      "title": "Canonical Source Edits",
      "type": "integer"
    },
    "added_inventory_review_count": {
      "const": 0,
      "default": 0,
      "title": "Added Inventory Review Count",
      "type": "integer"
    },
    "legal_currentness": {
      "const": "not_verified",
      "default": "not_verified",
      "title": "Legal Currentness",
      "type": "string"
    }
  },
  "required": [
    "recorded_at",
    "status",
    "source_packet_manifest_sha256",
    "packet_payloads_checked",
    "current_worker_source_candidate_copies_checked",
    "findings",
    "limitations"
  ],
  "title": "Decision",
  "type": "object"
}
