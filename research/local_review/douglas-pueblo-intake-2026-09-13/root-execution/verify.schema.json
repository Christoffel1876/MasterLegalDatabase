{
  "$defs": {
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Ref",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "argv": {
      "items": {
        "type": "string"
      },
      "title": "Argv",
      "type": "array"
    },
    "returncode": {
      "title": "Returncode",
      "type": "integer"
    },
    "stdout": {
      "$ref": "#/$defs/Ref"
    },
    "stderr": {
      "$ref": "#/$defs/Ref"
    }
  },
  "required": [
    "started_at",
    "finished_at",
    "argv",
    "returncode",
    "stdout",
    "stderr"
  ],
  "title": "Invocation",
  "type": "object"
}
