{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "description": "Exact ordinary relative file identity.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Asset",
      "type": "object"
    },
    "Check": {
      "additionalProperties": false,
      "description": "Actual focused offline check and its unchanged captured output.",
      "properties": {
        "command": {
          "title": "Command",
          "type": "string"
        },
        "exit_code": {
          "const": 0,
          "title": "Exit Code",
          "type": "integer"
        },
        "result": {
          "title": "Result",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Asset"
        }
      },
      "required": [
        "command",
        "exit_code",
        "result",
        "evidence"
      ],
      "title": "Check",
      "type": "object"
    },
    "Comparison": {
      "additionalProperties": false,
      "description": "Exact metadata-only comparison against a whole streamed current JSONL file.",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/Asset"
        },
        "rows": {
          "minimum": 0,
          "title": "Rows",
          "type": "integer"
        },
        "source_id_matches": {
          "items": {
            "type": "integer"
          },
          "title": "Source Id Matches",
          "type": "array"
        },
        "source_sha_matches": {
          "items": {
            "type": "integer"
          },
          "title": "Source Sha Matches",
          "type": "array"
        },
        "exact_source_url_matches": {
          "items": {
            "type": "integer"
          },
          "title": "Exact Source Url Matches",
          "type": "array"
        },
        "meaning": {
          "const": "metadata_equality_only_not_currentness_or_retrieval_proof",
          "title": "Meaning",
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "rows",
        "source_id_matches",
        "source_sha_matches",
        "exact_source_url_matches",
        "meaning"
      ],
      "title": "Comparison",
      "type": "object"
