        },
        "table_cell_count": {
          "title": "Table Cell Count",
          "type": "integer"
        },
        "list_item_fragment_count": {
          "title": "List Item Fragment Count",
          "type": "integer"
        },
        "anchor_count": {
          "title": "Anchor Count",
          "type": "integer"
        }
      },
      "required": [
        "selected_element_count",
        "text_fragment_count",
        "nonblank_text_fragment_count",
        "assigned_nonblank_text_fragment_count",
        "unassigned_whitespace_fragment_ids",
        "duplicated_fragment_ids",
        "unassigned_nonblank_fragment_ids",
        "block_count",
        "table_count",
        "table_row_count_including_headers",
        "table_cell_count",
        "list_item_fragment_count",
        "anchor_count"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "DateMention": {
      "additionalProperties": false,
      "description": "Printed date phrase only; event type and applicability stay unclassified.",
