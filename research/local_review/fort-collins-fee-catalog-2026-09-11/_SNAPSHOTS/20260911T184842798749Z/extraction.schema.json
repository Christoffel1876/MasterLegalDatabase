          "items": {
            "$ref": "#/$defs/Attribute"
          },
          "title": "Attributes",
          "type": "array"
        },
        "source": {
          "$ref": "#/$defs/ByteRange"
        },
        "start_tag": {
          "$ref": "#/$defs/ByteRange"
        },
        "end_tag": {
          "anyOf": [
            {
              "$ref": "#/$defs/ByteRange"
