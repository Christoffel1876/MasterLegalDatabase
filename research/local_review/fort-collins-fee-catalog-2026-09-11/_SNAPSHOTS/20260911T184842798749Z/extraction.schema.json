      "type": "object"
    },
    "FileIdentity": {
      "additionalProperties": false,
      "description": "Exact file bytes, with a package-relative path.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "FileIdentity",
      "type": "object"
    },
    "Fragment": {
      "additionalProperties": false,
      "description": "One source text/entity token or explicitly projected br line break.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "element_locator": {
          "title": "Element Locator",
          "type": "string"
        },
        "kind": {
          "enum": [
            "text",
            "entity",
            "character_reference",
            "br_break"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ByteRange"
        },
        "dom_text": {
          "title": "Dom Text",
          "type": "string"
        },
        "dom_text_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Dom Text Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "element_locator",
        "kind",
        "source",
        "dom_text",
        "dom_text_sha256"
      ],
      "title": "Fragment",
      "type": "object"
    },
    "Row": {
      "additionalProperties": false,
      "description": "One source row, retaining whether cells use th or td.",
      "properties": {
        "element_locator": {
          "title": "Element Locator",
          "type": "string"
        },
        "cells": {
          "items": {
            "$ref": "#/$defs/Cell"
          },
          "title": "Cells",
          "type": "array"
        }
      },
      "required": [
        "element_locator",
        "cells"
      ],
      "title": "Row",
      "type": "object"
    }
