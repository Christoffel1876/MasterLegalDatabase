  "required": [
    "source_html",
    "source_http_receipt",
    "source_capture_completed_at",
    "extraction_program",
    "selected_root_locator",
    "method",
    "normalization",
    "elements",
    "text_fragments",
    "components",
    "blocks",
    "anchors",
    "printed_date_mentions",
    "excluded_ranges",
    "coverage",
    "limitations"
