        },
        "nonblank_text_fragment_count": {
          "title": "Nonblank Text Fragment Count",
          "type": "integer"
        },
        "assigned_nonblank_text_fragment_count": {
          "title": "Assigned Nonblank Text Fragment Count",
          "type": "integer"
        },
        "unassigned_whitespace_fragment_ids": {
          "items": {
            "type": "string"
          },
          "title": "Unassigned Whitespace Fragment Ids",
          "type": "array"
        },
        "duplicated_fragment_ids": {
          "items": {
            "type": "string"
          },
          "title": "Duplicated Fragment Ids",
          "type": "array"
        },
        "unassigned_nonblank_fragment_ids": {
          "items": {
            "type": "string"
          },
          "title": "Unassigned Nonblank Fragment Ids",
          "type": "array"
        },
        "block_count": {
          "title": "Block Count",
          "type": "integer"
        },
        "table_count": {
          "const": 9,
