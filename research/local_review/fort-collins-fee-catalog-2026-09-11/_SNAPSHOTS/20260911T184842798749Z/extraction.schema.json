      "title": "Selector",
      "type": "string"
    },
    "method": {
      "title": "Method",
      "type": "string"
    },
    "normalization": {
      "title": "Normalization",
      "type": "string"
    },
    "elements": {
      "items": {
        "$ref": "#/$defs/ElementRecord"
      },
      "title": "Elements",
      "type": "array"
    },
    "text_fragments": {
      "items": {
        "$ref": "#/$defs/Fragment"
      },
      "title": "Text Fragments",
      "type": "array"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/Component"
      },
      "title": "Components",
      "type": "array"
    },
    "blocks": {
      "items": {
        "$ref": "#/$defs/Block"
      },
      "title": "Blocks",
      "type": "array"
    },
    "anchors": {
      "items": {
        "$ref": "#/$defs/Anchor"
      },
      "title": "Anchors",
      "type": "array"
    },
    "printed_date_mentions": {
      "items": {
        "$ref": "#/$defs/DateMention"
      },
      "title": "Printed Date Mentions",
      "type": "array"
    },
    "excluded_ranges": {
      "items": {
        "$ref": "#/$defs/ExcludedRange"
      },
      "title": "Excluded Ranges",
      "type": "array"
    },
    "coverage": {
      "$ref": "#/$defs/Coverage"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
