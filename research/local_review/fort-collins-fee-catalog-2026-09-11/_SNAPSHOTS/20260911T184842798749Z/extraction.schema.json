        "content_id": {
          "title": "Content Id",
          "type": "string"
        },
        "component_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Component Id"
        },
        "literal": {
          "title": "Literal",
          "type": "string"
        },
        "normalized_start": {
          "minimum": 0,
          "title": "Normalized Start",
          "type": "integer"
        },
        "normalized_end": {
          "exclusiveMinimum": 0,
          "title": "Normalized End",
          "type": "integer"
        },
        "interpretation": {
          "const": "printed_phrase_unclassified",
          "default": "printed_phrase_unclassified",
          "title": "Interpretation",
          "type": "string"
