    "source_http_receipt": {
      "$ref": "#/$defs/FileIdentity"
    },
    "source_capture_completed_at": {
      "format": "date-time",
      "title": "Source Capture Completed At",
      "type": "string"
    },
    "source_capture_time_role": {
      "const": "actual prior Atlas HTTP receipt, not extraction time",
      "default": "actual prior Atlas HTTP receipt, not extraction time",
      "title": "Source Capture Time Role",
      "type": "string"
    },
    "extraction_program": {
      "$ref": "#/$defs/FileIdentity"
    },
    "selected_root_locator": {
      "title": "Selected Root Locator",
      "type": "string"
    },
    "selector": {
      "const": "unique element with id=main-content",
