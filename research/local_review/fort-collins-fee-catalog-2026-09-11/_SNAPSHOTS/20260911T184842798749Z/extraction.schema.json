{
  "$defs": {
    "Anchor": {
      "additionalProperties": false,
      "description": "Observed href and label; resolving a URL never opens it.",
      "properties": {
        "element_locator": {
          "title": "Element Locator",
          "type": "string"
        },
        "raw_href_decoded": {
          "title": "Raw Href Decoded",
          "type": "string"
        },
        "resolved_url": {
          "title": "Resolved Url",
          "type": "string"
        },
        "normalized_label": {
          "title": "Normalized Label",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Title"
        },
        "fragment_ids": {
          "items": {
            "type": "string"
          },
          "title": "Fragment Ids",
          "type": "array"
        },
        "containing_content_ids": {
          "items": {
            "type": "string"
          },
          "title": "Containing Content Ids",
          "type": "array"
        },
        "component_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Component Id"
        },
        "source": {
          "$ref": "#/$defs/ByteRange"
        },
        "resource_opened_by_this_extraction": {
          "const": false,
          "default": false,
          "title": "Resource Opened By This Extraction",
          "type": "boolean"
        }
      },
      "required": [
        "element_locator",
        "raw_href_decoded",
        "resolved_url",
        "normalized_label",
        "title",
        "fragment_ids",
        "containing_content_ids",
        "component_id",
        "source"
      ],
      "title": "Anchor",
      "type": "object"
    },
    "Attribute": {
      "additionalProperties": false,
      "description": "Decoded HTML attribute, preserving original order and duplicate entries.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "Attribute",
      "type": "object"
    },
    "Block": {
      "additionalProperties": false,
      "description": "DOM-ordered content; table text is stored only in its cells.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "heading",
            "paragraph",
            "list_item_fragment",
            "text_run",
            "table",
            "image"
          ],
          "title": "Kind",
          "type": "string"
        },
        "element_locator": {
          "title": "Element Locator",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ByteRange"
        },
        "component_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Component Id"
        },
        "heading_context_ids": {
          "items": {
            "type": "string"
          },
          "title": "Heading Context Ids",
          "type": "array"
        },
        "parent_list_item_locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent List Item Locator"
        },
        "list_container_locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "List Container Locator"
        },
        "list_type": {
          "anyOf": [
            {
              "enum": [
                "ul",
                "ol"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "List Type"
        },
        "heading_level": {
          "anyOf": [
            {
              "maximum": 6,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heading Level"
        },
        "fragment_ids": {
          "items": {
            "type": "string"
          },
          "title": "Fragment Ids",
          "type": "array"
        },
        "dom_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dom Text"
        },
        "normalized_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Normalized Text"
        },
        "table_rows": {
          "items": {
            "$ref": "#/$defs/Row"
          },
          "title": "Table Rows",
          "type": "array"
        },
        "image_alt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Image Alt"
        },
        "image_src": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Image Src"
        }
      },
      "required": [
        "id",
        "kind",
        "element_locator",
        "source",
        "component_id",
        "heading_context_ids",
        "parent_list_item_locator",
        "list_container_locator",
        "list_type",
        "fragment_ids",
        "dom_text",
        "normalized_text",
        "table_rows",
        "image_alt",
        "image_src"
      ],
      "title": "Block",
      "type": "object"
    },
    "ByteRange": {
      "additionalProperties": false,
      "description": "Half-open byte range in the original UTF-8 HTML.",
      "properties": {
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "sha256"
      ],
      "title": "ByteRange",
      "type": "object"
    },
    "Cell": {
      "additionalProperties": false,
      "description": "One table cell in original row order; no spanning-cell expansion.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "element_locator": {
          "title": "Element Locator",
          "type": "string"
        },
        "tag": {
          "enum": [
            "td",
            "th"
          ],
          "title": "Tag",
          "type": "string"
        },
        "rowspan": {
          "minimum": 1,
          "title": "Rowspan",
          "type": "integer"
        },
        "colspan": {
          "minimum": 1,
          "title": "Colspan",
          "type": "integer"
        },
        "fragment_ids": {
          "items": {
            "type": "string"
          },
          "title": "Fragment Ids",
          "type": "array"
        },
        "dom_text": {
          "title": "Dom Text",
          "type": "string"
        },
        "normalized_text": {
          "title": "Normalized Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "element_locator",
        "tag",
        "rowspan",
        "colspan",
        "fragment_ids",
        "dom_text",
        "normalized_text"
      ],
      "title": "Cell",
      "type": "object"
    },
    "Component": {
      "additionalProperties": false,
      "description": "Source-defined accordion/side panel, without inferred fee ownership.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "element_locator": {
          "title": "Element Locator",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "block_ids": {
          "items": {
            "type": "string"
          },
          "title": "Block Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "element_locator",
        "label",
        "block_ids"
      ],
      "title": "Component",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
