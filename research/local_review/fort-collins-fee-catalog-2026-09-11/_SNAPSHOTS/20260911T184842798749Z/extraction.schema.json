    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_id": {
      "const": "fort-collins-fee-catalog-atlas-sd004-14",
      "default": "fort-collins-fee-catalog-atlas-sd004-14",
      "title": "Source Id",
      "type": "string"
    },
    "status": {
      "const": "source_snapshot_structured_pending_semantic_review",
      "default": "source_snapshot_structured_pending_semantic_review",
      "title": "Status",
      "type": "string"
    },
    "legal_currentness": {
      "const": "not_verified",
      "default": "not_verified",
      "title": "Legal Currentness",
      "type": "string"
    },
    "source_url": {
      "const": "https://www.fortcollins.gov/Business/Building-and-Development/Fee-Schedules",
      "default": "https://www.fortcollins.gov/Business/Building-and-Development/Fee-Schedules",
      "title": "Source Url",
      "type": "string"
    },
    "source_html": {
