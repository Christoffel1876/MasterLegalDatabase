        "exact_href": {
          "title": "Exact Href",
          "type": "string"
        },
        "exact_label": {
          "title": "Exact Label",
          "type": "string"
        },
        "resolved_url": {
          "title": "Resolved Url",
          "type": "string"
        },
        "anchor_match_count": {
          "title": "Anchor Match Count",
          "type": "integer"
        },
        "target_role": {
          "enum": [
            "fee_schedule_link",
            "commissioner_catalog_lead"
