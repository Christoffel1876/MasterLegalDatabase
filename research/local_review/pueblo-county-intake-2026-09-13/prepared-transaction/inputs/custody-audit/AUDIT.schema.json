      "required": [
        "authority_id",
        "parent_url",
        "parent",
        "parent_role",
        "parent_title",
        "parent_h1",
        "exact_href",
        "exact_label",
        "resolved_url",
        "anchor_match_count",
        "target_role",
        "limitations"
      ],
      "title": "Referral",
      "type": "object"
    }
