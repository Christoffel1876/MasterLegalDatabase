{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "description": "Bind exact local evidence bytes.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Asset",
      "type": "object"
    },
    "CurrentIntakeComparison": {
      "additionalProperties": false,
      "description": "A full current manual-manifest/ledger scan at the audit time.",
      "properties": {
        "repository_path": {
          "title": "Repository Path",
          "type": "string"
        },
        "file": {
          "$ref": "#/$defs/Asset"
        },
        "rows": {
          "title": "Rows",
          "type": "integer"
        },
        "sha256_matches": {
          "title": "Sha256 Matches",
          "type": "integer"
        },
        "exact_url_matches": {
          "title": "Exact Url Matches",
          "type": "integer"
        },
        "proposed_id_matches": {
          "title": "Proposed Id Matches",
          "type": "integer"
        },
        "proposed_source_id": {
          "title": "Proposed Source Id",
          "type": "string"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        }
      },
      "required": [
        "repository_path",
        "file",
        "rows",
        "sha256_matches",
        "exact_url_matches",
        "proposed_id_matches",
        "proposed_source_id",
        "captured_at"
      ],
      "title": "CurrentIntakeComparison",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "description": "Separate reported transport observations from independently checked retained bytes.",
      "properties": {
        "action_id": {
          "title": "Action Id",
          "type": "string"
        },
        "authority_id": {
          "const": "CO-COUNTY-PUEBLO",
          "title": "Authority Id",
          "type": "string"
        },
        "requested_url": {
          "title": "Requested Url",
          "type": "string"
        },
        "reported_final_url": {
          "title": "Reported Final Url",
          "type": "string"
        },
        "reported_reserved_at": {
          "format": "date-time",
          "title": "Reported Reserved At",
          "type": "string"
        },
        "reported_finished_at": {
          "format": "date-time",
          "title": "Reported Finished At",
          "type": "string"
        },
        "reported_http_status": {
          "title": "Reported Http Status",
          "type": "integer"
        },
        "reported_visible_redirects": {
          "items": {
            "type": "string"
          },
          "title": "Reported Visible Redirects",
          "type": "array"
        },
        "retained_role": {
          "enum": [
            "received_pdf",
            "received_access_denial_html"
          ],
          "title": "Retained Role",
          "type": "string"
        },
        "body": {
          "$ref": "#/$defs/Asset"
        },
        "byte_identical_duplicate": {
          "$ref": "#/$defs/Asset"
        },
        "reservation": {
          "$ref": "#/$defs/Asset"
        },
        "result": {
          "$ref": "#/$defs/Asset"
        },
        "headers": {
          "$ref": "#/$defs/Asset"
        },
        "structural_pdf_pages": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Structural Pdf Pages"
        },
        "pdf_encrypted": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pdf Encrypted"
        },
        "pdf_repaired": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pdf Repaired"
        },
        "terminal_pdf_eof_present": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Terminal Pdf Eof Present"
        },
        "html_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Html Title"
        },
        "observed_header_names": {
          "items": {
            "type": "string"
          },
          "title": "Observed Header Names",
          "type": "array"
        },
        "private_header_names_detected": {
          "items": {
            "type": "string"
          },
          "title": "Private Header Names Detected",
          "type": "array"
        },
        "headers_and_result_byte_counts_match": {
          "title": "Headers And Result Byte Counts Match",
          "type": "boolean"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "action_id",
        "authority_id",
        "requested_url",
        "reported_final_url",
        "reported_reserved_at",
        "reported_finished_at",
        "reported_http_status",
        "reported_visible_redirects",
        "retained_role",
        "body",
        "byte_identical_duplicate",
        "reservation",
        "result",
        "headers",
        "structural_pdf_pages",
        "pdf_encrypted",
        "pdf_repaired",
        "terminal_pdf_eof_present",
        "html_title",
        "observed_header_names",
        "private_header_names_detected",
        "headers_and_result_byte_counts_match",
        "notes"
      ],
      "title": "Event",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "A bounded observation with supporting retained inputs and explicit limits.",
      "properties": {
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "verified",
            "qualified",
            "intake_eligible_with_conditions"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "limits": {
          "items": {
            "type": "string"
          },
          "title": "Limits",
          "type": "array"
        }
      },
      "required": [
        "finding_id",
        "disposition",
        "statement",
        "evidence",
        "limits"
      ],
      "title": "Finding",
      "type": "object"
    },
    "LegacyComparison": {
      "additionalProperties": false,
      "description": "A complete streamed metadata comparison, with no implied original-byte availability.",
      "properties": {
        "edition": {
          "enum": [
            "pinned_commit",
            "working_tree"
          ],
          "title": "Edition",
          "type": "string"
        },
        "pinned_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pinned Commit"
        },
        "repository_path": {
          "title": "Repository Path",
          "type": "string"
        },
        "full_file_sha256": {
          "title": "Full File Sha256",
          "type": "string"
        },
        "full_file_bytes": {
          "title": "Full File Bytes",
          "type": "integer"
        },
        "full_rows": {
          "title": "Full Rows",
          "type": "integer"
        },
        "compared_urls": {
          "items": {
            "type": "string"
          },
          "title": "Compared Urls",
          "type": "array"
        },
        "compared_sha256s": {
          "items": {
            "type": "string"
          },
          "title": "Compared Sha256S",
          "type": "array"
        },
        "exact_url_field_matches": {
          "title": "Exact Url Field Matches",
          "type": "integer"
        },
        "digest_matches": {
          "title": "Digest Matches",
          "type": "integer"
        },
        "decoded_url_matches": {
          "title": "Decoded Url Matches",
          "type": "integer"
        },
        "proposed_id_matches": {
          "title": "Proposed Id Matches",
          "type": "integer"
        },
        "matching_original_lines": {
          "$ref": "#/$defs/Asset"
        },
        "original_line_numbers": {
          "items": {
            "type": "integer"
          },
          "title": "Original Line Numbers",
          "type": "array"
        },
        "full_stream_included": {
          "const": false,
          "title": "Full Stream Included",
          "type": "boolean"
        },
        "actual_historical_original_bytes_compared": {
          "const": false,
          "title": "Actual Historical Original Bytes Compared",
          "type": "boolean"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "edition",
        "pinned_commit",
        "repository_path",
        "full_file_sha256",
        "full_file_bytes",
        "full_rows",
        "compared_urls",
        "compared_sha256s",
        "exact_url_field_matches",
        "digest_matches",
        "decoded_url_matches",
        "proposed_id_matches",
        "matching_original_lines",
        "original_line_numbers",
        "full_stream_included",
        "actual_historical_original_bytes_compared",
        "limitations"
      ],
      "title": "LegacyComparison",
      "type": "object"
    },
    "Referral": {
      "additionalProperties": false,
      "description": "An exact retained rendered-DOM anchor, not an authenticated raw HTTP response.",
      "properties": {
        "authority_id": {
          "const": "CO-COUNTY-PUEBLO",
