{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "description": "An ordinary file inside this closed package.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "bytes": {
          "maximum": 50000000,
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "title": "Asset",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Inventory of every package payload except this manifest itself.",
  "properties": {
    "status": {
      "const": "closed_public_subset",
      "title": "Status",
      "type": "string"
    },
    "assets": {
      "items": {
        "$ref": "#/$defs/Asset"
      },
      "title": "Assets",
      "type": "array"
    }
  },
  "required": [
    "status",
    "assets"
  ],
  "title": "Manifest",
  "type": "object"
}
