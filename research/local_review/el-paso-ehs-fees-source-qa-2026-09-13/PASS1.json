    {
      "context_id": "DEFS",
      "physical_page": 4,
      "kind": "heading",
      "text": "Definitions\nRetail Food Establishments:",
      "applies_to": [
        "D1",
        "D2",
        "D3",
        "D4"
      ]
    },
    {
      "context_id": "D1",
      "physical_page": 4,
      "kind": "definition",
      "text": "(1) An onsite evaluation of a potential retail food establishment location.",
      "applies_to": [
        "R051"
      ]
    },
    {
      "context_id": "D2",
      "physical_page": 4,
      "kind": "definition",
      "text": "(2) An onsite inspection of an approved retail food establishment that has undergone a change in ownership or an establishment that otherwise needs an onsite inspection prior to opening and for which changes to the facility do not meet the requirements of a plan review.",
      "applies_to": [
        "R052",
        "R053"
      ]
    },
    {
      "context_id": "D3",
      "physical_page": 4,
      "kind": "definition",
      "text": "(3) A written document, based on HACCP (Hazard Analysis Critical Control Point) principles developed by the National Advisory Committee on Microbiological Criteria for Food, which formally identifies specific hazards that can adversely affect the safety of a food product and proposes control measures to maintain food safety.",
      "applies_to": [
        "R059"
      ]
    },
    {
      "context_id": "D4",
      "physical_page": 4,
      "kind": "definition",
      "text": "(4) An observed process, based on HACCP principles developed by the National Advisory Committee on Microbiological Criteria for Food, that is conducted at an establishment, and which formally identifies specific hazards that can adversely affect the safety of a food product and provides control measures to maintain food safety.",
      "applies_to": [
        "R060"
      ]
    },
    {
      "context_id": "OWTSDEF",
      "physical_page": 4,
      "kind": "heading",
      "text": "OWTS:",
      "applies_to": [
        "D5",
        "D6",
        "D7"
      ]
    },
    {
      "context_id": "D5",
      "physical_page": 4,
      "kind": "definition",
      "text": "(5) Repair, alteration, or addition to the soil treatment area (absorption area).",
      "applies_to": [
        "R022"
      ]
    },
    {
      "context_id": "D6",
      "physical_page": 4,
      "kind": "definition",
      "text": "(6) Repair or replacement of any portion of the system from the structure to the soil treatment area with the exception of repair or replacement of tank baffles and collapsed lines as depicted in the as-built drawings on file at Public Health.",
      "applies_to": [
        "R023"
      ]
    },
    {
      "context_id": "D7",
      "physical_page": 4,
      "kind": "definition",
      "text": "(7) Reinspection/Additional Inspection” is defined as an additional revisit, or inspection, of an OWTS by an EHS for purposes of ensuring compliance with installation and regulation standards or requirements. Typically, this occurs when a requested inspection of an installation was not complete, not in compliance, or has outstanding items (such as well/electrical verification) that must be verified to comply with the regulations.",
      "applies_to": [
        "R033"
      ]
    },
    {
      "context_id": "CHILDDEF",
      "physical_page": 4,
      "kind": "heading",
      "text": "Childcare:",
      "applies_to": [
        "CHILD1",
        "CHILD2",
        "CHILD3",
        "CHILD4"
      ]
    },
    {
      "context_id": "CHILD1",
      "physical_page": 4,
      "kind": "definition",
      "text": "Routine inspections are conducted every two years per licensing guidelines for an existing facility.",
      "applies_to": [
        "R014",
        "R015",
        "R016",
        "R017",
        "R018",
        "R019"
      ]
    },
    {
      "context_id": "CHILD2",
      "physical_page": 4,
      "kind": "definition",
      "text": "Pre-operational inspections are required per licensing guidelines and are conducted upon request of the owner/operator prior to opening a new facility.",
      "applies_to": [
        "R009",
        "R011"
      ]
    },
    {
      "context_id": "CHILD3",
      "physical_page": 4,
      "kind": "definition",
      "text": "Follow-up inspections are conducted at the discretion of Public Health as a follow-up to a routine or pre-operational inspection to assure follow-up and compliance with critical violations and other health hazards identified during a prior routine or pre-operational inspection.",
      "applies_to": [
        "R012"
      ]
    },
    {
      "context_id": "CHILD4",
      "physical_page": 4,
      "kind": "definition",
      "text": "Room change inspections are required per licensing guidelines and are conducted at the request of the facility when room changes are being made.",
      "applies_to": [
        "R013"
      ]
    },
    {
      "context_id": "OTHERHEAD",
      "physical_page": 5,
      "kind": "heading",
      "text": "Other Notes:",
      "applies_to": [
        "OTHER1",
        "OTHER2",
        "OTHER3"
      ]
    },
    {
      "context_id": "OTHER1",
      "physical_page": 5,
      "kind": "note",
      "text": "1. All fees are on a per-visit fee basis.",
      "applies_to": [
        "all_fee_rows"
      ]
    },
    {
      "context_id": "OTHER2",
      "physical_page": 5,
      "kind": "note",
      "text": "2. No fees will be assessed for complaint investigations or communicable disease investigation visits.",
      "applies_to": [
        "all_fee_rows"
      ]
    },
    {
      "context_id": "OTHER3",
      "physical_page": 5,
      "kind": "note",
      "text": "3. Public Health may require payment at the time of service and may send outstanding account balances to collection.",
      "applies_to": [
        "all_fee_rows"
      ]
    }
