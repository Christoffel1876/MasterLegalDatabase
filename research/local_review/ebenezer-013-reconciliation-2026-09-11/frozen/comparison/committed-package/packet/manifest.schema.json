{
  "$defs": {
    "CustodyCopy": {
      "additionalProperties": false,
      "description": "A frozen exact copy resolves a potentially mutable original path.",
      "properties": {
        "original": {
          "$ref": "#/$defs/FileRef"
        },
        "frozen": {
          "$ref": "#/$defs/PacketFile"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        }
      },
      "required": [
        "original",
        "frozen",
        "role",
        "captured_at"
      ],
      "title": "CustodyCopy",
      "type": "object"
    },
    "Document": {
      "additionalProperties": false,
      "description": "One finite review assignment with a complete page set.",
      "properties": {
        "queue_order": {
          "maximum": 2,
          "minimum": 1,
          "title": "Queue Order",
          "type": "integer"
        },
        "assignment_id": {
          "enum": [
            "EB-PDF-013",
            "EB-PDF-014"
          ],
          "title": "Assignment Id",
          "type": "string"
        },
        "source_id": {
          "enum": [
            "fort-collins-wildfire-code-sd005-05",
            "fort-collins-land-use-article-1-sd005-07"
          ],
          "title": "Source Id",
          "type": "string"
        },
        "authority_id": {
          "const": "CO-MUNICIPAL-FORT_COLLINS",
          "default": "CO-MUNICIPAL-FORT_COLLINS",
          "title": "Authority Id",
          "type": "string"
        },
        "authority_basis": {
          "const": "collection context only; not a legal-authority finding",
          "default": "collection context only; not a legal-authority finding",
          "title": "Authority Basis",
          "type": "string"
        },
        "expected_pages": {
          "maximum": 8,
          "minimum": 1,
          "title": "Expected Pages",
          "type": "integer"
        },
        "original": {
          "$ref": "#/$defs/PacketFile"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "rendering_engine": {
          "const": "Poppler pdftoppm",
          "default": "Poppler pdftoppm",
          "title": "Rendering Engine",
          "type": "string"
        },
        "rendering_version": {
          "const": "26.05.0",
          "default": "26.05.0",
          "title": "Rendering Version",
          "type": "string"
        },
        "rendering_command": {
          "const": "pdftoppm -r 300 -png original.pdf page",
          "default": "pdftoppm -r 300 -png original.pdf page",
          "title": "Rendering Command",
          "type": "string"
        },
        "rendering_dpi": {
          "const": 300,
          "default": 300,
          "title": "Rendering Dpi",
          "type": "integer"
        },
        "rendering_scope": {
          "const": "entire physical pages; no crop, annotation or rescaling",
          "default": "entire physical pages; no crop, annotation or rescaling",
          "title": "Rendering Scope",
          "type": "string"
        },
        "candidate": {
          "$ref": "#/$defs/PacketFile"
        },
        "candidate_status": {
          "const": "machine_native_text_unreviewed",
          "default": "machine_native_text_unreviewed",
          "title": "Candidate Status",
          "type": "string"
        },
        "candidate_changes": {
          "const": "none",
          "default": "none",
          "title": "Candidate Changes",
          "type": "string"
        },
        "candidate_packaging": {
          "const": "UTF-8 page markers outside unchanged native byte slices",
          "default": "UTF-8 page markers outside unchanged native byte slices",
          "title": "Candidate Packaging",
          "type": "string"
        },
        "page_evidence_schema": {
          "$ref": "#/$defs/PacketFile"
        },
        "pages": {
          "items": {
            "$ref": "#/$defs/Page"
          },
          "title": "Pages",
          "type": "array"
        },
        "legal_currentness": {
          "const": "not_verified",
          "default": "not_verified",
          "title": "Legal Currentness",
          "type": "string"
        },
        "legal_review": {
          "const": "pending",
          "default": "pending",
          "title": "Legal Review",
          "type": "string"
        }
      },
      "required": [
        "queue_order",
        "assignment_id",
        "source_id",
        "expected_pages",
        "original",
        "provenance",
        "candidate",
        "page_evidence_schema",
        "pages"
      ],
      "title": "Document",
      "type": "object"
    },
    "FileRef": {
      "additionalProperties": false,
      "description": "Exact file reference; its scope is explicit in the containing field.",
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "FileRef",
      "type": "object"
    },
    "PacketFile": {
      "additionalProperties": false,
      "description": "Require a confined relative packet path.",
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "PacketFile",
      "type": "object"
    },
    "Page": {
      "additionalProperties": false,
      "description": "One complete physical page and exact candidate byte slice.",
      "properties": {
        "physical_page": {
          "maximum": 8,
          "minimum": 1,
          "title": "Physical Page",
          "type": "integer"
        },
        "image": {
          "$ref": "#/$defs/PacketFile"
        },
        "image_width": {
          "exclusiveMinimum": 0,
          "title": "Image Width",
          "type": "integer"
        },
        "image_height": {
          "exclusiveMinimum": 0,
          "title": "Image Height",
          "type": "integer"
        },
        "evidence": {
          "$ref": "#/$defs/PacketFile"
        },
        "text_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Text Sha256",
          "type": "string"
        },
        "text_size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Text Size Bytes",
          "type": "integer"
        },
        "candidate_text_offset_bytes": {
          "minimum": 0,
          "title": "Candidate Text Offset Bytes",
          "type": "integer"
        },
        "candidate_text_end_byte_exclusive": {
          "exclusiveMinimum": 0,
          "title": "Candidate Text End Byte Exclusive",
          "type": "integer"
        }
      },
      "required": [
        "physical_page",
        "image",
        "image_width",
        "image_height",
        "evidence",
        "text_sha256",
        "text_size_bytes",
        "candidate_text_offset_bytes",
        "candidate_text_end_byte_exclusive"
      ],
      "title": "Page",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Local custody checks remain distinct from supplied upstream claims.",
      "properties": {
        "canonical_raw_pdf": {
          "$ref": "#/$defs/FileRef"
        },
        "original_acquisition_time": {
          "default": null,
          "title": "Original Acquisition Time",
          "type": "null"
        },
        "upstream_http_acquisition_independently_verified": {
          "const": false,
          "default": false,
          "title": "Upstream Http Acquisition Independently Verified",
          "type": "boolean"
        },
        "actual_repository_received_at": {
          "format": "date-time",
          "title": "Actual Repository Received At",
          "type": "string"
        },
        "intake_record_id": {
          "title": "Intake Record Id",
          "type": "string"
        },
        "intake_status": {
          "const": "archived_pending_pipeline",
          "default": "archived_pending_pipeline",
          "title": "Intake Status",
          "type": "string"
        },
        "acquisition_method": {
          "const": "received_review_package",
          "default": "received_review_package",
          "title": "Acquisition Method",
          "type": "string"
        },
        "frozen_raw_manifest": {
          "$ref": "#/$defs/PacketFile"
        },
        "raw_manifest_line_number": {
          "minimum": 1,
          "title": "Raw Manifest Line Number",
          "type": "integer"
        },
        "raw_manifest_line_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Raw Manifest Line Sha256",
          "type": "string"
        },
        "raw_manifest_line_size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Raw Manifest Line Size Bytes",
          "type": "integer"
        },
        "frozen_intake_receipt": {
          "$ref": "#/$defs/PacketFile"
        },
        "frozen_source_provenance": {
          "$ref": "#/$defs/PacketFile"
        },
        "provenance_line_number": {
          "minimum": 1,
          "title": "Provenance Line Number",
          "type": "integer"
        },
        "provenance_line_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Provenance Line Sha256",
          "type": "string"
        },
        "provenance_line_size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Provenance Line Size Bytes",
          "type": "integer"
        },
        "claimed_official_source_url": {
          "pattern": "^https://www\\.fortcollins\\.gov/",
          "title": "Claimed Official Source Url",
          "type": "string"
        },
        "claimed_final_url": {
          "pattern": "^https://www\\.fortcollins\\.gov/",
          "title": "Claimed Final Url",
          "type": "string"
        },
        "claimed_attempt_time": {
          "format": "date-time",
          "title": "Claimed Attempt Time",
          "type": "string"
        },
        "claimed_http_status": {
          "const": 200,
          "default": 200,
          "title": "Claimed Http Status",
          "type": "integer"
        },
        "claimed_referral_url": {
          "pattern": "^https://www\\.fortcollins\\.gov/",
          "title": "Claimed Referral Url",
          "type": "string"
        },
        "claimed_referral_basis": {
          "title": "Claimed Referral Basis",
          "type": "string"
        },
        "source_role_claim": {
          "enum": [
            "related_code_candidate",
            "code_article_candidate"
          ],
          "title": "Source Role Claim",
          "type": "string"
        },
        "role_basis": {
          "const": "supplied intake label; no adopted/current legal effect established",
          "default": "supplied intake label; no adopted/current legal effect established",
          "title": "Role Basis",
          "type": "string"
        },
        "archive_identity_from_intake_receipt": {
          "$ref": "#/$defs/FileRef"
        },
        "archive_member_from_intake_record": {
          "title": "Archive Member From Intake Record",
          "type": "string"
        },
        "archive_reopened_for_this_packet": {
          "const": false,
          "default": false,
          "title": "Archive Reopened For This Packet",
          "type": "boolean"
        },
        "caveats": {
          "items": {
            "type": "string"
          },
          "title": "Caveats",
          "type": "array"
        }
      },
      "required": [
        "canonical_raw_pdf",
        "actual_repository_received_at",
        "intake_record_id",
        "frozen_raw_manifest",
        "raw_manifest_line_number",
        "raw_manifest_line_sha256",
        "raw_manifest_line_size_bytes",
        "frozen_intake_receipt",
        "frozen_source_provenance",
        "provenance_line_number",
        "provenance_line_sha256",
        "provenance_line_size_bytes",
        "claimed_official_source_url",
        "claimed_final_url",
        "claimed_attempt_time",
        "claimed_referral_url",
        "claimed_referral_basis",
        "source_role_claim",
        "archive_identity_from_intake_receipt",
        "archive_member_from_intake_record",
        "caveats"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "An immutable, prepared but unsent two-document queue.",
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "packet_id": {
      "const": "grok-pdf-review-2026-09-11-batch-4",
      "default": "grok-pdf-review-2026-09-11-batch-4",
      "title": "Packet Id",
      "type": "string"
    },
    "prepared_at": {
      "format": "date-time",
      "title": "Prepared At",
      "type": "string"
    },
    "status": {
      "const": "prepared_not_sent",
      "default": "prepared_not_sent",
      "title": "Status",
      "type": "string"
    },
    "purpose": {
      "const": "independent_pdf_transcription_review",
      "default": "independent_pdf_transcription_review",
      "title": "Purpose",
      "type": "string"
    },
    "start_no_document_at_or_after": {
      "const": "2026-09-11T20:50:00Z",
      "default": "2026-09-11T20:50:00Z",
      "title": "Start No Document At Or After",
      "type": "string"
    },
    "finish_by": {
      "const": "2026-09-11T21:20:00Z",
      "default": "2026-09-11T21:20:00Z",
      "title": "Finish By",
      "type": "string"
    },
    "stop_after": {
      "const": "EB-PDF-014",
      "default": "EB-PDF-014",
      "title": "Stop After",
      "type": "string"
    },
    "independence": {
      "const": "procedural source-first pass; per-document frozen receipt before candidate",
      "default": "procedural source-first pass; per-document frozen receipt before candidate",
      "title": "Independence",
      "type": "string"
    },
    "legal_currentness": {
      "const": "not_verified",
      "default": "not_verified",
      "title": "Legal Currentness",
      "type": "string"
    },
    "documents": {
      "items": {
        "$ref": "#/$defs/Document"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Documents",
      "type": "array"
    },
    "custody_copies": {
      "items": {
        "$ref": "#/$defs/CustodyCopy"
      },
      "title": "Custody Copies",
      "type": "array"
    },
    "supporting_payloads": {
      "items": {
        "$ref": "#/$defs/PacketFile"
      },
      "title": "Supporting Payloads",
      "type": "array"
    },
    "assignment": {
      "$ref": "#/$defs/CustodyCopy"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "prepared_at",
    "documents",
    "custody_copies",
    "supporting_payloads",
    "assignment",
    "limitations"
  ],
  "title": "Manifest",
  "type": "object"
}
