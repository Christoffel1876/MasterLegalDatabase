{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Asset",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "frozen_at": {
      "format": "date-time",
      "title": "Frozen At",
      "type": "string"
    },
    "status": {
      "const": "frozen_independent_audit",
      "title": "Status",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/Asset"
      },
      "title": "Files",
      "type": "array"
    },
    "excludes": {
      "const": "FINAL_MANIFEST.json,FINAL_MANIFEST.schema.json",
      "title": "Excludes",
      "type": "string"
    },
    "private_received_headers_require_public_derivatives": {
      "const": true,
      "default": true,
      "title": "Private Received Headers Require Public Derivatives",
      "type": "boolean"
    }
  },
  "required": [
    "frozen_at",
    "status",
    "files",
    "excludes"
  ],
  "title": "Manifest",
  "type": "object"
}
