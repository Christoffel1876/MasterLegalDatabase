        },
        "role_claim": {
          "title": "Role Claim",
          "type": "string"
        },
        "actual_format": {
          "title": "Actual Format",
          "type": "string"
        },
        "exact_event_and_body_binding": {
          "title": "Exact Event And Body Binding",
