          "type": "string"
        },
        "is_in_requested_urls": {
          "title": "Is In Requested Urls",
          "type": "boolean"
        },
        "is_in_final_urls": {
          "title": "Is In Final Urls",
          "type": "boolean"
        },
        "public_open_during_audit": {
