{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "description": "Bind a locally preserved artifact to its exact bytes.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Asset",
      "type": "object"
    },
    "Body": {
      "additionalProperties": false,
      "description": "Measured byte format and structural PDF result, without text review.",
      "properties": {
        "asset": {
          "$ref": "#/$defs/Asset"
        },
        "event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Event Ids",
          "type": "array"
        },
        "named_pdf": {
          "title": "Named Pdf",
          "type": "boolean"
        },
        "actual_format": {
          "enum": [
            "pdf",
            "html",
            "other"
          ],
          "title": "Actual Format",
          "type": "string"
        },
        "pages": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pages"
        },
        "repaired": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Repaired"
        },
        "encrypted": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Encrypted"
        },
        "parser_result": {
          "enum": [
            "parsed",
            "not_pdf",
            "parse_failed"
          ],
          "title": "Parser Result",
          "type": "string"
        },
        "page_content_reviewed": {
          "const": false,
          "default": false,
          "title": "Page Content Reviewed",
          "type": "boolean"
        }
      },
      "required": [
        "asset",
        "event_ids",
        "named_pdf",
        "actual_format",
        "pages",
        "repaired",
        "encrypted",
        "parser_result"
      ],
      "title": "Body",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "description": "Separate supplied HTTP claims from measured retained evidence and header hops.",
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "authority_label_claim": {
          "title": "Authority Label Claim",
          "type": "string"
        },
        "requested_url": {
          "title": "Requested Url",
          "type": "string"
        },
        "final_url_claim": {
          "title": "Final Url Claim",
          "type": "string"
        },
        "started_at_claim": {
          "format": "date-time",
          "title": "Started At Claim",
          "type": "string"
        },
        "completed_at_claim": {
          "format": "date-time",
          "title": "Completed At Claim",
          "type": "string"
        },
        "http_status_claim": {
          "title": "Http Status Claim",
          "type": "integer"
        },
        "outcome_claim": {
          "title": "Outcome Claim",
          "type": "string"
        },
        "body_size_claim": {
          "title": "Body Size Claim",
          "type": "integer"
        },
        "body_sha256_claim": {
          "title": "Body Sha256 Claim",
          "type": "string"
        },
        "body": {
          "$ref": "#/$defs/Asset"
        },
        "body_matches_claim": {
          "title": "Body Matches Claim",
          "type": "boolean"
        },
        "headers": {
          "$ref": "#/$defs/Asset"
        },
        "observed_response_statuses": {
          "items": {
            "type": "integer"
          },
          "title": "Observed Response Statuses",
          "type": "array"
        },
        "observed_location_values": {
          "items": {
            "type": "string"
          },
          "title": "Observed Location Values",
          "type": "array"
        },
        "resolved_redirect_destinations": {
          "items": {
            "type": "string"
          },
          "title": "Resolved Redirect Destinations",
          "type": "array"
        },
        "reported_redirect_count": {
          "title": "Reported Redirect Count",
          "type": "integer"
        },
        "header_chain_matches_logged_final": {
          "title": "Header Chain Matches Logged Final",
          "type": "boolean"
        },
        "upstream_acquisition_independently_witnessed": {
          "const": false,
          "default": false,
          "title": "Upstream Acquisition Independently Witnessed",
          "type": "boolean"
        }
      },
      "required": [
        "event_id",
        "authority_label_claim",
        "requested_url",
        "final_url_claim",
        "started_at_claim",
        "completed_at_claim",
        "http_status_claim",
        "outcome_claim",
        "body_size_claim",
        "body_sha256_claim",
        "body",
        "body_matches_claim",
        "headers",
        "observed_response_statuses",
        "observed_location_values",
        "resolved_redirect_destinations",
        "reported_redirect_count",
        "header_chain_matches_logged_final"
      ],
      "title": "Event",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "An actionable audit finding supported by frozen local evidence.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "failure",
            "qualification",
            "correction"
          ],
          "title": "Severity",
          "type": "string"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "evidence_paths": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Paths",
          "type": "array"
        }
      },
      "required": [
        "id",
        "severity",
        "statement",
        "evidence_paths"
      ],
      "title": "Finding",
      "type": "object"
    },
    "HeaderDerivative": {
      "additionalProperties": false,
      "description": "Public-safe header derivative bound to its immutable private original.",
      "properties": {
        "original": {
          "$ref": "#/$defs/Asset"
        },
        "derivative": {
          "$ref": "#/$defs/Asset"
        },
        "removed_field_names": {
          "items": {
            "type": "string"
          },
          "title": "Removed Field Names",
          "type": "array"
        },
        "removed_line_count": {
          "title": "Removed Line Count",
          "type": "integer"
        },
        "bytes_changed": {
          "title": "Bytes Changed",
          "type": "boolean"
        },
        "transformation": {
          "const": "omit_cookie_and_authorization_fields_and_continuations",
          "title": "Transformation",
          "type": "string"
        }
      },
      "required": [
        "original",
        "derivative",
        "removed_field_names",
        "removed_line_count",
        "bytes_changed",
        "transformation"
      ],
      "title": "HeaderDerivative",
      "type": "object"
    },
    "LegacyHit": {
      "additionalProperties": false,
      "description": "One exact matching recorded legacy attempt; its old raw path was not opened.",
      "properties": {
        "line": {
          "title": "Line",
          "type": "integer"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "authority_id": {
          "title": "Authority Id",
          "type": "string"
        },
        "requested_url": {
          "title": "Requested Url",
          "type": "string"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "historical_original_opened": {
          "const": false,
          "default": false,
          "title": "Historical Original Opened",
          "type": "boolean"
        }
      },
      "required": [
        "line",
        "source_id",
        "authority_id",
        "requested_url",
        "source_url",
        "sha256"
      ],
      "title": "LegacyHit",
      "type": "object"
    },
    "PdfProposal": {
      "additionalProperties": false,
