        "rank": {
          "title": "Rank",
          "type": "integer"
        },
        "proposed_source_id": {
          "title": "Proposed Source Id",
          "type": "string"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "priority_ids": {
          "items": {
            "type": "string"
          },
          "title": "Priority Ids",
          "type": "array"
        },
        "authority_context": {
          "title": "Authority Context",
          "type": "string"
        },
        "issuer_and_role_qualification": {
          "title": "Issuer And Role Qualification",
          "type": "string"
        },
        "title_from_supplied_candidate_or_observed_anchor": {
          "title": "Title From Supplied Candidate Or Observed Anchor",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Asset"
        },
        "pages": {
          "title": "Pages",
          "type": "integer"
        },
        "requested_url": {
          "title": "Requested Url",
          "type": "string"
        },
        "final_url": {
          "title": "Final Url",
          "type": "string"
        },
        "acquisition_started_at_claim": {
          "format": "date-time",
          "title": "Acquisition Started At Claim",
          "type": "string"
        },
        "acquisition_completed_at_claim": {
          "format": "date-time",
          "title": "Acquisition Completed At Claim",
          "type": "string"
        },
        "custody_captured_at": {
          "format": "date-time",
          "title": "Custody Captured At",
          "type": "string"
        },
        "upstream_acquisition_independently_verified": {
          "const": false,
          "default": false,
          "title": "Upstream Acquisition Independently Verified",
          "type": "boolean"
        },
        "source_referrals": {
          "items": {
            "$ref": "#/$defs/Referral"
          },
          "title": "Source Referrals",
          "type": "array"
        },
        "historical_matching_rows": {
          "title": "Historical Matching Rows",
          "type": "integer"
        },
        "historical_source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Historical Source Ids",
          "type": "array"
        },
        "preservation_status": {
          "const": "proposed_only_pending_typed_intake_and_role_review",
          "title": "Preservation Status",
          "type": "string"
        },
        "legal_currentness": {
          "const": "not_verified",
          "default": "not_verified",
          "title": "Legal Currentness",
          "type": "string"
        },
        "adoption_date": {
          "default": null,
          "title": "Adoption Date",
          "type": "null"
        },
        "effective_date": {
          "default": null,
          "title": "Effective Date",
          "type": "null"
        }
      },
      "required": [
        "rank",
        "proposed_source_id",
        "event_id",
        "priority_ids",
        "authority_context",
        "issuer_and_role_qualification",
        "title_from_supplied_candidate_or_observed_anchor",
        "source",
        "pages",
        "requested_url",
        "final_url",
        "acquisition_started_at_claim",
        "acquisition_completed_at_claim",
        "custody_captured_at",
        "source_referrals",
        "historical_matching_rows",
        "historical_source_ids",
        "preservation_status"
      ],
      "title": "PdfProposal",
      "type": "object"
    },
    "Priority": {
      "additionalProperties": false,
