{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "description": "Bind one exact ordinary file relative to this package.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Asset",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Close this handoff package without adding repository or legal claims.",
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "frozen_at": {
      "format": "date-time",
      "title": "Frozen At",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/Asset"
      },
      "title": "Files",
      "type": "array"
    },
    "exclusions": {
      "anyOf": [
        {
          "enum": [
            "FINAL_MANIFEST.json",
            "FINAL_MANIFEST.schema.json"
          ],
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ],
      "title": "Exclusions"
    }
  },
  "required": [
    "schema_version",
    "frozen_at",
    "files",
    "exclusions"
  ],
  "title": "Inventory",
  "type": "object"
}
