{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "description": "Bind one exact ordinary file relative to this package.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Asset",
      "type": "object"
    },
    "Baseline": {
      "additionalProperties": false,
      "description": "Bind a repository preimage without changing or reserializing it.",
      "properties": {
        "repository_path": {
          "title": "Repository Path",
          "type": "string"
        },
        "preserved": {
          "$ref": "#/$defs/Asset"
        },
        "records": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Records"
        }
      },
      "required": [
        "repository_path",
        "preserved",
        "records"
      ],
      "title": "Baseline",
      "type": "object"
    },
    "Copy": {
      "additionalProperties": false,
      "description": "Record a copied input without certifying its upstream acquisition.",
      "properties": {
        "original_path": {
          "title": "Original Path",
          "type": "string"
        },
        "original_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Original Sha256",
          "type": "string"
        },
        "preserved": {
          "$ref": "#/$defs/Asset"
        },
        "method": {
          "enum": [
            "exact_copy",
            "audited_public_header_derivative"
          ],
          "title": "Method",
          "type": "string"
        },
        "excluded_raw_header_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excluded Raw Header Sha256"
        }
      },
      "required": [
        "original_path",
        "original_sha256",
        "preserved",
        "method"
      ],
      "title": "Copy",
      "type": "object"
    },
    "DateClaim": {
      "additionalProperties": false,
      "description": "Keep a source-stated date separate from legal effect or collection time.",
      "properties": {
        "value": {
          "title": "Value",
          "type": "string"
        },
        "role": {
          "enum": [
            "source_stated_effective",
            "source_stated_approval",
            "recording_stamp",
            "unlabeled_cover_date",
            "source_stated_execution",
            "document_footer_date"
          ],
          "title": "Role",
          "type": "string"
        },
        "observation_id": {
          "title": "Observation Id",
          "type": "string"
        },
        "independently_verified": {
          "const": false,
          "title": "Independently Verified",
          "type": "boolean"
        }
      },
      "required": [
        "value",
        "role",
        "observation_id",
        "independently_verified"
      ],
      "title": "DateClaim",
      "type": "object"
    },
    "Dedupe": {
      "additionalProperties": false,
      "description": "Record exact existing manual rows and a bounded ordinary-raw-file screen.",
      "properties": {
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "raw_records": {
          "minimum": 0,
          "title": "Raw Records",
          "type": "integer"
        },
        "ledger_records": {
          "minimum": 0,
          "title": "Ledger Records",
          "type": "integer"
        },
        "ordinary_raw_files_screened": {
          "minimum": 0,
          "title": "Ordinary Raw Files Screened",
          "type": "integer"
        },
        "symlinks_skipped": {
          "items": {
            "type": "string"
          },
          "title": "Symlinks Skipped",
          "type": "array"
        },
        "candidate_size_files_hashed": {
          "items": {
            "$ref": "#/$defs/Asset"
          },
          "title": "Candidate Size Files Hashed",
          "type": "array"
        },
        "source_id_matches": {
          "items": {
            "type": "string"
          },
          "title": "Source Id Matches",
          "type": "array"
        },
        "raw_manifest_digest_matches": {
          "items": {
            "type": "string"
          },
          "title": "Raw Manifest Digest Matches",
          "type": "array"
        },
        "ledger_digest_matches": {
          "items": {
            "type": "string"
          },
          "title": "Ledger Digest Matches",
          "type": "array"
        },
        "ordinary_raw_digest_matches": {
          "items": {
            "type": "string"
          },
          "title": "Ordinary Raw Digest Matches",
          "type": "array"
        },
        "boundary": {
          "title": "Boundary",
          "type": "string"
        }
      },
      "required": [
        "checked_at",
        "raw_records",
        "ledger_records",
        "ordinary_raw_files_screened",
        "symlinks_skipped",
        "candidate_size_files_hashed",
        "source_id_matches",
        "raw_manifest_digest_matches",
        "ledger_digest_matches",
        "ordinary_raw_digest_matches",
        "boundary"
      ],
      "title": "Dedupe",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "description": "Record bounded image-supported wording and extraction limitations.",
      "properties": {
        "observation_id": {
          "title": "Observation Id",
          "type": "string"
        },
        "physical_page": {
          "minimum": 1,
          "title": "Physical Page",
          "type": "integer"
        },
        "region": {
          "title": "Region",
          "type": "string"
        },
        "visible_text": {
          "title": "Visible Text",
          "type": "string"
        },
        "native_anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        },
        "conclusion": {
          "title": "Conclusion",
          "type": "string"
        },
        "uncertainty": {
          "title": "Uncertainty",
          "type": "string"
        },
        "legal_currentness": {
          "const": "not_verified",
          "title": "Legal Currentness",
          "type": "string"
        }
      },
      "required": [
        "observation_id",
        "physical_page",
        "region",
        "visible_text",
        "native_anchor",
        "conclusion",
        "uncertainty",
        "legal_currentness"
      ],
      "title": "Observation",
      "type": "object"
    },
    "Page": {
      "additionalProperties": false,
      "description": "Bind a fully viewed page image and its uncorrected native extraction.",
      "properties": {
        "physical_page": {
          "minimum": 1,
          "title": "Physical Page",
          "type": "integer"
        },
        "image": {
          "$ref": "#/$defs/Asset"
        },
        "native": {
          "$ref": "#/$defs/Asset"
        },
        "native_nonwhitespace": {
          "title": "Native Nonwhitespace",
          "type": "boolean"
        },
        "view_scope": {
          "const": "full_page_for_title_issuer_role_and_selected_date_context",
          "title": "View Scope",
          "type": "string"
        },
        "numeric_table_certification": {
          "const": false,
          "title": "Numeric Table Certification",
          "type": "boolean"
        }
      },
      "required": [
        "physical_page",
        "image",
        "native",
        "native_nonwhitespace",
        "view_scope",
        "numeric_table_certification"
      ],
      "title": "Page",
      "type": "object"
    },
    "RecordTemplate": {
      "additionalProperties": false,
      "description": "Hold only known final-record fields; execution fields must remain null.",
      "properties": {
        "record_id": {
          "title": "Record Id",
          "type": "string"
        },
        "layer_id": {
          "const": "08_County_Authorities",
          "title": "Layer Id",
          "type": "string"
        },
        "official_source_name": {
          "title": "Official Source Name",
          "type": "string"
        },
        "official_source_url": {
          "title": "Official Source Url",
          "type": "string"
        },
        "acquisition_method": {
          "const": "received_review_package",
          "title": "Acquisition Method",
          "type": "string"
        },
        "received_from": {
          "title": "Received From",
          "type": "string"
        },
        "reviewer_name": {
          "title": "Reviewer Name",
          "type": "string"
        },
        "reviewer_email": {
          "title": "Reviewer Email",
          "type": "null"
        },
        "custody_note": {
          "title": "Custody Note",
          "type": "string"
        },
        "source_file": {
          "$ref": "#/$defs/Asset"
        },
        "expected_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Expected Sha256",
          "type": "string"
        },
        "source_format": {
          "const": "pdf",
          "title": "Source Format",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        },
        "allow_duplicate": {
          "const": false,
          "title": "Allow Duplicate",
          "type": "boolean"
        },
        "intake_id": {
          "title": "Intake Id",
          "type": "null"
        },
        "archive_path": {
          "title": "Archive Path",
          "type": "null"
        },
        "received_at": {
          "title": "Received At",
          "type": "null"
        },
        "status": {
          "const": "proposed_not_applied",
          "title": "Status",
          "type": "string"
        },
        "intended_record_status": {
          "const": "archived_pending_pipeline",
          "title": "Intended Record Status",
          "type": "string"
        },
        "legal_currentness": {
          "const": "not_verified",
          "title": "Legal Currentness",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "layer_id",
        "official_source_name",
        "official_source_url",
        "acquisition_method",
        "received_from",
        "reviewer_name",
        "reviewer_email",
        "custody_note",
        "source_file",
        "expected_sha256",
        "source_format",
        "size_bytes",
        "allow_duplicate",
        "intake_id",
        "archive_path",
        "received_at",
        "status",
        "intended_record_status",
        "legal_currentness"
      ],
      "title": "RecordTemplate",
      "type": "object"
    },
    "Referral": {
