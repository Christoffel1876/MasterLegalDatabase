{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "description": "Bind one ordinary file to exact bytes.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Asset",
      "type": "object"
    },
    "Baseline": {
      "additionalProperties": false,
      "description": "Preserve the real repository file hashes across a read-only execution.",
      "properties": {
        "before": {
          "$ref": "#/$defs/Asset"
        },
        "after": {
          "$ref": "#/$defs/Asset"
        }
      },
      "required": [
        "before",
        "after"
      ],
      "title": "Baseline",
      "type": "object"
    },
    "Invocation": {
      "additionalProperties": false,
      "description": "Record one observed command without inferring unrecorded test timestamps.",
      "properties": {
        "argv": {
          "items": {
            "type": "string"
          },
          "title": "Argv",
          "type": "array"
        },
        "cwd": {
          "title": "Cwd",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "exit_code": {
          "const": 0,
          "title": "Exit Code",
          "type": "integer"
        },
        "stdout": {
          "$ref": "#/$defs/Asset"
        },
        "stderr": {
          "$ref": "#/$defs/Asset"
        }
      },
      "required": [
        "argv",
        "cwd",
        "started_at",
        "completed_at",
        "exit_code",
        "stdout",
        "stderr"
      ],
      "title": "Invocation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Separate actual read-only validation from synthetic fixture application.",
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "const": "prepared_not_applied",
      "title": "Status",
      "type": "string"
    },
    "frozen_at": {
      "format": "date-time",
      "title": "Frozen At",
      "type": "string"
    },
    "implementation": {
      "$ref": "#/$defs/Asset"
    },
    "tests": {
      "$ref": "#/$defs/Asset"
    },
    "fixture_test_log": {
      "$ref": "#/$defs/Asset"
    },
    "fixture_tests_passed": {
      "const": 30,
      "title": "Fixture Tests Passed",
      "type": "integer"
    },
    "fixture_test_warnings": {
      "const": 5,
      "title": "Fixture Test Warnings",
      "type": "integer"
    },
    "fixture_seconds_reported": {
      "const": 10.7,
      "title": "Fixture Seconds Reported",
      "type": "number"
    },
    "combined_coverage": {
      "$ref": "#/$defs/Asset"
    },
    "combined_coverage_percent": {
      "maximum": 100,
      "minimum": 90,
      "title": "Combined Coverage Percent",
      "type": "number"
    },
    "coverage_scope": {
      "const": "fixture_tests_plus_actual_read_only_cli",
      "title": "Coverage Scope",
      "type": "string"
    },
    "actual_dry_run": {
      "$ref": "#/$defs/Invocation"
    },
    "baselines": {
      "items": {
        "$ref": "#/$defs/Baseline"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Baselines",
      "type": "array"
    },
    "baseline_raw_records": {
      "const": 46,
      "title": "Baseline Raw Records",
      "type": "integer"
    },
    "baseline_ledger_records": {
      "const": 47,
      "title": "Baseline Ledger Records",
      "type": "integer"
    },
    "real_repository_apply_performed": {
      "const": false,
      "title": "Real Repository Apply Performed",
      "type": "boolean"
    },
    "real_execution_directory_exists": {
      "const": false,
      "title": "Real Execution Directory Exists",
      "type": "boolean"
    },
    "expected_after_if_applied": {
      "const": "59 raw / 60 ledger; same one missing historical original",
      "title": "Expected After If Applied",
      "type": "string"
    },
    "full_corpus_validation": {
      "const": "not_run_by_this_subtask",
      "title": "Full Corpus Validation",
      "type": "string"
    },
    "tested_recovery_scope": {
      "const": "process_interruption_and_deterministic_replay",
      "title": "Tested Recovery Scope",
      "type": "string"
    },
    "power_loss_durability_verified": {
      "const": false,
      "title": "Power Loss Durability Verified",
      "type": "boolean"
    },
    "legal_currentness": {
      "const": "not_verified",
      "title": "Legal Currentness",
      "type": "string"
    },
    "answer_safe": {
      "const": false,
      "title": "Answer Safe",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "status",
    "frozen_at",
    "implementation",
    "tests",
    "fixture_test_log",
    "fixture_tests_passed",
    "fixture_test_warnings",
    "fixture_seconds_reported",
    "combined_coverage",
    "combined_coverage_percent",
    "coverage_scope",
    "actual_dry_run",
    "baselines",
    "baseline_raw_records",
    "baseline_ledger_records",
    "real_repository_apply_performed",
    "real_execution_directory_exists",
    "expected_after_if_applied",
    "full_corpus_validation",
    "tested_recovery_scope",
    "power_loss_durability_verified",
    "legal_currentness",
    "answer_safe"
  ],
  "title": "Validation",
  "type": "object"
}
