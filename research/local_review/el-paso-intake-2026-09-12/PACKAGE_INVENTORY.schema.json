{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "description": "Bind a confined ordinary file to its exact bytes.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Asset",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Close portable package membership; its own inventory alone is self-excluded.",
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/Asset"
      },
      "title": "Files",
      "type": "array"
    },
    "self_exclusion": {
      "const": "PACKAGE_INVENTORY.json",
      "title": "Self Exclusion",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "files",
    "self_exclusion"
  ],
  "title": "Inventory",
  "type": "object"
}
