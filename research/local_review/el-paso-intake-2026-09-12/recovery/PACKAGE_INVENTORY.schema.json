{
  "$defs": {
    "Ref": {
      "additionalProperties": false,
      "description": "Bind local retained bytes without certifying upstream acquisition.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Ref",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Closed frozen recovery preparation, excluding this inventory and test fixtures only.",
  "properties": {
    "status": {
      "const": "recovery_prepared_not_executed",
      "title": "Status",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "title": "Files",
      "type": "array"
    },
    "exclusions": {
      "const": "PACKAGE_INVENTORY.json and _test_runs/ only",
      "title": "Exclusions",
      "type": "string"
    }
  },
  "required": [
    "status",
    "files",
    "exclusions"
  ],
  "title": "Inventory",
  "type": "object"
}
