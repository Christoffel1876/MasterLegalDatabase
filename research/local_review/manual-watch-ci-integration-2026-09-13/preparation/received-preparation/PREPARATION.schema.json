  "required": [
    "status",
    "prepared_at",
    "install_files",
    "immutable_input_count",
    "source_pairs",
    "selected_sources",
    "max_source_events",
    "max_source_response_bytes",
    "max_source_run_seconds",
    "scheduled_http_enabled_by_default",
    "manual_http_enabled_by_default",
    "source_http_requests",
    "primary_document_urls_observed",
    "final_focused_tests",
    "final_combined_tests",
    "branch_inclusive_coverage_percent",
    "local_python",
    "python311_syntax_checked",
    "linux_execution_tested",
    "unchanged_maintained_input_pins",
    "legal_currentness",
    "limitations"
