{
  "$defs": {
    "Ref": {
      "additionalProperties": false,
      "description": "An exact ordinary-file identity.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Ref",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "An immutable preimage of one owned progress-summary version.",
  "properties": {
    "version": {
      "maximum": 5,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "archived_at": {
      "title": "Archived At",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Files",
      "type": "array"
    }
  },
  "required": [
    "version",
    "archived_at",
    "files"
  ],
  "title": "ProgressSnapshot",
  "type": "object"
}
