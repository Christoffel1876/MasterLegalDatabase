{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "description": "Exact retained ordinary file identity.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Asset",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Closed public payload set with no excluded file bytes under any name.",
  "properties": {
    "kind": {
      "const": "public_manual_watch_ci_review",
      "title": "Kind",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/Asset"
      },
      "title": "Files",
      "type": "array"
    }
  },
  "required": [
    "kind",
    "files"
  ],
  "title": "Inventory",
  "type": "object"
}
