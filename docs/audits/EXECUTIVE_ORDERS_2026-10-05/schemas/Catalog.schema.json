      "properties": {
        "citation": {
          "pattern": "^[BD] 2026 [0-9]{3}$",
          "title": "Citation",
          "type": "string"
        },
        "displayed_date": {
          "title": "Displayed Date",
          "type": "string"
        },
        "displayed_title": {
          "title": "Displayed Title",
          "type": "string"
        },
        "observed_href": {
          "title": "Observed Href",
          "type": "string"
        },
        "direct_download_url": {
          "title": "Direct Download Url",
          "type": "string"
        },
        "direct_url_basis": {
          "const": "maintained_exec_orders_scraper._download_url_from_exact_observed_href",
          "default": "maintained_exec_orders_scraper._download_url_from_exact_observed_href",
          "title": "Direct Url Basis",
          "type": "string"
        },
        "inherited_index_match": {
          "title": "Inherited Index Match",
          "type": "boolean"
        }
      },
      "required": [
        "citation",
        "displayed_date",
        "displayed_title",
        "observed_href",
        "direct_download_url",
        "inherited_index_match"
      ],
      "title": "Row",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
