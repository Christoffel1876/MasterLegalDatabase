{
  "$defs": {
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "title": "Ref",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "source_sha256": {
      "title": "Source Sha256",
      "type": "string"
    },
    "citation": {
      "title": "Citation",
      "type": "string"
    },
    "physical_page": {
      "minimum": 1,
      "title": "Physical Page",
      "type": "integer"
    },
    "native_text": {
      "$ref": "#/$defs/Ref"
    },
    "character_count": {
      "minimum": 0,
      "title": "Character Count",
      "type": "integer"
    },
    "extraction": {
      "const": "PyMuPDF get_text(text), sort=False",
      "default": "PyMuPDF get_text(text), sort=False",
      "title": "Extraction",
      "type": "string"
    },
    "fidelity_review": {
      "const": "unreviewed",
      "default": "unreviewed",
      "title": "Fidelity Review",
      "type": "string"
    }
  },
  "required": [
    "source_sha256",
    "citation",
    "physical_page",
    "native_text",
    "character_count"
  ],
  "title": "Page",
  "type": "object"
}
