{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "description": "One retained file relative to the receipt directory.",
      "properties": {
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "size_bytes",
        "path"
      ],
      "title": "Asset",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Closed preparation payload inventory.",
  "properties": {
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "status": {
      "const": "frozen_prepared_procedure_not_executed",
      "title": "Status",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/Asset"
      },
      "title": "Files",
      "type": "array"
    }
  },
  "required": [
    "recorded_at",
    "status",
    "files"
  ],
  "title": "Manifest",
  "type": "object"
}
