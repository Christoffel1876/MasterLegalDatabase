        "label": "(2)",
        "fragments": [
          {
            "region_id": "S103-B2",
            "section_id": "CRS-1-1-103",
            "role": "statutory_paragraph",
            "physical_page": 5,
            "printed_page": "-5-",
            "native": {
              "path": "native/page-0005.txt",
              "sha256": "2120d74818efa9cd8fdf3d04ffe62b4dd8d0a798516186532489f4f9b6350b7a",
