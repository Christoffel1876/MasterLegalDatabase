        },
        "physical_page": 4
      }
    },
    {
      "context_id": "CHILD1",
      "physical_page": 4,
      "kind": "definition",
      "text": "Routine inspections are conducted every two years per licensing guidelines for an existing facility.",
      "applies_to": [
        "R014",
        "R015",
        "R016",
        "R017",
        "R018"
      ],
      "native": {
        "start": 2610,
        "end": 2712,
        "sha256": "22b5c40cf863429f5505709f6c1490f7ff41b5aea884bb36dc39a025e0fd946b",
        "text": "Routine inspections are conducted every two years per licensing guidelines for an  \nexisting facility.",
        "native_file": {
          "path": "/Users/mcoors/Documents/Project Geode/MasterLegalDatabase/research/local_review/el-paso-ehs-fees-source-qa-2026-09-13/native/page-0004.txt",
          "sha256": "effad2643fd58bff7df4866e12ab6824b99cfb4350c8be3a164d854ddb7e0d80",
          "size_bytes": 3357
        },
        "image": {
          "path": "/Users/mcoors/Documents/Project Geode/MasterLegalDatabase/research/local_review/el-paso-ehs-fees-source-qa-2026-09-13/pages/page-0004.png",
          "sha256": "26457f755b350e699002c49fc12be62ba4201c57a7707e04164a152383493301",
          "size_bytes": 559336
        },
        "physical_page": 4
      }
    },
    {
      "context_id": "CHILD2",
      "physical_page": 4,
      "kind": "definition",
      "text": "Pre-operational inspections are required per licensing guidelines and are conducted upon request of the owner/operator prior to opening a new facility.",
      "applies_to": [
        "R009",
        "R011"
      ],
      "native": {
