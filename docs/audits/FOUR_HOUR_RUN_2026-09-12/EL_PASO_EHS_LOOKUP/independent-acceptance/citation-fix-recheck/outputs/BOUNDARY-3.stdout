    {
      "context_id": "B",
      "physical_page": 4,
      "kind": "civil_penalty",
      "text": "B. Failure to pay any fee required by subpart A of this Section is an unlawful act and, except as otherwise provided by Section 2, is subject to the assessment of a civil penalty of not more than $100 per day, until the fee is paid in full.",
      "applies_to": [
        "all_fee_rows"
      ],
      "native": {
        "start": 496,
        "end": 739,
        "sha256": "0599b104e62874b3a4e61039182507d6712a064fe425b433891cd9ba647eebb8",
        "text": "B.  Failure to pay any fee required by subpart A of this Section is an unlawful act and, except as \notherwise provided by Section 2, is subject to the assessment of a civil penalty of not more than \n$100 per day, until the fee is paid in full.",
