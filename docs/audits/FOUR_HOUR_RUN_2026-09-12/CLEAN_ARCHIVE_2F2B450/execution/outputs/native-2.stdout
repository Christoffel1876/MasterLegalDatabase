    },
    {
      "entry_id": "sales_tax_body",
      "kind": "sales_tax",
      "statement": {
        "id": "sales_tax_body",
        "text": "Computed at 4.11% of 45% of the value of new residential construction, if said value is seventy-five thousand dollars ($75,000) or less per \nunit. For all other construction, the amount collected shall be 4.11% of 50% of the total value of construction. \n \n \n",
        "physical_page": 1,
        "byte_basis": "utf8_candidate_file_with_page_marker",
        "candidate_path": "/private/tmp/geode-clean-archive-2f2b450/research/local_review/greeley-fees-atlas-source-review-2026-09-11/packet/02-candidate-text/greeley-building-fees-sd008-06/candidate.txt",
