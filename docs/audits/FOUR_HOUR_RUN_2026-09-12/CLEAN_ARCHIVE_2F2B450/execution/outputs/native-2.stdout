    {
      "entry_id": "other_6",
      "kind": "other_fee",
      "statement": {
        "id": "other_6",
        "text": "6. Major Plan Review Fees. When a plan or other data are required to be submitted by Section 106, a plan review fee shall be paid at \nthe time of submitting plans and specifications for review. Said plan review fee shall be 65 percent of the building permit as \nshown in the fee table above. The plan review fees specific to this section are separate fees from the permit fees and are in \naddition to the permit fees. \n",
        "physical_page": 1,
        "byte_basis": "utf8_candidate_file_with_page_marker",
        "candidate_path": "/private/tmp/geode-clean-archive-2f2b450/research/local_review/greeley-fees-atlas-source-review-2026-09-11/packet/02-candidate-text/greeley-building-fees-sd008-06/candidate.txt",
