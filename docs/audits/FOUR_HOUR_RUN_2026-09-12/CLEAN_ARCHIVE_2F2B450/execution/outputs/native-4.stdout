      ]
    },
    {
      "id": "p2-chunk-3",
      "role": "body",
      "statement": "Unchanged source span",
      "qualification": "visible",
      "native_spans": [
        {
          "physical_page": 2,
          "text": "For 2026, based on the methodology (applying the economic adjustment factor to the 2025 fee, \nrounding the result to zero decimals and comparing it to the 2025 fee), the Police, Fire, Park, Trails, \nStorm Drainage, and Transportation development impact fees will decrease an average of -2.07%. \nThe Water and Sewer board establishes the Water and Sewer Plant Investment Fees (PIF), the \nequivalent to impact fees. These will be adopted in December. \nThe fee adjustment requires public notification approximately 120 days before the March 1, 2026 \neffective date. The fee changes by type of Development Impact Fee are presented on the attached \nschedule. \n",
          "native_start": 923,
          "native_end": 1578,
          "candidate_native_offset": 2833,
          "candidate_start": 3756,
          "candidate_end": 4411,
          "candidate_path": "/private/tmp/geode-clean-archive-2f2b450/research/local_review/ebenezer-016-017-reconciliation-2026-09-12/historical-packet/baseline/EB-PDF-016/inputs/candidate.txt",
          "sha256": "0700927260384b81ecb71aafd2a4b46a67e5a45c30b67f3edbc9368b49f3e062"
