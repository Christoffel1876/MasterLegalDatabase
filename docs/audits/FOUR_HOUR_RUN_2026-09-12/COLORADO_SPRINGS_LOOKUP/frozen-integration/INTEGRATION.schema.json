{
  "$defs": {
    "FileRef": {
      "additionalProperties": false,
      "description": "Bind exact ordinary bytes in the handoff or repository.",
      "properties": {
        "domain": {
          "enum": [
            "handoff",
            "repository"
          ],
          "title": "Domain",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "domain",
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "FileRef",
      "type": "object"
    },
    "Tests": {
      "additionalProperties": false,
      "description": "Retain the actual focused check counts and coverage measures.",
      "properties": {
        "passed": {
          "exclusiveMinimum": 0,
          "title": "Passed",
          "type": "integer"
        },
        "failed": {
          "const": 0,
          "title": "Failed",
          "type": "integer"
        },
        "elapsed_seconds": {
          "exclusiveMinimum": 0,
          "title": "Elapsed Seconds",
          "type": "number"
        },
        "combined_coverage_percent": {
          "maximum": 100,
          "minimum": 90,
          "title": "Combined Coverage Percent",
          "type": "number"
        },
        "lookup_coverage_percent": {
          "maximum": 100,
          "minimum": 90,
          "title": "Lookup Coverage Percent",
          "type": "number"
        },
        "lookup_branch_percent": {
          "maximum": 100,
          "minimum": 90,
          "title": "Lookup Branch Percent",
          "type": "number"
        },
        "inventory_coverage_percent": {
          "maximum": 100,
          "minimum": 90,
          "title": "Inventory Coverage Percent",
          "type": "number"
        }
      },
      "required": [
        "passed",
        "failed",
        "elapsed_seconds",
        "combined_coverage_percent",
        "lookup_coverage_percent",
        "lookup_branch_percent",
        "inventory_coverage_percent"
      ],
      "title": "Tests",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Describe this additive integration without legal-readiness promotion.",
