          "type": "string"
        },
        "repository_path": {
          "title": "Repository Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "historical_path",
        "repository_path",
        "sha256",
        "size_bytes"
      ],
      "title": "Copy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "copied_at": {
      "format": "date-time",
      "title": "Copied At",
      "type": "string"
    },
    "status": {
