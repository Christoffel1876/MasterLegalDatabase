      "title": "Required Superseding Disposition Sha256",
      "type": "string"
    },
    "withdrawn_claims": {
      "items": {
        "type": "string"
      },
      "title": "Withdrawn Claims",
      "type": "array"
    },
    "preserved_source_currentness": {
      "const": "not_verified",
      "title": "Preserved Source Currentness",
      "type": "string"
    },
    "canonical_changes": {
      "const": "none",
      "title": "Canonical Changes",
      "type": "string"
    }
  },
  "required": [
    "copied_at",
    "status",
    "files",
    "required_superseding_disposition_sha256",
    "withdrawn_claims",
    "preserved_source_currentness",
    "canonical_changes"
