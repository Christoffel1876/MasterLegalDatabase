{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Asset",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checked_at": {
      "format": "date-time",
      "title": "Checked At",
      "type": "string"
    },
    "parent_commit": {
      "title": "Parent Commit",
      "type": "string"
    },
    "full_suite_result": {
      "title": "Full Suite Result",
      "type": "string"
    },
    "changed_module_coverage": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Changed Module Coverage",
      "type": "object"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/Asset"
      },
      "title": "Files",
      "type": "array"
    },
    "conclusions": {
      "items": {
        "type": "string"
      },
      "title": "Conclusions",
      "type": "array"
    },
    "public_push": {
      "const": false,
      "default": false,
      "title": "Public Push",
      "type": "boolean"
    },
    "legal_currentness": {
      "const": "not_verified",
      "default": "not_verified",
      "title": "Legal Currentness",
      "type": "string"
    }
  },
  "required": [
    "checked_at",
    "parent_commit",
    "full_suite_result",
    "changed_module_coverage",
    "files",
    "conclusions"
  ],
  "title": "Checkpoint",
  "type": "object"
}
