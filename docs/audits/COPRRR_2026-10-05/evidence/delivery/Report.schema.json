{
  "$defs": {
    "Item": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "$ref": "#/$defs/Target"
        },
        "result_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Path"
        },
        "status": {
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "target",
        "status"
      ],
      "title": "Item",
      "type": "object"
    },
    "Target": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "source_role": {
          "enum": [
            "ag_opinion",
            "coprrr_sunrise",
            "coprrr_sunset"
          ],
          "title": "Source Role",
          "type": "string"
        },
        "discovery_basis": {
          "title": "Discovery Basis",
          "type": "string"
        },
        "parent_url": {
          "title": "Parent Url",
          "type": "string"
        },
        "original_observed_href": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Observed Href"
        },
        "inherited_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inherited Sha256"
        }
      },
      "required": [
        "id",
        "url",
        "title",
        "source_role",
        "discovery_basis",
        "parent_url"
      ],
      "title": "Target",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plan_sha256": {
      "title": "Plan Sha256",
      "type": "string"
    },
    "transport_sha256": {
      "title": "Transport Sha256",
      "type": "string"
    },
    "attempted": {
      "title": "Attempted",
      "type": "integer"
    },
    "charged_bytes": {
      "maximum": 50000000,
      "title": "Charged Bytes",
      "type": "integer"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/Item"
      },
      "title": "Items",
      "type": "array"
    },
    "currentness": {
      "const": "not_verified",
      "default": "not_verified",
      "title": "Currentness",
      "type": "string"
    },
    "answer_safe": {
      "const": false,
      "default": false,
      "title": "Answer Safe",
      "type": "boolean"
    }
  },
  "required": [
    "plan_sha256",
    "transport_sha256",
    "attempted",
    "charged_bytes",
    "items"
  ],
  "title": "Report",
  "type": "object"
}
