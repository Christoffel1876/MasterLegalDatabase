					<TD style="text-align: left;"> <a href="/CCR/DisplayRule.do?action=ruleinfo&ruleId=3362&deptID=16&agencyID=132&deptName=Department of Public Health and Environment&agencyName=Water Quality Control Commission&seriesNum=5 CCR 1002-101">5 CCR 1002-101 </a></TD>
					<TD>REGULATION NO. 101 - WATER QUALITY CIVIL PENALTY INFLATION ADJUSTMENT REGULATION</TD>
				</TR>
			
				
				<TR class="rowEven">
				
					<TD style="text-align: left;"> <a href="/CCR/DisplayRule.do?action=ruleinfo&ruleId=3446&deptID=16&agencyID=132&deptName=Department of Public Health and Environment&agencyName=Water Quality Control Commission&seriesNum=5 CCR 1002-102">5 CCR 1002-102 </a></TD>
					<TD>REGULATION NO. 102 - WATER QUALITY CONTROL DIVISION CASH FEES</TD>
				</TR>
			
		</TBODY>
	</TABLE>


