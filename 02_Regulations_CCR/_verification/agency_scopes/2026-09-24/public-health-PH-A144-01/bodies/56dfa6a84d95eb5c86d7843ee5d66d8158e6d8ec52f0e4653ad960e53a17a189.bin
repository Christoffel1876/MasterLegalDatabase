		}
	</style>
	<script>
	function OpenRuleWindow(ruleVersionId, fileName) {
		 var ua = window.navigator.userAgent;
	     var msie = ua.indexOf("MSIE");
	     if (msie > 0) {
	            window.open('/CCR/'+fileName+'.pdf?ruleVersionId='+ruleVersionId+'&fileName='+fileName);
	     } else {
		        window.open('/CCR/GenerateRulePdf.do?ruleVersionId='+ruleVersionId+'&fileName='+fileName);
	     }
	}
	function OpenRuleWordVersion(ruleVersionId, fileName) {
		  var ua = window.navigator.userAgent;
	      var msie = ua.indexOf("MSIE");
	        if (msie > 0) {
	            window.open('/CCR/'+fileName+'.doc?type=word&ruleVersionId='+ruleVersionId+'&fileName='+fileName);
	        } else {
			 window.open('/CCR/GenerateRulePdf.do?type=word&ruleVersionId='+ruleVersionId+'&fileName='+fileName); 
	        }
	}
	</script>
</head>
